<Window x:Class="Demo_NumericControls.MainWindow" x:Name="MyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo_NumericControls"
        xmlns:ds="clr-namespace:NumericControls;assembly=NumericControls"
        xmlns:uni="clr-namespace:NumericControls.Distributions.Univariate;assembly=NumericControls"
        ContentRendered="MainWindow_ContentRendered"
        mc:Ignorable="d"
        Background="{DynamicResource EnvironmentWindowBackground}"
        Title="NumericControls Demo" Height="550" Width="850">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/NumericControls;Component/Themes/NumericControlsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Theme Selection Panel -->
        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0">
            <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource EnvironmentWindowText}"/>
            <ComboBox Name="ThemeComboBox" Width="100" SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="Light" IsSelected="True"/>
                <ComboBoxItem Content="Blue"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>
        </StackPanel>

        <TabControl SelectedIndex="0" Grid.Row="1">
            <TabItem Header="Distribution Selector">
                <Grid>
                    <!--<Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>-->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <uni:DistributionWithSelectorControl SelectedDistribution="{Binding ElementName=MyWindow, Path=SelectedDistribution,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        ShowPlot="False" ShowStatistics="False" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5"/>

                    <uni:DistributionSelectorPopup SelectedDistribution="{Binding ElementName=MyWindow, Path=SelectedDistribution,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  ShowPlot="True" ShowStatistics="False" VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="200" Margin="5,30,0,0"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" Margin="5" >
                        <uni:DistributionSelectorControl x:Name="myOtherControl" Width="400"
                                                        BackgroundColor="#F6F6F6"
                                                        BorderBrush="Gray" 
                                                        BorderThickness="1"
                                                        SelectedDistribution="{Binding ElementName=MyWindow, Path=SelectedDistribution,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        ShowAxisTitle="True"
                                                        DistributionTitle="Broken Leg"
                                                        ShowAxisLabel="True">
                        </uni:DistributionSelectorControl>
                    </ScrollViewer>


                </Grid>
            </TabItem>
            <TabItem Header="Uncertain Curve Editor">
                <ds:UncertainOrderedDataSelectorControl Background="#FFAEADB2" SelectedUncertainOrderedData="{Binding ElementName=MyWindow, Path=SelectedUncertainCurve,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        OrderY="Descending" XColumnHeader="Depth" YColumnHeader="Velocity" XAxisLabel="Depth" YAxisLabel="Velocity">

                </ds:UncertainOrderedDataSelectorControl>
            </TabItem>
            <TabItem Header="Uncertain Table Editor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Name="TestButton" Click="TestButton_Click">Test</Button>

                    <ds:UncertainOrderedDataTableEditor 
                        Name="UncertainTable" 
                        Grid.Row="1" 
                        Background="#FFAEADB2" 
                        AddRemoveRows="True"
                        SelectedUncertainOrderedData="{Binding ElementName=MyWindow, Path=SelectedUncertainCurve,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        OrderY="None" 
                        IsStrictY="False"
                        IsStrictX="False"
                        XColumnHeader="Depth" 
                        YColumnHeader="Velocity" >
                    </ds:UncertainOrderedDataTableEditor>

                </Grid>
            </TabItem>
            <TabItem Header="Curve Editor" IsSelected="False" Background="#FFE8E8E8">
                <ds:OrderedDataSelectorControl SelectedOrderedData="{Binding ElementName=MyWindow, Path=SelectedCurve,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        OrderY="Descending" XColumnHeader="Depth" YColumnHeader="Velocity" XAxisLabel="Depth" YAxisLabel="Velocity">

                </ds:OrderedDataSelectorControl>
            </TabItem>
            <TabItem Header="Time Series" IsSelected="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ComboBox>
                        <ComboBoxItem Name="USGSItem" Content="USGS 01134500" Selected="USGSItem_Selected"/>
                        <ComboBoxItem Name="IrregularItem" Content="Irregular" Selected="IrregularItem_Selected"/>
                        <ComboBoxItem Name="DailyItem" Content="Daily" Selected="DailyItem_Selected"/>
                        <ComboBoxItem Name="HourlyItem" Content="Hourly" Selected="HourlyItem_Selected"/>
                        <ComboBoxItem Name="MinutesItem" Content="Minute" Selected="MinutesItem_Selected"/>
                    </ComboBox>
                    
                    <ds:TimeSeriesTable 
                        Name="TimeSeriesTableControl" 
                        Grid.Row="1"
                        IsReadOnly="False"
                        XColumnHeader="Date"
                        YColumnHeader="Data">
                        
                    </ds:TimeSeriesTable>
                </Grid>
            </TabItem>
            <TabItem Header="Bin Definitions">
                <ds:BinDefinitionControl StratificationOptionsCollection="{Binding ElementName=MyWindow, Path=StratificationOptionsCollection, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"></ds:BinDefinitionControl>
            </TabItem>
            <TabItem Header="Bivariate CDF">
                <ds:BivariateEmpiricalControl
                    VerticalAlignment="Top"       
                    X1Header="Primary Hazard"
                    X2Header="Secondary Hazard"
                    BivariateCDF="{Binding ElementName=MyWindow, Path=BivariateCDF, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"></ds:BivariateEmpiricalControl>
            </TabItem>

            
        </TabControl>


    </Grid>
</Window>
