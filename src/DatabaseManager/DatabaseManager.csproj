<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<IsWpfFrameworkLibrary>true</IsWpfFrameworkLibrary>
		<PackageId>RMC.DatabaseManager</PackageId>
		<Title>DatabaseManager</Title>
		<Description>Multi-format database abstraction library for .NET. Provides a unified interface for reading, editing, and exporting tabular data backed by SQLite, CSV, DBF, or in-memory DataTables, with undo/redo edit tracking and Excel/CSV export.</Description>
		<PackageTags>database; sqlite; dbf; csv; datatable; undo-redo; excel-export; usace-rmc</PackageTags>
	</PropertyGroup>

	<!-- Shared packages -->
	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
		<PackageReference Include="ExcelNumberFormat" Version="1.1" />
		<PackageReference Include="FastMember" Version="1.5.0" />
		<PackageReference Include="System.Data.SQLite" Version="2.0.2" />
		<PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
	</ItemGroup>

</Project>