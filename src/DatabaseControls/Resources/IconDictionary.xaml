<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    =====================================================================================
      DatabaseControls Icon Dictionary
    =====================================================================================
      Contains vector icon definitions for the DatabaseControls library.
      Icons use DynamicResource for theme-aware coloring.

      CONTENTS:
      - Toolbar Icons      - Save, Undo, Redo, Copy, Paste, etc.
      - Selection Icons    - Select all, deselect, show selected
      - Calculator Icons   - Field calculator operations
      - Export Icons       - Export table, export data

      USAGE:
      Icons are available as Canvas resources and can be used:
      <ContentControl Content="{StaticResource SaveIcon}"/>
    =====================================================================================
    -->

    <!-- =============================================================================== -->
    <!-- SORT ARROW                                                                       -->
    <!-- =============================================================================== -->

    <Canvas x:Key="SortArrowIcon" Width="16" Height="16" x:Shared="False">
        <Path Fill="{DynamicResource DataGrid.Header.Foreground}" StrokeThickness="0">
            <Path.Data>
                <PathGeometry Figures="M 8 13.25 0.5 5 V 2.75 L 8 6 15.5 2.75 V 5 Z" FillRule="NonZero"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- EXPORT TABLE ICON                                                                -->
    <!-- =============================================================================== -->

    <Canvas x:Key="ExportTableIcon" Width="16" Height="16" x:Shared="False">
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry Figures="M 4.25 4.5454547 6.75 2.0000001 H 2.006 C 0.898 2.0000001 0 3.1454547 0 4.5352729 V 13.464727 C 0 14.864728 0.897 16 2.006 16 h 9.988 C 13.102 16 14 14.854546 14 13.464727 V 8.8727275 l -2 2.0363635 v 2.545455 H 2 V 4.5454547 Z" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path Fill="{DynamicResource ToolbarIconAccent}">
            <Path.Data>
                <PathGeometry Figures="M 11.013712 2.4101745 C 7.4844178 2.4528431 4 6.2186639 4 11 5.6893543 8.9884744 7.6898529 7.1768817 11.013712 7.3231746 V 9.7528544 L 16 4.8764274 11.013712 2.65318e-7 Z" FillRule="NonZero"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- COPY ICON                                                                        -->
    <!-- =============================================================================== -->

    <Canvas x:Key="CopyIcon" Width="16" Height="16" x:Shared="False">
        <Path StrokeThickness="1.5" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Round" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="M 3.5 11.75 H 2.375 C 1.47475 11.75 0.75 11.02525 0.75 10.125 V 2.375 C 0.75 1.47475 1.47475 0.75 2.375 0.75 h 6.75 c 0.90025 0 1.625 0.72475 1.625 1.625 V 2.5" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="M 2.75 3.5 H 5" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="M 2.75 6.25 H 3.5" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="M 2.75 8.9999996 H 3.5" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1.5" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Round" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="M 6.875 4.25 H 11.5 L 15.25 8 v 5.625 c 0 0.90025 -0.72475 1.625 -1.625 1.625 H 6.875 C 5.97475 15.25 5.25 14.52525 5.25 13.625 V 5.875 C 5.25 4.97475 5.97475 4.25 6.875 4.25 Z" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="M 7.25 7 H 11.5" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="m 7.25 9.75 c 6 0 6 0 6 0" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="m 7.25 12.5 c 6 0 6 0 6 0" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="M 11.5 4.25 V 8 h 3.75" FillRule="EvenOdd"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- COPY WITH HEADERS ICON                                                           -->
    <!-- =============================================================================== -->

    <Canvas x:Key="CopyWithHeadersIcon" Width="16" Height="16" x:Shared="False">
        <Path StrokeThickness="1.5" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Round" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="m 5.0517241 12.956896 h -0.737069 c -0.589819 0 -1.0646552 -0.474836 -1.0646552 -1.064655 V 6.8146548 c 0 -0.589819 0.4748362 -1.0646552 1.0646552 -1.0646552 h 4.4224138 c 0.589819 0 1.0646552 0.4748362 1.0646552 1.0646552 v 0.081897" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1.5" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Round" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="m 7.262931 8.0431031 h 3.030172 L 12.75 10.5 v 3.685345 C 12.75 14.775163 12.275164 15.25 11.685345 15.25 H 7.262931 c -0.589819 0 -1.0646552 -0.474837 -1.0646552 -1.064655 V 9.1077583 c 0 -0.589819 0.4748362 -1.0646552 1.0646552 -1.0646552 z" FillRule="NonZero"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="M 10.293103 8.0431031 V 10.5 H 12.75" FillRule="EvenOdd"/>
            </Path.Data>
        </Path>
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="16" Height="3.5" RadiusX="0.25" RadiusY="0.25" Fill="{DynamicResource ToolbarIconAccent}" StrokeThickness="0.75" Stroke="{DynamicResource ToolbarIconForeground}" StrokeMiterLimit="4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="M 4.5 0.25 V 3.5" FillRule="EvenOdd"/>
            </Path.Data>
        </Path>
        <Path StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}" StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Data>
                <PathGeometry Figures="M 11.5 0.25 V 3.5" FillRule="EvenOdd"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- SAVE ICON                                                                        -->
    <!-- =============================================================================== -->

    <Canvas x:Key="SaveIcon" Width="16" Height="16" x:Shared="False">
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry Figures="M 13.293 0 0 0 0 16 16 16 16 2.707 Z M 2 2 h 8 v 4 H 2 Z m 12 12 H 2 V 8 h 12 z" FillRule="EvenOdd"/>
            </Path.Data>
        </Path>
        <Rectangle Canvas.Left="4" Canvas.Top="9" Width="8" Height="1" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="4" Canvas.Top="11" Width="8" Height="1" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="4" Canvas.Top="13" Width="5" Height="1" Fill="{DynamicResource ToolbarIconForeground}"/>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- UNDO ICON                                                                        -->
    <!-- =============================================================================== -->

    <Canvas x:Key="UndoIcon" Width="16" Height="16" x:Shared="False">
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry Figures="M 7.5 3 V 0 L 2 4.5 7.5 9 V 6 c 3.5 0 6.5 2 6.5 7 0 -7 -3.5 -10 -6.5 -10 z" FillRule="NonZero"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- REDO ICON                                                                        -->
    <!-- =============================================================================== -->

    <Canvas x:Key="RedoIcon" Width="16" Height="16" x:Shared="False">
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry Figures="M 8.5 3 V 0 L 14 4.5 8.5 9 V 6 C 5 6 2 8 2 13 2 6 5.5 3 8.5 3 z" FillRule="NonZero"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- SELECT ALL ICON                                                                  -->
    <!-- =============================================================================== -->

    <Canvas x:Key="SelectAllIcon" Width="16" Height="16" x:Shared="False">
        <Rectangle Canvas.Left="1" Canvas.Top="1" Width="14" Height="14"
                   StrokeThickness="1.5" Stroke="{DynamicResource ToolbarIconForeground}"
                   Fill="{DynamicResource ToolbarIconAccent}" RadiusX="1" RadiusY="1"/>
        <Path Stroke="{DynamicResource ToolbarIconForeground}" StrokeThickness="1.5">
            <Path.Data>
                <PathGeometry Figures="M 4 8 L 7 11 L 12 5"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- DESELECT ALL ICON                                                                -->
    <!-- =============================================================================== -->

    <Canvas x:Key="DeselectAllIcon" Width="16" Height="16" x:Shared="False">
        <Rectangle Canvas.Left="1" Canvas.Top="1" Width="14" Height="14"
                   StrokeThickness="1.5" Stroke="{DynamicResource ToolbarIconForeground}"
                   Fill="Transparent" RadiusX="1" RadiusY="1"/>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- CALCULATOR ICON                                                                  -->
    <!-- =============================================================================== -->

    <Canvas x:Key="CalculatorIcon" Width="16" Height="16" x:Shared="False">
        <Rectangle Canvas.Left="2" Canvas.Top="1" Width="12" Height="14"
                   StrokeThickness="1.5" Stroke="{DynamicResource ToolbarIconForeground}"
                   Fill="Transparent" RadiusX="1" RadiusY="1"/>
        <Rectangle Canvas.Left="4" Canvas.Top="3" Width="8" Height="3"
                   Fill="{DynamicResource ToolbarIconAccent}"/>
        <Rectangle Canvas.Left="4" Canvas.Top="8" Width="2" Height="2" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="7" Canvas.Top="8" Width="2" Height="2" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="10" Canvas.Top="8" Width="2" Height="2" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="4" Canvas.Top="11" Width="2" Height="2" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="7" Canvas.Top="11" Width="2" Height="2" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="10" Canvas.Top="11" Width="2" Height="2" Fill="{DynamicResource ToolbarIconForeground}"/>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- FIND ICON                                                                        -->
    <!-- =============================================================================== -->

    <Canvas x:Key="FindIcon" Width="16" Height="16" x:Shared="False">
        <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10"
                 StrokeThickness="2" Stroke="{DynamicResource ToolbarIconForeground}"
                 Fill="Transparent"/>
        <Path Stroke="{DynamicResource ToolbarIconForeground}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Data>
                <PathGeometry Figures="M 9.5 9.5 L 14.5 14.5"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- STATISTICS ICON                                                                  -->
    <!-- =============================================================================== -->

    <Canvas x:Key="StatisticsIcon" Width="16" Height="16" x:Shared="False">
        <Rectangle Canvas.Left="1" Canvas.Top="10" Width="3" Height="5" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="5" Canvas.Top="6" Width="3" Height="9" Fill="{DynamicResource ToolbarIconAccent}"/>
        <Rectangle Canvas.Left="9" Canvas.Top="3" Width="3" Height="12" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="13" Canvas.Top="1" Width="2" Height="14" Fill="{DynamicResource ToolbarIconAccent}"/>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- PASTE ICON                                                                       -->
    <!-- =============================================================================== -->

    <Canvas x:Key="PasteIcon" Width="16" Height="16" x:Shared="False">
        <Rectangle Canvas.Left="3" Canvas.Top="3" Width="10" Height="12"
                   StrokeThickness="1.5" Stroke="{DynamicResource ToolbarIconForeground}"
                   Fill="Transparent" RadiusX="1" RadiusY="1"/>
        <Rectangle Canvas.Left="5" Canvas.Top="0" Width="6" Height="4"
                   StrokeThickness="1" Stroke="{DynamicResource ToolbarIconForeground}"
                   Fill="{DynamicResource ToolbarIconAccent}" RadiusX="0.5" RadiusY="0.5"/>
        <Rectangle Canvas.Left="5" Canvas.Top="7" Width="6" Height="1" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="5" Canvas.Top="9" Width="6" Height="1" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="5" Canvas.Top="11" Width="4" Height="1" Fill="{DynamicResource ToolbarIconForeground}"/>
    </Canvas>

</ResourceDictionary>
