<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="DefaultCellStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="VerticalSeparatorStyle" TargetType="{x:Type Separator}" BasedOn="{StaticResource {x:Type Separator}}">
        <Setter Property="Margin" Value="2,1,2,1" />
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <TransformGroup>
                    <TransformGroup.Children>
                        <TransformCollection>
                            <RotateTransform Angle="90" />
                        </TransformCollection>
                    </TransformGroup.Children>
                </TransformGroup>
            </Setter.Value>
        </Setter>
    </Style>

    <Canvas x:Key="SortArrow" Width="16" Height="16" x:Shared="False">
        <Canvas.Resources>
            <LinearGradientBrush x:Key="LinearGradient" MappingMode="Absolute" StartPoint="8,5" EndPoint="8,11">
                <LinearGradientBrush.GradientStops>
                    <GradientStopCollection>
                        <GradientStop Color="#FF646464" Offset="1"/>
                        <GradientStop Color="#FF646464" Offset=".1"/>
                        <GradientStop Color="#FFAFAFAF" Offset="0"/>
                    </GradientStopCollection>
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
        </Canvas.Resources>
        <Path Fill="{StaticResource LinearGradient}" StrokeThickness="0" Stroke="#FF4B4B4B" StrokeMiterLimit="4" StrokeLineJoin="Round" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Opacity="1">
            <Path.Data>
                <PathGeometry Figures="M 8 13.25 0.5 5 V 2.75 L 8 6 15.5 2.75 V 5 Z" FillRule="NonZero"/>
            </Path.Data>
        </Path>
    </Canvas>
    
