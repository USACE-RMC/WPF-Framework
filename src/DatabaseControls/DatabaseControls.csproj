<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DatabaseControls</RootNamespace>
    <AssemblyName>DatabaseControls</AssemblyName>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Page Update="Resources\TableViewerResources.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Resources\IconDictionary.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Themes\DatabaseControlsTheme.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.png" />
    <Resource Include="Resources\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="FieldCalculator\ExpressionTextBox.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Help\FieldCalculator\*" />
    <EmbeddedResource Include="Resources\Help\SelectByAttribute\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DatabaseManager\DatabaseManager.csproj" />
    <ProjectReference Include="..\ExpressionParserControls\ExpressionParserControls.csproj" />
    <ProjectReference Include="..\ExpressionParser\ExpressionParser.csproj" />
    <ProjectReference Include="..\GenericControls\GenericControls.csproj" />
    <ProjectReference Include="..\OxyPlotControls\OxyPlotControls.csproj" />
    <ProjectReference Include="..\Themes\Themes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Numerics">
      <HintPath>..\..\..\numerics\Numerics\bin\Debug\net10.0\Numerics.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\OxyPlot\OxyPlot\OxyPlot.csproj" />
    <ProjectReference Include="..\OxyPlot\OxyPlot.Wpf\OxyPlot.Wpf.csproj" />
    <ProjectReference Include="..\OxyPlot\OxyPlot.Wpf.Shared\OxyPlot.Wpf.Shared.csproj" />
  </ItemGroup>

</Project>
