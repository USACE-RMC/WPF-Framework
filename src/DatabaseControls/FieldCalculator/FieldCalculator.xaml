<cntrls:MetroWindow x:Class="DatabaseControls.FieldCalculator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:parser="clr-namespace:ExpressionParserControls;assembly=ExpressionParserControls"
    xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
    Title="Field Calculator" Height="550" Width="700" MinHeight="350" MinWidth="550" ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/DatabaseControls;component/Resources/calculator_16x.png"
    Style="{DynamicResource MetroWindowStyle}"
    Background="{DynamicResource EnvironmentWindowBackground}"
    Foreground="{DynamicResource EnvironmentWindowText}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Field Selection -->
        <Grid Grid.Row="0" Name="FieldSelectionGrid" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <RadioButton Content="Create New Column" HorizontalAlignment="Left" Margin="10, 0, 0,0" Grid.Column="0" Grid.Row="0" VerticalContentAlignment="Center" Name="CreateNewFieldRadioButton" Checked="CreateNewFieldRadioButton_Checked"/>
            <TextBox Name="NewFieldName" Grid.Column="1" Grid.Row="0" Margin="0,0,0,0" Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsEnabled="{Binding ElementName=CreateNewFieldRadioButton, Path=IsChecked}" TextChanged="NewFieldName_TextChanged"/>
            <RadioButton Content="Update Existing Column" HorizontalAlignment="Left" Margin="10,5,0,5" Grid.Row="1" Grid.Column="0" VerticalContentAlignment="Center" Name="UpdateExistingRadioButton" IsChecked="True" Checked="UpdateExistingRadioButton_Checked"/>
            <ComboBox Name="ExistingFieldsCombobox" Grid.Row="1" Grid.Column="1" Height="22" Margin="0,5,0,5" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsEnabled="{Binding ElementName=UpdateExistingRadioButton, Path=IsChecked}" SelectionChanged="ExistingFieldsCombobox_SelectionChanged"/>
        </Grid>

        <!-- Row 1: Main Content — 3-column layout (Data Columns | Functions | Expression) -->
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <!-- Data Columns (fixed width) -->
                <ColumnDefinition x:Name="DataColumnsColumn" Width="170" MinWidth="100"/>
                <!-- Functions column (toggled, matches Data Columns width) -->
                <ColumnDefinition x:Name="FunctionsColumn" Width="0"/>
                <!-- Expression column (fills remaining space) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- Labels row -->
                <RowDefinition Height="Auto"/>
                <!-- Content area (fills) -->
                <RowDefinition Height="*" MinHeight="150"/>
                <!-- Insert buttons / toolbar row (aligned horizontally) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- DATA COLUMNS (Column 0) -->
            <!-- ============================================================ -->

            <TextBlock Text="Data Columns" Grid.Row="0" Grid.Column="0" Margin="0,0,5,3"/>

            <ListBox Grid.Row="1" Grid.Column="0" Margin="0,0,5,0"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     x:Name="VariablesListBox"
                     ToolTip="List of available data columns. Double click to insert into expression."
                     MouseDoubleClick="VariablesListBox_MouseDoubleClick"
                     SelectionChanged="VariablesListBox_SelectionChanged"/>

            <Button Grid.Row="2" Grid.Column="0" Margin="0,3,5,0"
                    Name="InsertVariableButton" IsEnabled="False"
                    Height="24" HorizontalAlignment="Stretch"
                    ToolTip="Insert a data column into the expression."
                    Click="InsertVariableButton_Click">Insert</Button>

            <!-- ============================================================ -->
            <!-- FUNCTIONS (Column 1 — toggled by f(x) button in toolbar) -->
            <!-- ============================================================ -->

            <TextBlock x:Name="FunctionsLabel" Text="Functions" Grid.Row="0" Grid.Column="1"
                       Margin="0,0,5,3" Visibility="Collapsed"/>

            <parser:AvailableFunctions x:Name="FunctionsPanel" Grid.Row="1" Grid.Column="1"
                                       CompactMode="True" Margin="0,0,5,0"
                                       Visibility="Collapsed"/>

            <Button x:Name="InsertFunctionButton" Grid.Row="2" Grid.Column="1"
                    Margin="0,3,5,0" Height="24" HorizontalAlignment="Stretch"
                    IsEnabled="False" Click="InsertFunctionButton_Click"
                    Visibility="Collapsed">Insert</Button>

            <!-- ============================================================ -->
            <!-- EXPRESSION (Column 2) — CalculatorControl spans content + toolbar rows -->
            <!-- ============================================================ -->

            <TextBlock Text="Expression" Grid.Row="0" Grid.Column="2" Margin="0,0,0,3"/>

            <parser:CalculatorControl Grid.Row="1" Grid.Column="2" Grid.RowSpan="2"
                                      Name="ExpressionCalculator"
                                      ExpressionChanged="ExpressionCalculator_ExpressionChanged"/>
        </Grid>

        <!-- Row 2: Result Preview -->
        <TextBlock x:Name="resultTextBlock" Grid.Row="2" Margin="0,3,0,3" TextWrapping="Wrap"
                   Foreground="{DynamicResource EnvironmentWindowText}"/>

        <!-- Row 3: Footer — Checkbox left, Execute right -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox
                Content="Apply to selected records only"
                HorizontalAlignment="Left"
                Name="UseSelectedRange"
                IsEnabled="False"
                VerticalAlignment="Center"
                Grid.Column="0"/>
            <Button Content="Execute" Grid.Column="1" Name="ExecuteButton" IsEnabled="False" IsDefault="True" Width="75" Height="24" Click="ExecuteButton_Click"/>
        </Grid>
    </Grid>
</cntrls:MetroWindow>
