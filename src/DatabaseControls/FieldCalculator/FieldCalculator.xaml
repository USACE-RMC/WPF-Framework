<cntrls:MetroWindow x:Class="DatabaseControls.FieldCalculator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:parser="clr-namespace:ExpressionParserControls;assembly=ExpressionParserControls"
    xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
    Title="Field Calculator" Height="500" Width="700" MinHeight="350" MinWidth="550" ResizeMode="CanResize"
    Icon="pack://application:,,,/DatabaseControls;component/Resources/calculator_16x.png"
    Style="{DynamicResource MetroWindowStyle}"
    Background="{DynamicResource EnvironmentWindowBackground}"
    Foreground="{DynamicResource EnvironmentWindowText}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Field Selection -->
        <Grid Grid.Row="0" Name="FieldSelectionGrid" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <RadioButton Content="Create New Column" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="0" Name="CreateNewFieldRadioButton" Checked="CreateNewFieldRadioButton_Checked"/>
            <TextBox Name="NewFieldName" Grid.Column="1" Grid.Row="0" Margin="5,0,0,0" HorizontalAlignment="Stretch" IsEnabled="{Binding ElementName=CreateNewFieldRadioButton, Path=IsChecked}" TextChanged="NewFieldName_TextChanged"/>
            <RadioButton Content="Update Existing Column" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom" Name="UpdateExistingRadioButton" IsChecked="True" Checked="UpdateExistingRadioButton_Checked"/>
            <ComboBox Name="ExistingFieldsCombobox" Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsEnabled="{Binding ElementName=UpdateExistingRadioButton, Path=IsChecked}" SelectionChanged="ExistingFieldsCombobox_SelectionChanged"/>
        </Grid>

        <!-- Row 1: Main Content — Data Columns + Expression (CalculatorControl) -->
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Data Columns Panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Data Columns" Grid.Row="0" Margin="0,0,0,3"/>
                <ListBox
                    Grid.Row="1"
                    Margin="0,0,5,0"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    x:Name="VariablesListBox"
                    ToolTip="List of available data columns. Double click to insert into expression."
                    MouseDoubleClick="VariablesListBox_MouseDoubleClick"
                    SelectionChanged="VariablesListBox_SelectionChanged"/>
                <Button
                    Grid.Row="2"
                    Margin="0,3,5,0"
                    Name="InsertVariableButton"
                    IsEnabled="False"
                    Height="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ToolTip="Insert a data column into the expression."
                    Click="InsertVariableButton_Click">Insert</Button>
            </Grid>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="2"
                          Background="{DynamicResource EnvironmentWindowBackground}"/>

            <!-- Expression (CalculatorControl) -->
            <Grid Grid.Column="1" Margin="3,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Expression" Grid.Row="0" Margin="0,0,0,3"/>
                <parser:CalculatorControl Grid.Row="1" Name="ExpressionCalculator"
                                          ExpressionChanged="ExpressionCalculator_ExpressionChanged"/>
            </Grid>
        </Grid>

        <!-- Row 2: Result Preview -->
        <TextBlock Text="" Grid.Row="2" HorizontalAlignment="Left" Margin="0,0,0,5" Name="resultTextBlock" VerticalAlignment="Center" TextWrapping="Wrap"/>

        <!-- Row 3: Footer — Checkbox left, Execute right -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox
                Content="Apply to selected records only"
                HorizontalAlignment="Left"
                Name="UseSelectedRange"
                IsEnabled="False"
                VerticalAlignment="Center"
                Grid.Column="0"/>
            <Button Content="Execute" Grid.Column="1" Name="ExecuteButton" IsEnabled="False" IsDefault="True" Width="80" Height="24" Click="ExecuteButton_Click"/>
        </Grid>
    </Grid>
</cntrls:MetroWindow>
