<Window x:Class="DatabaseControls.ErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DatabaseControls"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Title="ErrorWindow" Height="300" Width="300" SizeToContent="Width">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <DataGrid Name="ErrorLogGrid" Grid.Row="1" Margin="5" AutoGenerateColumns="True" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding Path=Errors}"/>

        <Button Grid.Row="2" Content="Close" Name="CancelButton" IsCancel="True" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CancelButton_Click"/>
    </Grid>
</Window>
