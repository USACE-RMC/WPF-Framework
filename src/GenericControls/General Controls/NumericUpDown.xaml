<UserControl x:Class="GenericControls.NumericUpDown" x:Name="NumericUpDownControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="24" d:DesignWidth="50">
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>

        <!--Numeric Text box-->
        <local:NumericTextBox x:Name="NumericTextBox" Grid.Row="0" Grid.Column="0" Text="{Binding ElementName=NumericUpDownControl, Path=Value, Mode=TwoWay}"/>

        <!--Up Down Buttons-->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
            <Button x:Name="cmdUp" Height="10.5" Width="18" Margin="1,1,1,0.5" Click="cmdUp_Click"
                    Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                <Path Data="M 0,4 L 4,0 L 8,4 Z"
                      Fill="{DynamicResource EnvironmentWindowText}"
                      Width="8" Height="5" Stretch="Uniform"/>
            </Button>
            <Button x:Name="cmdDown" Height="10.5" Width="18" Margin="1,0.5,1,1" Click="cmdDown_Click"
                    Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                <Path Data="M 0,0 L 4,4 L 8,0 Z"
                      Fill="{DynamicResource EnvironmentWindowText}"
                      Width="8" Height="5" Stretch="Uniform"/>
            </Button>
        </StackPanel>

    </Grid>
    
</UserControl>
