<local:MetroDialogWindow x:Class="GenericControls.NameDialog" x:Name="NewNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GenericControls"
    Title="Name Dialog"
        Width="346"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Style="{DynamicResource MetroDialogStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}"
        >
    <Grid>
        <!--Add Rows-->
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="4,0,4,0" Text="Name:" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        
        <local:NameTextBox x:Name="NameTBox" Grid.Row="1" HorizontalAlignment="Stretch" Margin="4" VerticalAlignment="Stretch" 
                            Text="{Binding ElementName=NewNameDialog, Path=Text, Mode=TwoWay}"/>

        <!--Custom Content-->
        <ContentControl Grid.Row="2" Margin="4,0,4,0" Name="CustomContentUserControl"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Content="{Binding InnerContent, ElementName=NewNameDialog}"/>
        
        <!--Ok and Cancel buttons-->
        <Grid Grid.Row="3" Height="32" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="82"/>
            </Grid.ColumnDefinitions>
            <Button Name="OKButton" IsDefault="True" Click="OKButton_Click" Content="OK" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="0" Margin="4" Cursor="Hand"/>
            <Button Name="CancelButton" IsCancel="True" Click="CancelButton_Click" Content="Cancel" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="1" Margin="4" Cursor="Hand"/>
        </Grid>
    </Grid>
</local:MetroDialogWindow>
