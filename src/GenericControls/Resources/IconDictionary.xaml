<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    GenericControls Icon Dictionary

    This dictionary contains vector icons that are theme-aware and can be used
    throughout the GenericControls library and beyond.

    Icons use DynamicResource bindings for colors that should change with themes:
    - EnvironmentWindowText: Main icon stroke/fill color (adapts to light/dark)
    - TextBox.Static.Background: Background fill for document icons
    - DataGrid.Header.Border: Header elements

    Semantic colors (remain consistent across themes):
    - #16A34A (Green): Add/Plus operations
    - #DC2626 (Red): Delete/Remove operations
    - #2563EB (Blue): Insert/Selection/Filter operations

    Usage: Reference icons with StaticResource or DynamicResource
    Example: <ContentControl Content="{StaticResource AddRowIcon}"/>

    For buttons, wrap in a Viewbox for consistent sizing:
    <Viewbox Width="16" Height="16">
        <ContentControl Content="{StaticResource AddRowIcon}"/>
    </Viewbox>
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- ROW OPERATIONS                                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Add Row(s) - Row lines with green plus sign -->
    <Viewbox x:Key="AddRowIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <!-- Row lines - centered at Y=3,7,11 -->
            <Path Data="M0,3 H10 M0,7 H10 M0,11 H10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Plus sign - centered vertically -->
            <Path Data="M12,4 V12 M8,8 H16"
                  Stroke="#16A34A" StrokeThickness="2"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Insert Row(s) - Row lines with blue arrow pointing up -->
    <Viewbox x:Key="InsertRowIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <!-- Row lines - centered at Y=3,7,11 -->
            <Path Data="M0,3 H10 M0,7 H10 M0,11 H10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Insert arrow - centered vertically -->
            <Path Data="M12,12 V4 M9,7 L12,4 L15,7"
                  Stroke="#2563EB" StrokeThickness="2" StrokeLineJoin="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Delete Row(s) - Row lines with red X -->
    <Viewbox x:Key="DeleteRowIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <!-- Row lines - centered at Y=3,7,11 -->
            <Path Data="M0,3 H10 M0,7 H10 M0,11 H10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- X mark - centered vertically -->
            <Path Data="M9,5 L15,11 M15,5 L9,11"
                  Stroke="#DC2626" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COLUMN OPERATIONS                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Add Column(s) - Column lines with green plus sign -->
    <Viewbox x:Key="AddColumnIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <!-- Column lines -->
            <Path Data="M3,0 V10 M7,0 V10 M11,0 V10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,0,0,0"/>
            <!-- Plus sign - centered at X=8 -->
            <Path Data="M8,8 V16 M4,12 H12"
                  Stroke="#16A34A" StrokeThickness="2"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Insert Column(s) - Column lines with blue arrow pointing left -->
    <Viewbox x:Key="InsertColumnIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <!-- Column lines -->
            <Path Data="M3,0 V10 M7,0 V10 M11,0 V10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,0,0,0"/>
            <!-- Insert arrow pointing left - centered at X=8 -->
            <Path Data="M4,12 H12 M7,9 L4,12 L7,15"
                  Stroke="#2563EB" StrokeThickness="2" StrokeLineJoin="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Delete Column(s) - Column lines with red X -->
    <Viewbox x:Key="DeleteColumnIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <!-- Column lines -->
            <Path Data="M3,0 V10 M7,0 V10 M11,0 V10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,0,0,0"/>
            <!-- X mark - centered at X=8 -->
            <Path Data="M5,9 L11,15 M11,9 L5,15"
                  Stroke="#DC2626" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CLIPBOARD OPERATIONS                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Select All - Grid with selection highlight -->
    <Viewbox x:Key="SelectAllIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16"  >
            <!-- Grid cells -->
            <Path Data="M1,1 H15 V15 H1 Z M1,5 H15 M1,10 H15 M5,1 V15 M10,1 V15"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <!-- Selection highlight -->
            <Rectangle Width="14" Height="14" Fill="#2563EB" Opacity="0.3"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Viewbox>

    <!-- Copy - Two overlapping documents -->
    <Viewbox x:Key="CopyIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16" >
            <!-- Back document -->
            <Path Data="M5,1 H14 V12 H5 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource TextBox.Static.Background}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Front document -->
            <Path Data="M2,4 H11 V15 H2 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource TextBox.Static.Background}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Lines on front doc -->
            <Path Data="M4,7 H9 M4,10 H9 M4,13 H7"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Copy with Headers - Two documents with header bar -->
    <Viewbox x:Key="CopyWithHeadersIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16" >
            <!-- Back document -->
            <Path Data="M5,1 H14 V12 H5 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource TextBox.Static.Background}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Front document -->
            <Path Data="M2,4 H11 V15 H2 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource TextBox.Static.Background}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Header bar -->
            <Rectangle Width="8" Height="2" Fill="#2563EB"
                       Margin="3,5,0,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Lines on front doc -->
            <Path Data="M4,10 H9 M4,13 H7"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Paste - Clipboard with document -->
    <Viewbox x:Key="PasteIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16" >
            <!-- Clipboard body -->
            <Path Data="M3,3 H13 V15 H3 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource TextBox.Static.Background}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Clipboard clip -->
            <Path Data="M6,1 H10 V4 H6 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource DataGrid.Header.Border}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Clipboard clip inner -->
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="7,0,0,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Document lines -->
            <Path Data="M5,7 H11 M5,10 H11 M5,13 H9"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- SORT ICONS                                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Sort Up (Ascending) - Filled triangle pointing up -->
    <Viewbox x:Key="SortUpIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M8,2 L14,14 H2 Z"
                  Fill="{DynamicResource EnvironmentWindowText}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Viewbox>

    <!-- Sort Down (Descending) - Filled triangle pointing down -->
    <Viewbox x:Key="SortDownIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M8,14 L14,2 H2 Z"
                  Fill="{DynamicResource EnvironmentWindowText}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- FILTER ICONS                                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Sort Ascending Filter - Solid funnel with up arrow -->
    <Viewbox x:Key="SortAscFilterIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <!-- Solid filter funnel - symmetric with flat bottom stem -->
            <Path Data="M1,2 H10 L7,6 V10 H4 V6 Z"
                  Fill="#2563EB"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Up arrow - centered at X=12 -->
            <Path Data="M12,12 V4 M9,7 L12,4 L15,7"
                  Stroke="#2563EB" StrokeThickness="2" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Sort Descending Filter - Solid funnel with down arrow -->
    <Viewbox x:Key="SortDescFilterIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <!-- Solid filter funnel - symmetric with flat bottom stem -->
            <Path Data="M1,2 H10 L7,6 V10 H4 V6 Z"
                  Fill="#2563EB"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Down arrow - centered at X=12 -->
            <Path Data="M12,4 V12 M9,9 L12,12 L15,9"
                  Stroke="#2563EB" StrokeThickness="2" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Clear Filter - Solid funnel with red X -->
    <Viewbox x:Key="ClearFilterIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <!-- Solid filter funnel - symmetric with flat bottom stem -->
            <Path Data="M1,2 H10 L7,6 V10 H4 V6 Z"
                  Fill="{DynamicResource EnvironmentWindowText}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- X mark - centered at X=12 -->
            <Path Data="M9,4 L15,10 M15,4 L9,10"
                  Stroke="#DC2626" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- DATE/TIME ICONS                                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Calendar Icon - Calendar with clock overlay -->
    <Viewbox x:Key="CalendarIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <!-- Calendar body -->
            <Rectangle Width="12" Height="12"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}"
                       Margin="0,2,0,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Calendar top bar -->
            <Rectangle Width="12" Height="3" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="0,2,0,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Calendar binding rings -->
            <Rectangle Width="1" Height="3" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="3,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="1" Height="3" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="8,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Calendar grid dots (representing dates) - using filled rectangles -->
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="2,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="5,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="8,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="2,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="5,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Clock circle -->
            <Ellipse Width="7" Height="7"
                     Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                     Fill="{DynamicResource TextBox.Static.Background}"
                     Margin="9,9,0,0"
                     VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- Clock hands -->
            <Path Data="M12.5,10.5 V12.5 M12.5,12.5 L14,13.5"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- LEGACY ICON SUPPORT (from GenericResources.xaml)                            -->
    <!-- These icons are kept for backward compatibility                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Swap Axes Icon -->
    <Viewbox x:Key="SwapAxesIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path StrokeThickness="1" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 M 1.5 1 V 15" />
            <Path StrokeThickness="1" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 M 1 14.5 H 15" />
            <Path StrokeThickness="1.5" Stroke="{DynamicResource EnvironmentWindowText}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F1 M 4 5.5 9.5 11"/>
            <Path StrokeThickness="1.5" Stroke="{DynamicResource EnvironmentWindowText}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F1 M 7.5 4 13 9.5"/>
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="F1 M 11.5 12 9 9.5 6 12 Z"/>
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="F1 M 5.5 3 8 5.5 11 3 Z"/>
        </Canvas>
    </Viewbox>

    <!-- Zoom In Icon -->
    <Viewbox x:Key="ZoomInIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="64" Height="64">
            <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="43" Height="43" StrokeThickness="5" Stroke="{DynamicResource EnvironmentWindowText}"/>
            <Path StrokeThickness="5" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 M 25 14.5000 V 35.5" />
            <Path StrokeThickness="5" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 M 35.5 25 H 14.5" />
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="F1 M 52 52 33 44.9 44.9 33 Z" />
            <Path StrokeThickness="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F0 m 41.5 41.5 18 18" />
        </Canvas>
    </Viewbox>

