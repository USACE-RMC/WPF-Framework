<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    GenericControls Icon Dictionary - Clean, Simple Vector Icons

    Theme-aware icons using DynamicResource bindings:
    - EnvironmentWindowText: Main stroke/fill color (adapts to light/dark)
    - TextBox.Static.Background: Background fill for document icons

    Semantic colors (consistent across themes):
    - #16A34A (Green): Add/Plus operations
    - #DC2626 (Red): Delete/Remove operations
    - #2563EB (Blue): Insert/Selection/Filter operations

    Crisp rendering via Canvas with integer coordinates.
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- ROW OPERATIONS - Simple horizontal lines with action indicators             -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Add Row(s) - Horizontal lines with green plus -->
    <Viewbox x:Key="DGAddRowIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Three horizontal lines representing rows -->
            <Line X1="1" Y1="3" X2="10" Y2="3" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="1" Y1="7" X2="10" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="1" Y1="11" X2="10" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Green plus sign -->
            <Line X1="13" Y1="8" X2="13" Y2="14" Stroke="#16A34A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="10" Y1="11" X2="16" Y2="11" Stroke="#16A34A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>

    <!-- Insert Row(s) - Horizontal lines with blue arrow -->
    <Viewbox x:Key="DGInsertRowIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Three horizontal lines representing rows -->
            <Line X1="1" Y1="3" X2="10" Y2="3" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="1" Y1="7" X2="10" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="1" Y1="11" X2="10" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Blue arrow pointing down -->
            <Line X1="13" Y1="5" X2="13" Y2="14" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M10,11 L13,14 L16,11" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
        </Canvas>
    </Viewbox>

    <!-- Delete Row(s) - Horizontal lines with red X -->
    <Viewbox x:Key="DGDeleteRowIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Three horizontal lines representing rows -->
            <Line X1="1" Y1="3" X2="10" Y2="3" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="1" Y1="7" X2="10" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="1" Y1="11" X2="10" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Red X -->
            <Line X1="10" Y1="8" X2="15" Y2="13" Stroke="#DC2626" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="15" Y1="8" X2="10" Y2="13" Stroke="#DC2626" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COLUMN OPERATIONS - Simple vertical lines with action indicators            -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Add Column(s) - Vertical lines with green plus -->
    <Viewbox x:Key="AddColumnIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Three vertical lines representing columns -->
            <Line X1="3" Y1="1" X2="3" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="7" Y1="1" X2="7" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="11" Y1="1" X2="11" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Green plus sign -->
            <Line X1="13" Y1="8" X2="13" Y2="14" Stroke="#16A34A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="10" Y1="11" X2="16" Y2="11" Stroke="#16A34A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>

    <!-- Insert Column(s) - Vertical lines with blue arrow -->
    <Viewbox x:Key="InsertColumnIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Three vertical lines representing columns -->
            <Line X1="3" Y1="1" X2="3" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="7" Y1="1" X2="7" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="11" Y1="1" X2="11" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Blue arrow pointing right -->
            <Line X1="8" Y1="13" X2="15" Y2="13" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M12,10 L15,13 L12,16" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
        </Canvas>
    </Viewbox>

    <!-- Delete Column(s) - Vertical lines with red X -->
    <Viewbox x:Key="DeleteColumnIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Three vertical lines representing columns -->
            <Line X1="3" Y1="1" X2="3" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="7" Y1="1" X2="7" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="11" Y1="1" X2="11" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Red X -->
            <Line X1="10" Y1="8" X2="15" Y2="13" Stroke="#DC2626" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="15" Y1="8" X2="10" Y2="13" Stroke="#DC2626" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CLIPBOARD OPERATIONS - Simple document shapes                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Select All - Grid with highlight -->
    <Viewbox x:Key="DGSelectAllIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Selection highlight -->
            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" Fill="#2563EB" Opacity="0.2"/>
            <!-- Grid outline -->
            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="Transparent"/>
            <!-- Grid lines -->
            <Line X1="1" Y1="6" X2="15" Y2="6" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="1" Y1="11" X2="15" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="6" Y1="1" X2="6" Y2="15" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="11" Y1="1" X2="11" Y2="15" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
        </Canvas>
    </Viewbox>

    <!-- Copy - Two overlapping rectangles -->
    <Viewbox x:Key="DGCopyIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Back document -->
            <Rectangle Canvas.Left="4" Canvas.Top="1" Width="10" Height="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="{DynamicResource TextBox.Static.Background}"/>
            <!-- Front document -->
            <Rectangle Canvas.Left="1" Canvas.Top="4" Width="10" Height="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="{DynamicResource TextBox.Static.Background}"/>
            <!-- Document lines -->
            <Line X1="3" Y1="8" X2="9" Y2="8" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="3" Y1="11" X2="9" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
        </Canvas>
    </Viewbox>

    <!-- Copy with Headers - Two rectangles with header bar -->
    <Viewbox x:Key="DGCopyWithHeadersIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Back document -->
            <Rectangle Canvas.Left="4" Canvas.Top="1" Width="10" Height="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="{DynamicResource TextBox.Static.Background}"/>
            <!-- Front document -->
            <Rectangle Canvas.Left="1" Canvas.Top="4" Width="10" Height="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="{DynamicResource TextBox.Static.Background}"/>
            <!-- Blue header bar -->
            <Rectangle Canvas.Left="2" Canvas.Top="5" Width="8" Height="2" Fill="#2563EB"/>
            <!-- Document line -->
            <Line X1="3" Y1="11" X2="9" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
        </Canvas>
    </Viewbox>

    <!-- Paste - Clipboard shape -->
    <Viewbox x:Key="DGPasteIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Clipboard body -->
            <Rectangle Canvas.Left="2" Canvas.Top="3" Width="12" Height="12" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="{DynamicResource TextBox.Static.Background}"/>
            <!-- Clipboard clip -->
            <Rectangle Canvas.Left="5" Canvas.Top="1" Width="6" Height="3" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="{DynamicResource EnvironmentWindowText}"/>
            <!-- Document lines -->
            <Line X1="4" Y1="8" X2="12" Y2="8" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="4" Y1="11" X2="12" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
        </Canvas>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- SORT ICONS - Simple triangles                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Sort Up (Ascending) -->
    <Viewbox x:Key="SortUpIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Data="M8,3 L13,12 L3,12 Z" Fill="{DynamicResource EnvironmentWindowText}"/>
        </Canvas>
    </Viewbox>

    <!-- Sort Down (Descending) -->
    <Viewbox x:Key="SortDownIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Data="M8,13 L13,4 L3,4 Z" Fill="{DynamicResource EnvironmentWindowText}"/>
        </Canvas>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- FILTER ICONS - Funnel with arrows                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Sort Ascending Filter -->
    <Viewbox x:Key="DGSortAscFilterIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Funnel -->
            <Path Data="M1,2 L7,8 L7,12 L5,14 L5,8 L1,2" Stroke="#2563EB" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
            <!-- Up arrow -->
            <Line X1="12" Y1="13" X2="12" Y2="5" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M9,8 L12,5 L15,8" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
        </Canvas>
    </Viewbox>

    <!-- Sort Descending Filter -->
    <Viewbox x:Key="DGSortDescFilterIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Funnel -->
            <Path Data="M1,2 L7,8 L7,12 L5,14 L5,8 L1,2" Stroke="#2563EB" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
            <!-- Down arrow -->
            <Line X1="12" Y1="3" X2="12" Y2="11" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M9,8 L12,11 L15,8" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
        </Canvas>
    </Viewbox>

    <!-- Clear Filter -->
    <Viewbox x:Key="DGClearFilterIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Funnel -->
            <Path Data="M1,2 L7,8 L7,12 L5,14 L5,8 L1,2" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
            <!-- Red X -->
            <Line X1="9" Y1="5" X2="15" Y2="11" Stroke="#DC2626" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="15" Y1="5" X2="9" Y2="11" Stroke="#DC2626" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- DATE/TIME ICONS                                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Calendar Icon -->
    <Viewbox x:Key="CalendarIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
            <!-- Calendar body -->
            <Rectangle Canvas.Left="1" Canvas.Top="3" Width="10" Height="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="{DynamicResource TextBox.Static.Background}"/>
            <!-- Calendar header -->
            <Rectangle Canvas.Left="1" Canvas.Top="3" Width="10" Height="3" Fill="{DynamicResource EnvironmentWindowText}"/>
            <!-- Binding rings -->
            <Line X1="4" Y1="1" X2="4" Y2="5" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="8" Y1="1" X2="8" Y2="5" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Clock overlay -->
            <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1" Fill="{DynamicResource TextBox.Static.Background}"/>
            <Line X1="12" Y1="10" X2="12" Y2="12" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="12" Y1="12" X2="14" Y2="13" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
        </Canvas>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- LEGACY/UTILITY ICONS                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Swap Axes Icon -->
    <Viewbox x:Key="SwapAxesIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Line X1="2" Y1="1" X2="2" Y2="15" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="1" Y1="14" X2="15" Y2="14" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Path Data="M4,6 L10,12" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M8,4 L13,9" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M11,12 L9,10 L6,12 Z" Fill="{DynamicResource EnvironmentWindowText}"/>
            <Path Data="M6,3 L8,5 L11,3 Z" Fill="{DynamicResource EnvironmentWindowText}"/>
        </Canvas>
    </Viewbox>

    <!-- Zoom In Icon -->
    <Viewbox x:Key="ZoomInIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5"/>
            <Line X1="6" Y1="3" X2="6" Y2="9" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5"/>
            <Line X1="3" Y1="6" X2="9" Y2="6" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5"/>
            <Line X1="10" Y1="10" X2="15" Y2="15" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>

    <!-- Inspect Icon -->
    <Viewbox x:Key="InspectIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5"/>
            <Line X1="10" Y1="10" X2="15" Y2="15" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M6,4 Q5,5 6,6 Q7,7 6,8" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="Transparent"/>
            <Ellipse Canvas.Left="5" Canvas.Top="9" Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"/>
        </Canvas>
    </Viewbox>

    <!-- Rotate Icon -->
    <Viewbox x:Key="RotateIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Data="M8,2 A6,6 0 1 1 2,8" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="Transparent"/>
            <Path Data="M8,2 A6,6 0 1 0 14,8" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="Transparent"/>
            <Path Data="M5,1 L8,4 L11,1 Z" Fill="{DynamicResource EnvironmentWindowText}"/>
            <Path Data="M11,15 L8,12 L5,15 Z" Fill="{DynamicResource EnvironmentWindowText}"/>
        </Canvas>
    </Viewbox>

    <!-- Zoom All Icon -->
    <Viewbox x:Key="ZoomAllIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Data="M1,5 L1,1 L5,1 M11,1 L15,1 L15,5 M15,11 L15,15 L11,15 M5,15 L1,15 L1,11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" Fill="Transparent"/>
            <Path Data="M8,4 L8,7 M4,8 L7,8 M8,12 L8,9 M12,8 L9,8" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M6,4 L8,2 L10,4 Z" Fill="{DynamicResource EnvironmentWindowText}"/>
            <Path Data="M4,6 L2,8 L4,10 Z" Fill="{DynamicResource EnvironmentWindowText}"/>
            <Path Data="M10,12 L8,14 L6,12 Z" Fill="{DynamicResource EnvironmentWindowText}"/>
            <Path Data="M12,10 L14,8 L12,6 Z" Fill="{DynamicResource EnvironmentWindowText}"/>
        </Canvas>
    </Viewbox>

    <!-- Plus Icon -->
    <Viewbox x:Key="PlusIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Line X1="8" Y1="2" X2="8" Y2="14" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="2" Y1="8" X2="14" Y2="8" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>

    <!-- Camera Icon -->
    <Viewbox x:Key="CameraIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="M5,2 L6,4 L10,4 L11,2 Z"/>
            <Rectangle Canvas.Left="1" Canvas.Top="4" Width="14" Height="10" Rx="1" Fill="{DynamicResource EnvironmentWindowText}"/>
            <Ellipse Canvas.Left="5" Canvas.Top="6" Width="6" Height="6" Fill="{DynamicResource TextBox.Static.Background}"/>
            <Ellipse Canvas.Left="6" Canvas.Top="7" Width="4" Height="4" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
        </Canvas>
    </Viewbox>

    <!-- Properties/Cog Icon -->
    <Viewbox x:Key="PropertiesIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="M7,1 L9,1 L9,3 Q10,3 11,4 L13,3 L14,4 L13,6 Q14,7 14,8 L16,8 L16,10 L14,10 Q14,11 13,12 L14,14 L13,15 L11,14 Q10,15 9,15 L9,17 L7,17 L7,15 Q6,15 5,14 L3,15 L2,14 L3,12 Q2,11 2,10 L0,10 L0,8 L2,8 Q2,7 3,6 L2,4 L3,3 L5,4 Q6,3 7,3 Z M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5 Z"/>
        </Canvas>
    </Viewbox>

    <!-- Pan Hand Icon -->
    <Viewbox x:Key="PanHandIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource TextBox.Static.Background}" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1" Data="M7,2 L7,9 L5,7 L4,8 L7,12 L7,15 L12,15 L14,12 L14,6 L13,5 L12,6 L12,4 L11,3 L10,4 L10,3 L9,2 L8,3 L8,2 Z"/>
        </Canvas>
    </Viewbox>

    <!-- Export Table Icon -->
    <Viewbox x:Key="ExportTableIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="M2,2 L2,14 L12,14 L12,10 L14,8 L14,2 Z M4,4 L12,4 L12,6 L4,6 Z"/>
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="M10,8 L10,12 L15,8 L10,4 Z"/>
        </Canvas>
    </Viewbox>

</ResourceDictionary>
