    <Viewbox x:Key="SortDescFilterIcon" Width="16" Height="16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Rectangle Width="16" Height="16">
            <Rectangle.Fill>
                <DrawingBrush>
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <DrawingGroup.Children>
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M0,3.0004L0,4.2764 3,9.2774 3,14.0004 7,14.0004 7,9.9204 11.522,14.4434 16,9.9484 16,9.4004 14.154,7.5544 13.006,8.6994 13.006,3.0044 10.765,3.0044 10.767,3.0004z M7,9.2774L10.006,4.2674 10.006,8.6824 8.874,7.5554 7,9.4304z" />
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M9,4L6,9 6,13 4,13 4,9 1,4z" />
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconAccent}" Geometry="F1M14.1504,8.9678L14.8574,9.6748 11.5174,13.0278 8.1654,9.6748 8.8724,8.9678 11.0034,11.0898 11.0034,4.0038 12.0034,4.0038 12.0034,11.1078z" />
                            </DrawingGroup.Children>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Viewbox>

    <!-- Clear Filter - Solid funnel with red X -->
    <Viewbox x:Key="ClearFilterIcon" Width="16" Height="16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Rectangle Width="16" Height="16">
            <Rectangle.Fill>
                <DrawingBrush>
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <DrawingGroup.Children>
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M6.7581,-0.000199999999999534L4.7071,2.0508 2.6561,-0.000199999999999534 2.1721,-0.000199999999999534 9.99999999997669E-05,2.1718 9.99999999997669E-05,3.0008 1.8791,4.8788 9.99999999997669E-05,6.7578 9.99999999997669E-05,7.5858 2.4141,9.9998 4.7071,7.7078 6.7031,9.7028 8.0001,11.3508 8.0001,15.9998 12.0001,15.9998 12.0001,11.3508 16.0001,6.2688 16.0001,4.9998 7.6561,4.9998 7.5351,4.8788 9.8281,2.5858 7.2421,-0.000199999999999534z" />
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M15,6L11,11 11,15 9,15 9,11 7.667,9.334 9.828,7.172 8.656,6z" />
                                <GeometryDrawing Brush="#DC2626" Geometry="F1M8.4141,2.5859L7.0001,1.1719 4.7071,3.4649 2.4141,1.1719 1.0001,2.5859 3.2931,4.8789 1.0001,7.1719 2.4141,8.5859 4.7071,6.2929 7.0001,8.5859 8.4141,7.1719 6.1211,4.8789z" />
                            </DrawingGroup.Children>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- DATE/TIME ICONS                                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Calendar Icon - Calendar with clock overlay -->
    <Viewbox x:Key="CalendarIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Rectangle Width="12" Height="12"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}"
                       Margin="0,2,0,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="12" Height="3" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="0,2,0,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="1" Height="3" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="3,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="1" Height="3" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="8,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="2,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="5,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="8,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="2,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="5,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Ellipse Width="7" Height="7"
                     Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                     Fill="{DynamicResource TextBox.Static.Background}"
                     Margin="9,9,0,0"
                     VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Path Data="M12.5,10.5 V12.5 M12.5,12.5 L14,13.5"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COMMON ACTION ICONS                                                         -->
    <!-- Standard icons for delete, add, run, stop, download, browse operations      -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Delete Image - ImageSource version for use in Image controls -->
    <DrawingImage x:Key="DeleteImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M8.0001,5.1721L3.4571,0.6291 0.629099999999999,3.4571 5.1721,8.0001 0.629099999999999,12.5431 3.4571,15.3711 8.0001,10.8281 12.5431,15.3711 15.3711,12.5431 10.8281,8.0001 15.3711,3.4571 12.5431,0.6291z" />
                <GeometryDrawing Brush="#DC2626" Geometry="F1M9.4141,8L13.9571,12.543 12.5431,13.957 8.0001,9.414 3.4571,13.957 2.0431,12.543 6.5861,8 2.0431,3.457 3.4571,2.043 8.0001,6.586 12.5431,2.043 13.9571,3.457z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingBrush x:Key="DeleteIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M8.0001,5.1721L3.4571,0.6291 0.629099999999999,3.4571 5.1721,8.0001 0.629099999999999,12.5431 3.4571,15.3711 8.0001,10.8281 12.5431,15.3711 15.3711,12.5431 10.8281,8.0001 15.3711,3.4571 12.5431,0.6291z" />
