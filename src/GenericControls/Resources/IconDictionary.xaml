                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <DrawingGroup.Children>
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M10.3419,3.7078L10.7669,3.0008 -9.99999999997669E-05,3.0008 -9.99999999997669E-05,4.2768 2.9999,9.2768 2.9999,13.9998 6.9999,13.9998 6.9999,9.2768 7.6289,8.2278 8.8509,9.4488 9.9999,8.3038 9.9999,13.9998 12.9999,13.9998 12.9999,8.3218 14.1309,9.4488 15.9999,7.5808 15.9999,7.0778 11.4839,2.5608z" />
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M9,4L6,9 6,13 4,13 4,9 1,4z" />
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconAccent}" Geometry="F1M8.8521,8.0361L8.1451,7.3291 11.4851,3.9761 14.8371,7.3291 14.1301,8.0361 12.0001,5.9131 12.0001,13.0001 11.0001,13.0001 11.0001,5.8961z" />
                            </DrawingGroup.Children>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Viewbox>

