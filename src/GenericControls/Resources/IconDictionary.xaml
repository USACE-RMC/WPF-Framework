<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    GenericControls Icon Dictionary

    This dictionary contains vector icons that are theme-aware and render crisply
    at any size. Icons are designed to match the original PNG icons in style.

    Icons use DynamicResource bindings for colors that should change with themes:
    - EnvironmentWindowText: Main icon stroke/fill color (adapts to light/dark)
    - TextBox.Static.Background: Background fill for document icons

    Semantic colors (remain consistent across themes):
    - #16A34A (Green): Add/Plus operations
    - #DC2626 (Red): Delete/Remove operations
    - #2563EB (Blue): Insert/Selection/Filter operations

    For crisp rendering, icons use:
    - SnapsToDevicePixels="True"
    - UseLayoutRounding="True"
    - RenderOptions.EdgeMode="Aliased" where appropriate
    - Pixel-aligned coordinates

    Usage: Reference icons with StaticResource or DynamicResource
    Example: <ContentControl Content="{StaticResource AddRowIcon}"/>
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- ROW OPERATIONS - Grid table design matching PNG icons                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Add Row(s) - Grid table with green plus sign -->
    <Viewbox x:Key="DGAddRowIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Table grid background -->
            <Rectangle Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="0,0,0,0"/>
            <!-- Horizontal grid lines -->
            <Line X1="0" Y1="4" X2="11" Y2="4" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="0" Y1="7" X2="11" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Vertical grid lines -->
            <Line X1="4" Y1="0" X2="4" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="8" Y1="0" X2="8" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Green plus sign -->
            <Path Data="M13,8 V14 M10,11 H16" Stroke="#16A34A" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Viewbox>

    <!-- Insert Row(s) - Grid table with blue insert arrow -->
    <Viewbox x:Key="DGInsertRowIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Table grid background -->
            <Rectangle Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="0,0,0,0"/>
            <!-- Horizontal grid lines -->
            <Line X1="0" Y1="4" X2="11" Y2="4" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="0" Y1="7" X2="11" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Vertical grid lines -->
            <Line X1="4" Y1="0" X2="4" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="8" Y1="0" X2="8" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Highlight row for insert -->
            <Rectangle Width="11" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="#2563EB" Opacity="0.3" Margin="0,4,0,0"/>
            <!-- Blue arrow pointing into row -->
            <Path Data="M13,14 V7 M10,10 L13,7 L16,10" Stroke="#2563EB" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>

    <!-- Delete Row(s) - Grid table with red X -->
    <Viewbox x:Key="DGDeleteRowIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Table grid background -->
            <Rectangle Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="0,0,0,0"/>
            <!-- Horizontal grid lines -->
            <Line X1="0" Y1="4" X2="11" Y2="4" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="0" Y1="7" X2="11" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Vertical grid lines -->
            <Line X1="4" Y1="0" X2="4" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="8" Y1="0" X2="8" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Red X mark -->
            <Path Data="M10,8 L15,13 M15,8 L10,13" Stroke="#DC2626" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COLUMN OPERATIONS - Grid table design matching PNG icons                     -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Add Column(s) - Grid table with green plus sign -->
    <Viewbox x:Key="AddColumnIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Table grid background -->
            <Rectangle Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="0,0,0,0"/>
            <!-- Horizontal grid lines -->
            <Line X1="0" Y1="4" X2="11" Y2="4" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="0" Y1="7" X2="11" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Vertical grid lines -->
            <Line X1="4" Y1="0" X2="4" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="8" Y1="0" X2="8" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Green plus sign -->
            <Path Data="M13,8 V14 M10,11 H16" Stroke="#16A34A" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Viewbox>

    <!-- Insert Column(s) - Grid table with blue insert arrow -->
    <Viewbox x:Key="InsertColumnIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Table grid background -->
            <Rectangle Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="0,0,0,0"/>
            <!-- Horizontal grid lines -->
            <Line X1="0" Y1="4" X2="11" Y2="4" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="0" Y1="7" X2="11" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Vertical grid lines -->
            <Line X1="4" Y1="0" X2="4" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="8" Y1="0" X2="8" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Highlight column for insert -->
            <Rectangle Width="4" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="#2563EB" Opacity="0.3" Margin="4,0,0,0"/>
            <!-- Blue arrow pointing into column -->
            <Path Data="M15,13 H8 M11,10 L8,13 L11,16" Stroke="#2563EB" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>

    <!-- Delete Column(s) - Grid table with red X -->
    <Viewbox x:Key="DeleteColumnIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Table grid background -->
            <Rectangle Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="0,0,0,0"/>
            <!-- Horizontal grid lines -->
            <Line X1="0" Y1="4" X2="11" Y2="4" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="0" Y1="7" X2="11" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Vertical grid lines -->
            <Line X1="4" Y1="0" X2="4" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="8" Y1="0" X2="8" Y2="11" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Red X mark -->
            <Path Data="M10,8 L15,13 M15,8 L10,13" Stroke="#DC2626" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CLIPBOARD OPERATIONS                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Select All - Grid with selection highlight -->
    <Viewbox x:Key="DGSelectAllIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Selection highlight background -->
            <Rectangle Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Fill="#2563EB" Opacity="0.25"/>
            <!-- Table grid outline -->
            <Rectangle Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="Transparent"/>
            <!-- Horizontal grid lines -->
            <Line X1="1" Y1="5" X2="15" Y2="5" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="1" Y1="10" X2="15" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <!-- Vertical grid lines -->
            <Line X1="5" Y1="1" X2="5" Y2="15" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="10" Y1="1" X2="10" Y2="15" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
        </Grid>
    </Viewbox>

    <!-- Copy - Two overlapping documents -->
    <Viewbox x:Key="DGCopyIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Back document -->
            <Rectangle Width="10" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="5,0,0,0"/>
            <!-- Front document -->
            <Rectangle Width="10" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="1,4,0,0"/>
            <!-- Document lines -->
            <Line X1="3" Y1="7" X2="9" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="3" Y1="10" X2="9" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="3" Y1="13" X2="7" Y2="13" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
        </Grid>
    </Viewbox>

    <!-- Copy with Headers - Two documents with header bar -->
    <Viewbox x:Key="DGCopyWithHeadersIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Back document -->
            <Rectangle Width="10" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="5,0,0,0"/>
            <!-- Front document -->
            <Rectangle Width="10" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="1,4,0,0"/>
            <!-- Blue header bar -->
            <Rectangle Width="8" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="#2563EB" Margin="2,5,0,0"/>
            <!-- Document lines -->
            <Line X1="3" Y1="10" X2="9" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="3" Y1="13" X2="7" Y2="13" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
        </Grid>
    </Viewbox>

    <!-- Paste - Clipboard with document -->
    <Viewbox x:Key="DGPasteIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Clipboard body -->
            <Rectangle Width="12" Height="13" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}"/>
            <!-- Clipboard clip top -->
            <Rectangle Width="6" Height="3" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource EnvironmentWindowText}" Margin="0,1,0,0"/>
            <!-- Clip hole -->
            <Ellipse Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Fill="{DynamicResource TextBox.Static.Background}" Margin="0,0,0,0"/>
            <!-- Document lines -->
            <Line X1="4" Y1="7" X2="12" Y2="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="4" Y1="10" X2="12" Y2="10" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
            <Line X1="4" Y1="13" X2="10" Y2="13" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- SORT ICONS                                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Sort Up (Ascending) - Filled triangle pointing up -->
    <Viewbox x:Key="SortUpIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16">
            <Path Data="M8,2 L14,13 H2 Z"
                  Fill="{DynamicResource EnvironmentWindowText}"/>
        </Grid>
    </Viewbox>

    <!-- Sort Down (Descending) - Filled triangle pointing down -->
    <Viewbox x:Key="SortDownIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16">
            <Path Data="M8,14 L14,3 H2 Z"
                  Fill="{DynamicResource EnvironmentWindowText}"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- FILTER ICONS                                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Sort Ascending Filter - Funnel with up arrow -->
    <Viewbox x:Key="DGSortAscFilterIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16">
            <!-- Filter funnel -->
            <Path Data="M1,1 L6,7 V11 L4,12 V7 L-1,1 Z"
                  Stroke="#2563EB" StrokeThickness="1.5"
                  Fill="Transparent" StrokeLineJoin="Round"
                  HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <!-- Up arrow -->
            <Path Data="M12,14 V5 M9,8 L12,5 L15,8"
                  Stroke="#2563EB" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>

    <!-- Sort Descending Filter - Funnel with down arrow -->
    <Viewbox x:Key="DGSortDescFilterIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16">
            <!-- Filter funnel -->
            <Path Data="M1,1 L6,7 V11 L4,12 V7 L-1,1 Z"
                  Stroke="#2563EB" StrokeThickness="1.5"
                  Fill="Transparent" StrokeLineJoin="Round"
                  HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <!-- Down arrow -->
            <Path Data="M12,3 V12 M9,9 L12,12 L15,9"
                  Stroke="#2563EB" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>

    <!-- Clear Filter - Funnel with red X -->
    <Viewbox x:Key="DGClearFilterIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16">
            <!-- Filter funnel -->
            <Path Data="M1,1 L6,7 V11 L4,12 V7 L-1,1 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5"
                  Fill="Transparent" StrokeLineJoin="Round"
                  HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <!-- Red X mark -->
            <Path Data="M9,5 L15,11 M15,5 L9,11"
                  Stroke="#DC2626" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- DATE/TIME ICONS                                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Calendar Icon - Calendar with clock overlay -->
    <Viewbox x:Key="CalendarIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
            <!-- Calendar body -->
            <Rectangle Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                       Fill="{DynamicResource TextBox.Static.Background}" Margin="0,3,0,0"/>
            <!-- Calendar header -->
            <Rectangle Width="11" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="{DynamicResource EnvironmentWindowText}" Margin="0,3,0,0"/>
            <!-- Binding rings -->
            <Line X1="3" Y1="1" X2="3" Y2="5" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="8" Y1="1" X2="8" Y2="5" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Calendar dots -->
            <Ellipse Width="1.5" Height="1.5" Fill="{DynamicResource EnvironmentWindowText}" Margin="2,8,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse Width="1.5" Height="1.5" Fill="{DynamicResource EnvironmentWindowText}" Margin="5,8,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse Width="1.5" Height="1.5" Fill="{DynamicResource EnvironmentWindowText}" Margin="8,8,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse Width="1.5" Height="1.5" Fill="{DynamicResource EnvironmentWindowText}" Margin="2,11,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse Width="1.5" Height="1.5" Fill="{DynamicResource EnvironmentWindowText}" Margin="5,11,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <!-- Clock circle -->
            <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                     Fill="{DynamicResource TextBox.Static.Background}"/>
            <!-- Clock hands -->
            <Path Data="M12.5,11 V13 L14,14" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- LEGACY ICON SUPPORT (from GenericResources.xaml)                            -->
    <!-- These icons are kept for backward compatibility                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Swap Axes Icon -->
    <Viewbox x:Key="SwapAxesIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Canvas Width="16" Height="16">
            <Path StrokeThickness="1" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 M 1.5 1 V 15" />
            <Path StrokeThickness="1" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 M 1 14.5 H 15" />
            <Path StrokeThickness="1.5" Stroke="{DynamicResource EnvironmentWindowText}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F1 M 4 5.5 9.5 11"/>
            <Path StrokeThickness="1.5" Stroke="{DynamicResource EnvironmentWindowText}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F1 M 7.5 4 13 9.5"/>
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="F1 M 11.5 12 9 9.5 6 12 Z"/>
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="F1 M 5.5 3 8 5.5 11 3 Z"/>
        </Canvas>
    </Viewbox>

    <!-- Zoom In Icon -->
    <Viewbox x:Key="ZoomInIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Canvas Width="64" Height="64">
            <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="43" Height="43" StrokeThickness="5" Stroke="{DynamicResource EnvironmentWindowText}"/>
            <Path StrokeThickness="5" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 M 25 14.5000 V 35.5" />
            <Path StrokeThickness="5" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 M 35.5 25 H 14.5" />
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="F1 M 52 52 33 44.9 44.9 33 Z" />
            <Path StrokeThickness="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F0 m 41.5 41.5 18 18" />
        </Canvas>
    </Viewbox>

    <!-- Inspect Icon (Magnifying glass with question mark) -->
    <Viewbox x:Key="InspectIcon" Width="16" Height="16" x:Shared="False"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Canvas Width="16" Height="16">
            <Ellipse Canvas.Left="0.7" Canvas.Top="0.7" Width="11.3" Height="11.3" StrokeThickness="1.3" Stroke="{DynamicResource EnvironmentWindowText}"/>
            <Path Fill="{DynamicResource EnvironmentWindowText}" StrokeThickness="0.26">
                <Path.Data>
                    <PathGeometry Figures="M 13.382561 13.382561 8.3969001 11.519499 11.519499 8.3969001 Z" FillRule="NonZero"/>
                </Path.Data>
            </Path>
            <Path StrokeThickness="1.84" Stroke="{DynamicResource EnvironmentWindowText}">
                <Path.Data>
                    <PathGeometry Figures="m 10.627327 10.627327 4.723258 4.723258" FillRule="EvenOdd"/>
                </Path.Data>
            </Path>
