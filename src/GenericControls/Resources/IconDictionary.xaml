            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Delete/Close Icon - Red X (VS-style) -->
    <Viewbox x:Key="DeleteIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Rectangle Width="16" Height="16">
            <Rectangle.Fill>
                <DrawingBrush>
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <DrawingGroup.Children>
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
