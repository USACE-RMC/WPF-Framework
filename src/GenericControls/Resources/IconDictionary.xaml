<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔═══════════════════════════════════════════════════════════════════════════════╗
    ║  GenericControls Icon Dictionary                                              ║
    ╠═══════════════════════════════════════════════════════════════════════════════╣
    ║  A centralized collection of theme-aware vector icons for use throughout      ║
    ║  the WPF Framework. Icons are defined as Viewbox elements containing          ║
    ║  Path/Shape elements with DynamicResource bindings for theme support.         ║
    ║                                                                               ║
    ║  THEME SUPPORT:                                                               ║
    ║  Icons use DynamicResource bindings for colors that adapt to themes:          ║
    ║  • EnvironmentWindowText      - Main icon stroke/fill (adapts to light/dark)  ║
    ║  • TextBox.Static.Background  - Background fill for document icons            ║
    ║  • DataGrid.Header.Border     - Header elements                               ║
    ║  • ToolbarIconAccent          - Accent color for emphasis                     ║
    ║  • ToolbarIconForeground      - Secondary foreground color                    ║
    ║                                                                               ║
    ║  SEMANTIC COLORS (consistent across themes):                                  ║
    ║  • #16A34A (Green)  - Add/Plus/Create operations                              ║
    ║  • #DC2626 (Red)    - Delete/Remove/Stop operations                           ║
    ║  • Accent (Blue)    - Insert/Selection/Filter operations                      ║
    ║                                                                               ║
    ║  USAGE:                                                                       ║
    ║  <ContentControl Content="{StaticResource AddRowIcon}"/>                      ║
    ║                                                                               ║
    ║  For buttons with explicit sizing:                                            ║
    ║  <Button>                                                                     ║
    ║      <Viewbox Width="16" Height="16">                                         ║
    ║          <ContentControl Content="{StaticResource AddRowIcon}"/>              ║
    ║      </Viewbox>                                                               ║
    ║  </Button>                                                                    ║
    ║                                                                               ║
    ║  NOTE: All icons use x:Shared="False" to allow multiple instances.            ║
    ╚═══════════════════════════════════════════════════════════════════════════════╝
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- ROW OPERATIONS                                                              -->
    <!-- Icons for adding, inserting, and deleting table rows                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Add Row(s) - Row lines with green plus sign -->
    <Viewbox x:Key="AddRowIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Path Data="M0,3 H10 M0,7 H10 M0,11 H10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Path Data="M12,4 V12 M8,8 H16"
                  Stroke="#16A34A" StrokeThickness="2"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Insert Row(s) - Row lines with blue arrow pointing up -->
    <Viewbox x:Key="InsertRowIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Path Data="M0,3 H10 M0,7 H10 M0,11 H10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Path Data="M12,12 V4 M9,7 L12,4 L15,7"
                  Stroke="{DynamicResource ToolbarIconAccent}" StrokeThickness="2" StrokeLineJoin="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Delete Row(s) - Row lines with red X -->
    <Viewbox x:Key="DeleteRowIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Path Data="M0,3 H10 M0,7 H10 M0,11 H10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Path Data="M9,5 L15,11 M15,5 L9,11"
                  Stroke="#DC2626" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COLUMN OPERATIONS                                                           -->
    <!-- Icons for adding, inserting, and deleting table columns                     -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Add Column(s) - Column lines with green plus sign -->
    <Viewbox x:Key="AddColumnIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Path Data="M3,0 V10 M7,0 V10 M11,0 V10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,0,0,0"/>
            <Path Data="M8,8 V16 M4,12 H12"
                  Stroke="#16A34A" StrokeThickness="2"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Insert Column(s) - Column lines with blue arrow pointing left -->
    <Viewbox x:Key="InsertColumnIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Path Data="M3,0 V10 M7,0 V10 M11,0 V10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,0,0,0"/>
            <Path Data="M4,12 H12 M7,9 L4,12 L7,15"
                  Stroke="{DynamicResource ToolbarIconAccent}" StrokeThickness="2" StrokeLineJoin="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Delete Column(s) - Column lines with red X -->
    <Viewbox x:Key="DeleteColumnIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Path Data="M3,0 V10 M7,0 V10 M11,0 V10"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,0,0,0"/>
            <Path Data="M5,9 L11,15 M11,9 L5,15"
                  Stroke="#DC2626" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CLIPBOARD OPERATIONS                                                        -->
    <!-- Icons for copy, paste, and selection operations                             -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Select All - Grid with selection highlight -->
    <Viewbox x:Key="SelectAllIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Path Data="M1,1 H15 V15 H1 Z M1,5 H15 M1,10 H15 M5,1 V15 M10,1 V15"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Rectangle Width="14" Height="14" Fill="{DynamicResource ToolbarIconAccent}" Opacity="0.3"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Viewbox>

    <!-- Copy - Two overlapping documents -->
    <Viewbox x:Key="CopyIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Path Data="M5,1 H14 V12 H5 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource TextBox.Static.Background}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Path Data="M2,4 H11 V15 H2 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource TextBox.Static.Background}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Path Data="M4,7 H9 M4,10 H9 M4,13 H7"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Copy with Headers - Two documents with header bar -->
    <Viewbox x:Key="CopyWithHeadersIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Path Data="M5,1 H14 V12 H5 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource TextBox.Static.Background}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Path Data="M2,4 H11 V15 H2 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource TextBox.Static.Background}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="8" Height="2" Fill="{DynamicResource ToolbarIconAccent}"
                       Margin="3,5,0,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Path Data="M4,10 H9 M4,13 H7"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- Paste - Clipboard with document -->
    <Viewbox x:Key="PasteIcon" Width="16" Height="16" x:Shared="False" RenderOptions.EdgeMode="Aliased">
        <Grid Width="16" Height="16">
            <Path Data="M3,3 H13 V15 H3 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource TextBox.Static.Background}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Path Data="M6,1 H10 V4 H6 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  Fill="{DynamicResource DataGrid.Header.Border}"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Rectangle Width="2" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       Margin="7,0,0,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Path Data="M5,7 H11 M5,10 H11 M5,13 H9"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- SORT ICONS                                                                  -->
    <!-- Triangle indicators for ascending/descending sort direction                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Sort Up (Ascending) - Filled triangle pointing up -->
    <Viewbox x:Key="SortUpIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M8,2 L14,14 H2 Z"
                  Fill="{DynamicResource EnvironmentWindowText}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Viewbox>

    <!-- Sort Down (Descending) - Filled triangle pointing down -->
    <Viewbox x:Key="SortDownIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M8,14 L14,2 H2 Z"
                  Fill="{DynamicResource EnvironmentWindowText}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
