<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:GenericControls">

    <!--
    GenericControls Theme Resource Dictionary

    This dictionary contains theme-aware styles for GenericControls that use
    DynamicResource bindings to respond to runtime theme changes.

    All colors are referenced from the Themes library using DynamicResource
    so they automatically update when the theme is changed.
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COMMON STYLES                                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Separator Background (transparent) -->
    <SolidColorBrush x:Key="SeparatorBackground">#00FFFFFF</SolidColorBrush>

    <!-- Dot Leader Line Style for property controls -->
    <Style TargetType="{x:Type Line}" x:Key="DotLeaderLineStyle">
        <Setter Property="Grid.Column" Value="1"/>
        <Setter Property="X1" Value="0"/>
        <Setter Property="Y1" Value="0"/>
        <Setter Property="X2" Value="1"/>
        <Setter Property="Y2" Value="0"/>
        <Setter Property="Stroke" Value="{DynamicResource Button.Static.Border}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="StrokeDashArray" Value="2 2"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
    </Style>

    <!-- Title Text Style -->
    <Style TargetType="{x:Type TextBlock}" x:Key="TitleTextStyle">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- DATAGRID TOOLBAR                                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="DataGridToolbarStyle" TargetType="{x:Type local:DataGridToolbar}">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="{x:Type local:DataGridToolbar}" BasedOn="{StaticResource DataGridToolbarStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- SEPARATOR WITH HEADER                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="SeparatorWithHeaderStyle" TargetType="{x:Type local:SeparatorWithHeader}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>

    <Style TargetType="{x:Type local:SeparatorWithHeader}" BasedOn="{StaticResource SeparatorWithHeaderStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- NUMERIC TEXTBOX                                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NumericTextBoxStyle" TargetType="{x:Type local:NumericTextBox}">
        <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBox.Static.Foreground}"/>
    </Style>

    <Style TargetType="{x:Type local:NumericTextBox}" BasedOn="{StaticResource NumericTextBoxStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- NUMERIC TEXTBOX 2                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NumericTextBox2Style" TargetType="{x:Type local:NumericTextBox2}">
        <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBox.Static.Foreground}"/>
    </Style>

    <Style TargetType="{x:Type local:NumericTextBox2}" BasedOn="{StaticResource NumericTextBox2Style}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- NAME TEXTBOX                                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NameTextBoxStyle" TargetType="{x:Type local:NameTextBox}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>

    <Style TargetType="{x:Type local:NameTextBox}" BasedOn="{StaticResource NameTextBoxStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- NUMERIC UP DOWN                                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NumericUpDownStyle" TargetType="{x:Type local:NumericUpDown}">
        <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBox.Static.Foreground}"/>
    </Style>

    <Style TargetType="{x:Type local:NumericUpDown}" BasedOn="{StaticResource NumericUpDownStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- NUMERIC SLIDER                                                               -->
