    <!-- COPY PASTE DATAGRID                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- DataGrid Row Style for CopyPasteDataGrid -->
    <Style x:Key="CopyPasteDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Foreground}"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Alternating.Background}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.MouseOver.Background}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Selection.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Selection.Foreground}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Selection.Inactive.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Selection.Inactive.Foreground}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid Cell Style for CopyPasteDataGrid -->
    <Style x:Key="CopyPasteDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <!-- Cell selection highlighting for extended selection mode -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Selection.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Selection.Foreground}"/>
            </Trigger>
            <!-- Inactive selection (when DataGrid loses focus) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Selection.Inactive.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Selection.Inactive.Foreground}"/>
            </MultiTrigger>
            <!-- Focus border for keyboard navigation -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Cell.Focus.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CopyPasteDataGridStyle" TargetType="{x:Type local:CopyPasteDataGrid}">
        <Setter Property="Background" Value="{DynamicResource DataGrid.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Static.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Static.Foreground}"/>
        <Setter Property="RowBackground" Value="{DynamicResource DataGrid.Row.Background}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGrid.Row.Alternating.Background}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGrid.GridLines}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DataGrid.GridLines}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="RowHeight" Value="22"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="RowStyle" Value="{StaticResource CopyPasteDataGridRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource CopyPasteDataGridCellStyle}"/>
        <Setter Property="ColumnHeaderStyle" Value="{DynamicResource ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderStyle" Value="{DynamicResource RowHeaderStyle}"/>
    </Style>

    <Style TargetType="{x:Type local:CopyPasteDataGrid}" BasedOn="{StaticResource CopyPasteDataGridStyle}"/>

