    </Style>
    <Style TargetType="{x:Type local:LineStyleSelectorControl}" BasedOn="{StaticResource LineStyleSelectorControlStyle}"/>

    <!-- Line Width Selector Control -->
    <Style x:Key="LineWidthSelectorControlStyle" TargetType="{x:Type local:LineWidthSelectorControl}">
