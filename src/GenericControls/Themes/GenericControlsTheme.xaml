        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>
    <Style TargetType="{x:Type local:FontSelectorControl}" BasedOn="{StaticResource FontSelectorControlStyle}"/>

    <!-- Font Weight Selector Control -->
    <Style x:Key="FontWeightSelectorControlStyle" TargetType="{x:Type local:FontWeightSelectorControl}">
