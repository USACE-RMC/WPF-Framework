    <Style x:Key="Point3DPropertyControlStyle" TargetType="{x:Type local:Point3DPropertyControl}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>
    <Style TargetType="{x:Type local:Point3DPropertyControl}" BasedOn="{StaticResource Point3DPropertyControlStyle}"/>

    <!-- String List Property Control -->
    <Style x:Key="StringListPropertyControlStyle" TargetType="{x:Type local:StringListPropertyControl}">
