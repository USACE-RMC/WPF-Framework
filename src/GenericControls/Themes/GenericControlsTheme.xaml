    </Style>
    <Style TargetType="{x:Type local:LineWidthSelectorControl}" BasedOn="{StaticResource LineWidthSelectorControlStyle}"/>

    <!-- Horizontal Alignment Control -->
    <Style x:Key="HorizontalAlignmentControlStyle" TargetType="{x:Type local:HorizontalAlignmentControl}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>
    <Style TargetType="{x:Type local:HorizontalAlignmentControl}" BasedOn="{StaticResource HorizontalAlignmentControlStyle}"/>

    <!-- Vertical Alignment Control -->
    <Style x:Key="VerticalAlignmentControlStyle" TargetType="{x:Type local:VerticalAlignmentControl}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>
    <Style TargetType="{x:Type local:VerticalAlignmentControl}" BasedOn="{StaticResource VerticalAlignmentControlStyle}"/>

    <!-- Content Property Control -->
    <Style x:Key="ContentPropertyControlStyle" TargetType="{x:Type local:ContentPropertyControl}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>
    <Style TargetType="{x:Type local:ContentPropertyControl}" BasedOn="{StaticResource ContentPropertyControlStyle}"/>

    <!-- Point Property Control -->
    <Style x:Key="PointPropertyControlStyle" TargetType="{x:Type local:PointPropertyControl}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>
    <Style TargetType="{x:Type local:PointPropertyControl}" BasedOn="{StaticResource PointPropertyControlStyle}"/>

