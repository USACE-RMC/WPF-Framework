        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>
    <Style TargetType="{x:Type local:NumericSliderPropertyControl}" BasedOn="{StaticResource NumericSliderPropertyControlStyle}"/>

    <!-- Numeric Property Selector Control -->
    <Style x:Key="NumericPropertySelectorControlStyle" TargetType="{x:Type local:NumericPropertySelectorControl}">
