    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- NAME DIALOG                                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NameDialogStyle" TargetType="{x:Type local:NameDialog}">
        <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>

    <Style TargetType="{x:Type local:NameDialog}" BasedOn="{StaticResource NameDialogStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- PROPERTY CONTROLS                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Base Property Control Style -->
    <Style x:Key="PropertyControlBaseStyle" TargetType="{x:Type UserControl}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>

    <!-- Text Property Control -->
    <Style x:Key="TextPropertyControlStyle" TargetType="{x:Type local:TextPropertyControl}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>
    <Style TargetType="{x:Type local:TextPropertyControl}" BasedOn="{StaticResource TextPropertyControlStyle}"/>

    <!-- Name Text Property Control -->
    <Style x:Key="NameTextPropertyControlStyle" TargetType="{x:Type local:NameTextPropertyControl}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>
    <Style TargetType="{x:Type local:NameTextPropertyControl}" BasedOn="{StaticResource NameTextPropertyControlStyle}"/>

    <!-- Resizeable Text Property Control -->
    <Style x:Key="ResizeableTextPropertyControlStyle" TargetType="{x:Type local:ResizeableTextPropertyControl}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>
    <Style TargetType="{x:Type local:ResizeableTextPropertyControl}" BasedOn="{StaticResource ResizeableTextPropertyControlStyle}"/>

