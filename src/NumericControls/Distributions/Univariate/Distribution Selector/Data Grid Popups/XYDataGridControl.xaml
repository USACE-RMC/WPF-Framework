<UserControl x:Class="NumericControls.XYDataGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="200" Height="400" Background="White">
    <UserControl.Resources>
        <Style x:Key="ParameterValueCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="White"></Setter>
            <Setter Property="TextBlock.TextAlignment"  Value="Right"></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>

        <!--Add Data Grid-->
        <cntrls:CopyPasteDataGrid x:Name="XYDataTable" 
                                    HeadersVisibility="All" CanUserResizeColumns="False" HorizontalGridLinesBrush="#FF353B7A" 
                                    VerticalGridLinesBrush="#FF353B7A" AutoGenerateColumns="False" SelectionMode="Extended" 
                                    SelectionUnit="Cell" Margin="2,4,2,2" CanUserDeleteRows="True" CanUserAddRows="True" 
                                    CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" 
                                    Background="Transparent" VerticalContentAlignment="Center" CanUserAddInsertDeleteRows="True" PasteAddsRows="True">

            <cntrls:CopyPasteDataGrid.Columns>
                <DataGridTextColumn x:Name="XColumn" Header="X Values"  IsReadOnly="False" Width="100" 
                                    Binding="{Binding Path=X}" CellStyle="{StaticResource ParameterValueCellStyle}"/>
                <DataGridTextColumn x:Name="YColumn" Header="Y Values" IsReadOnly="False" Width="100" 
                                    Binding="{Binding Path=Y}" CellStyle="{StaticResource ParameterValueCellStyle}"/>
            </cntrls:CopyPasteDataGrid.Columns>

        </cntrls:CopyPasteDataGrid>

        <!--<cntrls:DataGridPlus x:Name="XYDataGridPlus"/>-->

    </Grid>
</UserControl>
