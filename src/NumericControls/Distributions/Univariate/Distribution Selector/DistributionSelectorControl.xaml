<UserControl x:Class="NumericControls.Distributions.Univariate.DistributionSelectorControl" x:Name="DistributionSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="382" d:DesignWidth="300" MinWidth="200">
    <UserControl.Resources>
        <cntrls:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
        <cntrls:BooleanToTextConverter x:Key="BoolToYAxisTextConverter" TrueValue="Density" FalseValue=""/>
        <cntrls:BooleanToTextConverter x:Key="BoolToXAxisTextConverter" TrueValue="X Value" FalseValue=""/>
        <cntrls:BooleanToDoubleConverter x:Key="BoolToLabelDoubleConverter" TrueValue="{x:Static sys:Double.NaN}" FalseValue="5"/>
        <cntrls:BooleanToDoubleConverter x:Key="BoolToTitleDoubleConverter" TrueValue="{x:Static sys:Double.NaN}" FalseValue="8"/>
        <cntrls:BooleanToColorConverter x:Key="BoolToColorConverter" TrueValue="Black" FalseValue="Transparent"/>
        <SolidColorBrush x:Key="ReadOnlyBackGround" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
        <Style x:Key="ReadOnlyTextBackgroundCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{StaticResource ReadOnlyBackGround}"></Setter>
            <Setter Property="TextBlock.TextAlignment"  Value="Left"></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadOnlyValueBackgroundCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{StaticResource ReadOnlyBackGround}"></Setter>
            <Setter Property="TextBlock.TextAlignment"  Value="Right"></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ParameterValueCellStyle" TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment"  Value="Right"></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <DataTrigger Binding="{Binding Path=IsValid, UpdateSourceTrigger=PropertyChanged}" Value="False">
                    <Setter Property="Background" Value="#FFF7B6AF"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="ToolTip" Value="{Binding Path=ErrorMessage}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=IsValid, UpdateSourceTrigger=PropertyChanged}" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{Binding ElementName=DistributionSelector, Path=BackgroundColor, TargetNullValue=Transparent, FallbackValue=Transparent}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--0 Probability Distribution Label-->
            <RowDefinition Height="Auto"/>
            <!--1 Probability Distribution Combobox-->
            <RowDefinition Height="Auto"/>
            <!--2 Parameter Grid-->
            <RowDefinition Height="Auto"/>
            <!--3 Plot Expander-->
            <RowDefinition Height="*"/>
            <!--5 Summary Stats Expander-->
        </Grid.RowDefinitions>

        <!--Probability Distribution Label-->
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="0 2" >
            <TextBlock Text="Select Distribution for " VerticalAlignment="Center" Foreground="{DynamicResource EnvironmentWindowText}"/>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource EnvironmentWindowText}"
                       Text="{Binding ElementName=DistributionSelector, Path=DistributionTitle, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text=":" VerticalAlignment="Center" Foreground="{DynamicResource EnvironmentWindowText}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0 2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--Probability Distribution Combobox-->
            <ComboBox x:Name="DistributionCombobox" Grid.Column="0" 
                  ItemsSource="{Binding ElementName=DistributionSelector, Path=Distributions, UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="DisplayName"
                  SelectionChanged="DistributionCombobox_SelectionChanged"/>

            <Button 
                x:Name="EstimateParametersButton" 
                Grid.Column="1" 
                Width="22"
                Height="22"
                Margin="4,0,0,0"
                Visibility="Collapsed" 
                ToolTip="Click to estimate parameters for the selected distribution based on the sample data."
                Click="EstimateParametersButton_Click">
                <Image Source="/NumericControls;component/Resources/Run.png" Width="16" Height="16"/>
            </Button>
        </Grid>


        <!--Parameter Grid-->
        <Grid Name="SelectorControlGrid" Grid.Row="2" Margin="0 2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <cntrls:CopyPasteDataGrid x:Name="ParametersTable" 
                                      HeadersVisibility="None" 
                                      Grid.Column="0"
                                      VerticalContentAlignment="Center" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      Width="{Binding ElementName=SelectorControlGrid, Path=ActualWidth}"
                                      HorizontalGridLinesBrush="{DynamicResource DataGrid.GridLines}"
                                      VerticalGridLinesBrush="{DynamicResource DataGrid.GridLines}"
                                      Background="Transparent"
                                      AutoGenerateColumns="False" 
                                      SelectionMode="Extended" 
                                      SelectionUnit="Cell" 
                                      BorderBrush="Black" 
                                      BorderThickness="1,1,0,0"
                                      CanUserDeleteRows="False" 
                                      CanUserAddRows="False" 
                                      CanUserResizeRows="False" 
                                      CanUserResizeColumns="False" 
                                      CanUserSortColumns="False" 
                                      CanUserReorderColumns="False" 
                                      CanUserAddInsertDeleteRows="False" 
                                      PasteAddsRows="False">
                <cntrls:CopyPasteDataGrid.Columns>
                    <DataGridTextColumn x:Name="NameColumn" IsReadOnly="True" Width="140" Binding="{Binding Path=DisplayName}" 
                                        CellStyle="{StaticResource ReadOnlyTextBackgroundCellStyle}"/>
                    <DataGridTextColumn x:Name="ValueColumn" IsReadOnly="False" Width="*" Binding="{Binding Path=Value, StringFormat={}{0:0.####}}" 
                                        CellStyle="{StaticResource ParameterValueCellStyle}"/>
                </cntrls:CopyPasteDataGrid.Columns>
            </cntrls:CopyPasteDataGrid>

        </Grid>


        <!--Plot Expander-->
        <Expander x:Name="PlotExpander" Header="Probability Density Plot" Grid.Row="3" IsExpanded="True" VerticalAlignment="Top" Padding="0"
                  Visibility="{Binding ElementName=DistributionSelector, Path=ShowPlot, Converter={StaticResource BoolToVisConverter}}" 
                  Style="{DynamicResource PropertyExpanderStyle}">
            <Grid Background="{DynamicResource PlotWindowBackground}">
                <oxy:Plot x:Name="Plot" Margin="2,2,0,0" Height="250" PlotAreaBackground="White" IsHitTestVisible="False" Padding="0" Background="Transparent" >
                    <oxy:Plot.Axes>
                        <oxy:LinearAxis x:Name="Yaxis" 
                                    MaximumPadding="0.1" 
                                    MinimumPadding="0.0"    
                                    AbsoluteMinimum="0" 
                                    Position="Left" 
                                    Title="{Binding ElementName=DistributionSelector, Path=ShowAxisTitle, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource BoolToYAxisTextConverter}}"  
                                    AxisTitleDistance="10"
                                    IsAxisVisible="{Binding ElementName=DistributionSelector, Path=ShowAxis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" 
                                    TitleFontSize="{Binding ElementName=DistributionSelector, Path=ShowAxisTitle, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource BoolToTitleDoubleConverter}}"
                                    TitleColor="{Binding ElementName=DistributionSelector, Path=ShowAxisTitle, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}"
                                    TextColor="{Binding ElementName=DistributionSelector, Path=ShowAxisLabel, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}"
                                    FontSize="{Binding ElementName=DistributionSelector, Path=ShowAxisLabel, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource BoolToLabelDoubleConverter}}"/>
                        <oxy:LinearAxis x:Name="Xaxis" 
                                    MaximumPadding="0.0" 
                                    MinimumPadding="0.0" 
                                    Position="Bottom" 
                                    Title="{Binding ElementName=DistributionSelector, Path=ShowAxisTitle, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource BoolToXAxisTextConverter}}" 
                                    AxisTitleDistance="10"
                                    PositionAtZeroCrossing="True"
                                    IsAxisVisible="{Binding ElementName=DistributionSelector, Path=ShowAxis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" 
                                    TitleFontSize="{Binding ElementName=DistributionSelector, Path=ShowAxisTitle, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource BoolToTitleDoubleConverter}}"
                                    TitleColor="{Binding ElementName=DistributionSelector, Path=ShowAxisTitle, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}"
                                    TextColor="{Binding ElementName=DistributionSelector, Path=ShowAxisLabel, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}"
                                    FontSize="{Binding ElementName=DistributionSelector, Path=ShowAxisLabel, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, Converter={StaticResource BoolToLabelDoubleConverter}}"/>
                    </oxy:Plot.Axes>
                    <oxy:Plot.Series>
                        <oxy:AreaSeries x:Name="PDF" Color="DarkBlue" Fill="#FF3F8BD6"></oxy:AreaSeries>
                    </oxy:Plot.Series>
                </oxy:Plot>

                <TextBlock Name="InvalidDistributionTextBlock" Visibility="Collapsed" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Expander>

        <!--Summary Statistics Expander-->
        <Expander x:Name="SummaryStatisticstExpander" Grid.Row="4" IsExpanded="False" VerticalAlignment="Top" Header="Statistics"
                  Visibility="{Binding ElementName=DistributionSelector, Path=ShowStatistics, Converter={StaticResource BoolToVisConverter}}"
                  Style="{DynamicResource PropertyExpanderStyle}">
            <Grid Name="SummaryStatsGrid">
                <cntrls:CopyPasteDataGrid x:Name="SummaryTable"
                                          Width="{Binding ElementName=SummaryStatsGrid, Path=ActualWidth}"
                                          HeadersVisibility="Column"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Extended"
                                          SelectionUnit="Cell"
                                          Margin="0,4,0,2"
                                          CanUserDeleteRows="False"
                                          CanUserAddRows="False"
                                          CanUserResizeRows="False"
                                          CanUserResizeColumns="False"
                                          CanUserSortColumns="False"
                                          CanUserReorderColumns="False"
                                          IsReadOnly="True">
                    <cntrls:CopyPasteDataGrid.Columns>
                        <DataGridTextColumn x:Name="StatNameColumn" Header="Statistic" IsReadOnly="True" Width="140"
                                            Binding="{Binding Path=StatName}"
                                            HeaderStyle="{DynamicResource LeftAlignedColumnHeaderStyle}"/>
                        <DataGridTextColumn x:Name="DistStatsColumn" Header="Distribution" IsReadOnly="True" Width="*"
                                            Binding="{Binding Path=DistStat}"
                                            HeaderStyle="{DynamicResource RightAlignedColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="DataStatsColumn" Header="Data" IsReadOnly="True" Width="*" Visibility="Collapsed"
                                            Binding="{Binding Path=DataStat}"
                                            HeaderStyle="{DynamicResource RightAlignedColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </cntrls:CopyPasteDataGrid.Columns>
                </cntrls:CopyPasteDataGrid>
            </Grid>
        </Expander>

    </Grid>
</UserControl>
