<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    NumericControls Vector Icon Dictionary

    Modern, clean vector icons using Path elements with strokes.
    Matches the style of GenericControls icons for visual consistency.

    Color Palette:
    - #16A34A (Green): Add/Plus operations
    - #DC2626 (Red): Subtract/Remove operations
    - #F97316 (Orange): Multiply operations
    - #8B5CF6 (Purple): Divide operations
    - #2563EB (Blue): Exponent/Power operations
    - #0891B2 (Cyan): Log operations
    - #14B8A6 (Teal): Invert operations
    - #F59E0B (Amber): Replace operations
    - #EC4899 (Pink): Interpolate operations

    Usage:
    <ContentControl Content="{StaticResource CalculatorPlusIcon}" Width="16" Height="16"/>
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CALCULATOR BASE ICON                                                         -->
    <!-- Simple calculator outline                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="CalculatorIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <!-- Calculator body -->
            <Rectangle Width="12" Height="14" RadiusX="1" RadiusY="1"
                       Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5"
                       Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <!-- Display -->
            <Rectangle Width="8" Height="2" Fill="{DynamicResource EnvironmentWindowText}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
            <!-- Buttons -->
            <Path Data="M5,7 H7 M9,7 H11 M5,9.5 H7 M9,9.5 H11 M5,12 H7 M9,12 H11"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="CalculatorIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="2,1,12,14" RadiusX="1" RadiusY="1"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource EnvironmentWindowText}" Thickness="1.5"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource EnvironmentWindowText}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="4,3,8,2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5,7 H7 M9,7 H11 M5,9.5 H7 M9,9.5 H11 M5,12 H7 M9,12 H11"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource EnvironmentWindowText}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- ADD / PLUS ICON                                                              -->
    <!-- Green plus sign for addition                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="CalculatorPlusIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M8,3 V13 M3,8 H13"
                  Stroke="#16A34A" StrokeThickness="2.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="CalculatorPlusIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M8,3 V13 M3,8 H13"/>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="#16A34A" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- SUBTRACT / MINUS ICON                                                        -->
    <!-- Red minus sign for subtraction                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="CalculatorMinusIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M3,8 H13"
                  Stroke="#DC2626" StrokeThickness="2.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="CalculatorMinusIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M3,8 V8.01 M3,8 H13"/>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="#DC2626" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- MULTIPLY ICON                                                                -->
    <!-- Orange X for multiplication                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="CalculatorMultiplyIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M4,4 L12,12 M12,4 L4,12"
                  Stroke="#F97316" StrokeThickness="2.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="CalculatorMultiplyIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M4,4 L12,12 M12,4 L4,12"/>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="#F97316" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- DIVIDE ICON                                                                  -->
    <!-- Purple division symbol (obelus)                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="CalculatorDivideIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <!-- Horizontal line -->
            <Path Data="M3,8 H13"
                  Stroke="#8B5CF6" StrokeThickness="2.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Top dot -->
            <Ellipse Width="3" Height="3" Fill="#8B5CF6"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
            <!-- Bottom dot -->
            <Ellipse Width="3" Height="3" Fill="#8B5CF6"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="CalculatorDivideIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,8 H13"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#8B5CF6" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#8B5CF6">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,4" RadiusX="1.5" RadiusY="1.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#8B5CF6">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,12" RadiusX="1.5" RadiusY="1.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- LOGARITHM ICON                                                               -->
    <!-- Cyan log curve symbol                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="CalculatorLogIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <!-- Log curve -->
            <Path Data="M2,13 Q4,13 5,10 T9,4 Q11,2 14,2"
                  Stroke="#0891B2" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Fill="Transparent"/>
            <!-- Base indicator dot -->
            <Ellipse Width="3" Height="3" Fill="#0891B2"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="CalculatorLogIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,13 Q4,13 5,10 T9,4 Q11,2 14,2"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#0891B2" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0891B2">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="2.5,13.5" RadiusX="1.5" RadiusY="1.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- EXPONENT / POWER ICON                                                        -->
    <!-- Blue x with superscript n                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="CalculatorExpIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <!-- Base 'x' -->
            <Path Data="M2,6 L8,13 M8,6 L2,13"
                  Stroke="#2563EB" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- Superscript 'n' -->
            <Path Data="M10,2 V6 M10,3 Q10,2 11.5,2 T13,3 V6"
                  Stroke="#2563EB" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="CalculatorExpIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,6 L8,13 M8,6 L2,13"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2563EB" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M10,2 V6 M10,3 Q10,2 11.5,2 T13,3 V6"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2563EB" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- INVERT ICON                                                                  -->
    <!-- Teal circular arrows (1/x or flip)                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="CalculatorInvertIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <!-- Top arrow curving right -->
            <Path Data="M4,6 A4,4 0 0 1 12,6"
                  Stroke="#14B8A6" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Fill="Transparent"/>
            <Path Data="M10,3 L12,6 L9,7"
                  Stroke="#14B8A6" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Fill="Transparent"/>
            <!-- Bottom arrow curving left -->
            <Path Data="M12,10 A4,4 0 0 1 4,10"
                  Stroke="#14B8A6" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Fill="Transparent"/>
            <Path Data="M6,13 L4,10 L7,9"
                  Stroke="#14B8A6" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Fill="Transparent"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="CalculatorInvertIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,6 A4,4 0 0 1 12,6"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#14B8A6" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M10,3 L12,6 L9,7"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#14B8A6" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M12,10 A4,4 0 0 1 4,10"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#14B8A6" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M6,13 L4,10 L7,9"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#14B8A6" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- REPLACE ICON                                                                 -->
    <!-- Amber bidirectional horizontal arrows                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="CalculatorReplaceIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <!-- Right arrow -->
            <Path Data="M2,5 H12 M9,2 L12,5 L9,8"
                  Stroke="#F59E0B" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>
            <!-- Left arrow -->
            <Path Data="M14,11 H4 M7,8 L4,11 L7,14"
                  Stroke="#F59E0B" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="CalculatorReplaceIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,5 H12 M9,2 L12,5 L9,8"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F59E0B" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M14,11 H4 M7,8 L4,11 L7,14"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F59E0B" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- INTERPOLATE ICON                                                             -->
    <!-- Pink curve with endpoint dots                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="CalculatorInterpolateIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <!-- Interpolation curve -->
            <Path Data="M2,12 Q5,12 8,8 T14,4"
                  Stroke="#EC4899" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Fill="Transparent"/>
            <!-- Start point -->
            <Ellipse Width="4" Height="4" Fill="#EC4899"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
            <!-- End point -->
            <Ellipse Width="4" Height="4" Fill="#EC4899"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="CalculatorInterpolateIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,12 Q5,12 8,8 T14,4"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#EC4899" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#EC4899">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="2,12" RadiusX="2" RadiusY="2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#EC4899">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="14,4" RadiusX="2" RadiusY="2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- EDIT / PENCIL ICON                                                           -->
    <!-- Clean pencil icon for editing                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="EditIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <!-- Pencil body -->
            <Path Data="M2,14 L3,10 L12,1 L15,4 L6,13 Z"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5"
                  StrokeLineJoin="Round" Fill="#F59E0B"/>
            <!-- Pencil tip -->
            <Path Data="M2,14 L3,10 L6,13 Z"
                  Fill="{DynamicResource EnvironmentWindowText}"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="EditIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F59E0B">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,14 L3,10 L12,1 L15,4 L6,13 Z"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource EnvironmentWindowText}" Thickness="1" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource EnvironmentWindowText}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,14 L3,10 L6,13 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- RUN / PLAY ICON                                                              -->
    <!-- Green play triangle for execute actions                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Viewbox x:Key="RunIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M4,2 L14,8 L4,14 Z"
                  Fill="#16A34A" Stroke="#15803D" StrokeThickness="1"
                  StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>
    <DrawingBrush x:Key="RunIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#16A34A">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M4,2 L14,8 L4,14 Z"/>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="#15803D" Thickness="1" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
