<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    NumericControls Vector Icon Dictionary

    Professional vector icons that adapt to Light, Blue, and Dark themes.
    Icons use DynamicResource bindings to theme colors for automatic updates.

    Usage:
    <ContentControl Content="{DynamicResource CalculatorIcon}" Width="16" Height="16"/>
    or
    <Rectangle Width="16" Height="16" Fill="{DynamicResource CalculatorIconBrush}"/>
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CALCULATOR BASE ICON                                                         -->
    <!-- A simple calculator with display and button grid                             -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <DrawingBrush x:Key="CalculatorIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Calculator body -->
                <GeometryDrawing Brush="{DynamicResource Button.Static.Background}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="1,1,14,14" RadiusX="1" RadiusY="1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource Button.Static.Border}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="1,1,14,14" RadiusX="1" RadiusY="1"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource Button.Static.Border}" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Display -->
                <GeometryDrawing Brush="{DynamicResource AccentBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3,3,10,3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Button grid -->
                <GeometryDrawing Brush="{DynamicResource EnvironmentWindowText}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="3,8,2,2"/>
                            <RectangleGeometry Rect="7,8,2,2"/>
                            <RectangleGeometry Rect="11,8,2,2"/>
                            <RectangleGeometry Rect="3,12,2,2"/>
                            <RectangleGeometry Rect="7,12,2,2"/>
                            <RectangleGeometry Rect="11,12,2,2"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

