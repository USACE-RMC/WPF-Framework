    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CALCULATOR LOG ICON                                                          -->
    <!-- "log" text icon                                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <DrawingBrush x:Key="CalculatorLogIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Background -->
                <GeometryDrawing Brush="{DynamicResource Button.Static.Background}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" RadiusX="2" RadiusY="2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" RadiusX="2" RadiusY="2"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource Button.Static.Border}" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- "log" text using paths -->
                <GeometryDrawing Brush="{DynamicResource AccentBrush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <!-- l -->
                            <RectangleGeometry Rect="2,3,1.5,10"/>
                            <!-- o -->
                            <PathGeometry Figures="M5,7 L8,7 L8,13 L5,13 Z M6,8.5 L7,8.5 L7,11.5 L6,11.5 Z"/>
                            <!-- g -->
                            <PathGeometry Figures="M9.5,7 L13,7 L13,14 L9.5,14 L9.5,12.5 L11.5,12.5 L11.5,13 L9.5,13 Z M10.5,8.5 L11.5,8.5 L11.5,11 L10.5,11 Z"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

