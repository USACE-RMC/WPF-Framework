    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- EDIT / PENCIL ICON                                                           -->
    <!-- Professional pencil icon for editing                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <DrawingBrush x:Key="EditIconBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Pencil body -->
                <GeometryDrawing Brush="#FFB900">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M2,11 L5,14 L14,5 L11,2 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Pencil tip -->
                <GeometryDrawing Brush="{DynamicResource EnvironmentWindowText}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M1,15 L2,11 L5,14 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Eraser -->
                <GeometryDrawing Brush="#E3008C">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M11,2 L14,5 L15,4 L12,1 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Outline -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M1,15 L2,11 L11,2 L12,1 L15,4 L14,5 L5,14 Z"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource EnvironmentWindowText}" Thickness="0.5"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

