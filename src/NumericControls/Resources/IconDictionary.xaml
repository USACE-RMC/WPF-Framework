                <GeometryDrawing Brush="#16C60C">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,1 L15,8 L3,15 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Subtle outline for visibility -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M3,1 L15,8 L3,15 Z"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#107C10" Thickness="0.5"/>
