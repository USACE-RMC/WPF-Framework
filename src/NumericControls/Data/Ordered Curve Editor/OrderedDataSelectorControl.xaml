<UserControl x:Class="NumericControls.OrderedDataSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:oxyCntrls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"></TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <EventSetter Event="Click" Handler="DataGridColumnHeader_Click"/>
        </Style>
        <Color x:Key="BorderLightColor">#FFCCCCCC</Color>
        <Color x:Key="BorderMediumColor">#FF888888</Color>
        <Color x:Key="BorderDarkColor">#FF444444</Color>
        <Color x:Key="ControlLightColor">White</Color>
        <Color x:Key="ControlMediumColor">#FF7381F9</Color>
        <Color x:Key="ControlDarkColor">#FF211AA9</Color>
    </Control.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}">
        <Grid.Resources>
            <cntrls:BooleanToVisibilityConverter x:Key="VisibilityConverter" TrueValue="Collapsed" FalseValue="Visible"></cntrls:BooleanToVisibilityConverter>
            <cntrls:ReverseBooleanConverter x:Key="RevBoolConverter"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding TableWidth}" MinWidth="197"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,2,0">
            <cntrls:ValidationDataGrid Name="ValidationGrid"
                                       AutoGenerateColumns="True" 
                                       CanUserResizeColumns="False" 
                                       Background="Transparent"
                                       BorderBrush="#FF688CAF" BorderThickness="1"
                                       HorizontalGridLinesBrush="#FF353B7A" VerticalGridLinesBrush="#FF353B7A"
                                       SelectionMode="Extended" SelectionUnit="CellOrRowHeader" 
                                       CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False" 
                                       CanUserReorderColumns="False" 
                                       CanUserAddInsertDeleteRows="True"
                                       AlternatingRowBackground="#FFF3F9F7" AlternationCount="2" 
                                       RowHeight="24" 
                                       VerticalContentAlignment="Center"
                                       IsReadOnly="{Binding Path=IsReadOnly}" 
                                       ColumnHeaderStyle="{StaticResource WrappedColumnHeaderStyle}"
                                       PreviewAddRows="ValidationGrid_PreviewAddRows"
                                       RowsAdded="ValidationGrid_RowsAdded" 
                                       RowsDeleted="ValidationGrid_RowsDeleted" 
                                       DataPasted="ValidationGrid_DataPasted"></cntrls:ValidationDataGrid>
        </Grid>

        <GridSplitter Grid.Column="1" Margin="-2,0,0,0" Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent"/>

        <oxy:Plot x:Name="Plot" Grid.Column="1" Margin="2,0,0,0" Background="Transparent" LegendBackground="#8CFFFFFF" LegendBorder="DarkGray" LegendPosition="{Binding PlotLegendPosition}" Title="{Binding PlotTitle}">
            <oxy:Plot.Axes>
                <oxy:LinearAxis Position="Left" Title="{Binding YAxisLabel}" AbsoluteMinimum="{Binding YAxisMinimum}" AbsoluteMaximum="{Binding YAxisMaximum}" AxisTitleDistance="20" TitleFontSize="20" MajorGridlineStyle="Solid" MinorGridlineStyle="Dash"/>
                <oxy:LinearAxis Position="Bottom" Title="{Binding XAxisLabel}" AbsoluteMinimum="{Binding XAxisMinimum}" AbsoluteMaximum="{Binding XAxisMaximum}" AxisTitleDistance="15" TitleFontSize="20" MajorGridlineStyle="Solid" MinorGridlineStyle="Dash"/>
            </oxy:Plot.Axes>
            <oxy:Plot.Series>
                <oxy:LineSeries Name="CurveLine" Title="Curve" Color="Black" MarkerFill="Transparent" ItemsSource="{Binding CurveLinePoints}"/>
            </oxy:Plot.Series>
        </oxy:Plot>

        <oxyCntrls:OxyPlotToolbar Background="{Binding ElementName=Plot, Path=Background}" VerticalAlignment="Stretch" Plot="{Binding ElementName=Plot, Mode=OneTime}" ToolBarOrientation="Vertical" Grid.Column="2" PropertiesCalled="OxyplotToolbar_PropertiesCalled"/>
    </Grid>
</UserControl>
