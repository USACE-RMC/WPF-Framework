<UserControl x:Class="NumericControls.BinDefinitionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Control.Resources>
        <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"></TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <EventSetter Event="Click" Handler="DataGridColumnHeader_Click"/>
        </Style>
        <Color x:Key="BorderLightColor">#FFCCCCCC</Color>
        <Color x:Key="BorderMediumColor">#FF888888</Color>
        <Color x:Key="BorderDarkColor">#FF444444</Color>
        <Color x:Key="ControlLightColor">White</Color>
        <Color x:Key="ControlMediumColor">#FF7381F9</Color>
        <Color x:Key="ControlDarkColor">#FF211AA9</Color>
    </Control.Resources>
    <Grid x:Name="BinGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <cntrls:DataGridToolbar Name="ValidationGridToolbar"
                                Grid.Row="0"
                                DataGrid="{Binding ElementName=ValidationGrid, Mode=OneTime}" 
                                ToolOrientation="Horizontal"/>

        <cntrls:ValidationDataGrid Name="ValidationGrid"
                                   Grid.Row="1"
                                   AutoGenerateColumns="True" 
                                   CanUserResizeColumns="False" 
                                   Background="Transparent"
                                   BorderBrush="#FF688CAF" BorderThickness="1"
                                   HorizontalGridLinesBrush="#FF353B7A" VerticalGridLinesBrush="#FF353B7A"
                                   SelectionMode="Extended" SelectionUnit="CellOrRowHeader" 
                                   CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False" 
                                   CanUserReorderColumns="False" 
                                   CanUserAddInsertDeleteRows="True"
                                   AlternatingRowBackground="#FFF3F9F7" AlternationCount="2" 
                                   RowHeight="24" 
                                   VerticalContentAlignment="Center"
                                   IsReadOnly="{Binding Path=IsReadOnly}" 
                                   ColumnHeaderStyle="{Binding Path=ColumnHeaderStyle}"
                                   CellStyle="{Binding Path=CellStyle}"
                                   AutoGeneratedColumns="ValidationGrid_AutoGeneratedColumns"
                                   HeadersVisibility="Column"
                                   RowsAdded="ValidationGrid_RowsAdded" 
                                   RowsDeleted="ValidationGrid_RowsDeleted"
                                   PreviewPasteData="ValidationGrid_PreviewPasteData"
                                   DataPasted="ValidationGrid_DataPasted"/>
    </Grid>
</UserControl>
