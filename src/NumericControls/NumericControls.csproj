<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>NumericControls</RootNamespace>
    <AssemblyName>NumericControls</AssemblyName>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>

    <Description>NumericControls is a WPF control library for numeric data entry, probability distributions, and statistical analysis. It provides specialized controls for ordered curves, time series, and bivariate data.</Description>
    <PackageProjectUrl>https://github.com/USACE-RMC/WPF-Framework</PackageProjectUrl>
    <RepositoryUrl>https://github.com/USACE-RMC/WPF-Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Title>NumericControls</Title>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Company>USACE-RMC</Company>
    <PackageTags>WPF; controls; numeric; statistics; distributions; data binding; desktop</PackageTags>
    <PackageId>RMC.NumericControls</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\add_column.png" />
    <None Remove="Resources\CalculatorDivide_16x.png" />
    <None Remove="Resources\CalculatorExp_16x.png" />
    <None Remove="Resources\CalculatorInterpolate_16x.png" />
    <None Remove="Resources\CalculatorInvert_16x.png" />
    <None Remove="Resources\CalculatorLog_16x.png" />
    <None Remove="Resources\CalculatorMinus_16x.png" />
    <None Remove="Resources\CalculatorMultiply_16x.png" />
    <None Remove="Resources\CalculatorPlus_16x.png" />
    <None Remove="Resources\CalculatorReplace_16x.png" />
    <None Remove="Resources\Calculator_16x.png" />
    <None Remove="Resources\delete_column.png" />
    <None Remove="Resources\EditButtonIcon.png" />
    <None Remove="Resources\insert_column.png" />
    <None Remove="Resources\Run.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\add_column.png" />
    <Resource Include="Resources\CalculatorDivide_16x.png" />
    <Resource Include="Resources\CalculatorExp_16x.png" />
    <Resource Include="Resources\CalculatorInterpolate_16x.png" />
    <Resource Include="Resources\CalculatorInvert_16x.png" />
    <Resource Include="Resources\CalculatorLog_16x.png" />
    <Resource Include="Resources\CalculatorMinus_16x.png" />
    <Resource Include="Resources\CalculatorMultiply_16x.png" />
    <Resource Include="Resources\CalculatorPlus_16x.png" />
    <Resource Include="Resources\CalculatorReplace_16x.png" />
    <Resource Include="Resources\Calculator_16x.png" />
    <Resource Include="Resources\delete_column.png" />
    <Resource Include="Resources\EditButtonIcon.png" />
    <Resource Include="Resources\insert_column.png" />
    <Resource Include="Resources\Run.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="DotNet.ReproducibleBuilds" Version="1.2.25">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GenericControls\GenericControls.csproj" />
    <ProjectReference Include="..\OxyPlotControls\OxyPlotControls.csproj" />
    <ProjectReference Include="..\Themes\Themes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Numerics">
      <HintPath>..\..\..\numerics\Numerics\bin\Debug\net9.0\Numerics.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Debug\net9.0-windows\OxyPlot.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot.Wpf">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Debug\net9.0-windows\OxyPlot.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot.Wpf.Shared">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Debug\net9.0-windows\OxyPlot.Wpf.Shared.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
