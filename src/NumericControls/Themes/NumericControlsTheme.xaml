<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:NumericControls">

    <!--
    NumericControls Theme Resource Dictionary

    This dictionary contains theme-aware styles and brushes for NumericControls that use
    DynamicResource bindings to respond to runtime theme changes.

    All colors are referenced from the Themes library using DynamicResource
    so they automatically update when the theme is changed.
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COMMON BRUSHES                                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Read-Only Cell Backgrounds -->
    <SolidColorBrush x:Key="NumericControls.ReadOnlyBackground" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

    <!-- Validation Error Background -->
    <SolidColorBrush x:Key="NumericControls.ValidationError.Background" Color="#FFF7B6AF"/>

    <!-- Alternating Row Background -->
    <SolidColorBrush x:Key="NumericControls.AlternatingRow.Background" Color="#FFF3F9F7"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- EXPANDER BRUSHES (for DistributionSelectorControl)                           -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Static State -->
    <SolidColorBrush x:Key="Expander.Static.Circle.Fill" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="Expander.Static.Circle.Stroke" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}"/>
    <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}"/>

    <!-- MouseOver State -->
    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Stroke" Color="#FF5593FF"/>
    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Fill" Color="#FFF3F9FF"/>
    <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>

    <!-- Pressed State -->
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Stroke" Color="#FF3C77DD"/>
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Fill" Color="#FFD9ECFF"/>
    <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>

    <!-- Disabled State -->
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Stroke" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"/>
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Fill" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
    <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- DATAGRID STYLES                                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Base DataGrid Style with theme-aware colors -->
    <Style x:Key="NumericControlsDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource DataGrid.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Static.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Static.Foreground}"/>
        <Setter Property="RowBackground" Value="{DynamicResource DataGrid.Row.Background}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource NumericControls.AlternatingRow.Background}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGrid.GridLines}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DataGrid.GridLines}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeight" Value="22"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Left-Aligned Column Header Style -->
    <Style x:Key="Left_ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource DataGrid.Header.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Header.Foreground}"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Bottom"
                                   FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"
                                   Foreground="{DynamicResource EnvironmentWindowText}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Right-Aligned Column Header Style -->
    <Style x:Key="Right_ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource DataGrid.Header.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Header.Foreground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid HorizontalAlignment="Right">
                        <TextBlock TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Bottom"
                                   FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"
                                   Foreground="{DynamicResource EnvironmentWindowText}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Wrapped Column Header Style -->
    <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource DataGrid.Header.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Header.Foreground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Bottom"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom"
                               FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"
                               Foreground="{DynamicResource EnvironmentWindowText}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CELL STYLES                                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Read-Only Text Cell Style -->
    <Style x:Key="ReadOnlyTextBackgroundCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="{StaticResource NumericControls.ReadOnlyBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
        <Setter Property="TextBlock.TextAlignment" Value="Left"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Read-Only Value Cell Style (Right-Aligned) -->
    <Style x:Key="ReadOnlyValueBackgroundCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="{StaticResource NumericControls.ReadOnlyBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Right-Aligned Cell Style -->
    <Style x:Key="Right_CellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="Selector.IsSelectionActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Right-Aligned Disabled Cell Style -->
    <Style x:Key="Right_CellStyleDisabled" TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="False">
                <Setter Property="Background" Value="{StaticResource NumericControls.ReadOnlyBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Parameter Value Cell Style (with validation) -->
    <Style x:Key="ParameterValueCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Path=IsValid, UpdateSourceTrigger=PropertyChanged}" Value="False">
                <Setter Property="Background" Value="{StaticResource NumericControls.ValidationError.Background}"/>
                <Setter Property="BorderBrush" Value="Red"/>
                <Setter Property="ToolTip" Value="{Binding Path=ErrorMessage}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=IsValid, UpdateSourceTrigger=PropertyChanged}" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Background}"/>
                <Setter Property="ToolTip" Value="{x:Null}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- USERCONTROL STYLES                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Base UserControl Style for NumericControls -->
    <Style x:Key="NumericControlsUserControlStyle" TargetType="{x:Type UserControl}">
        <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- BORDER STYLES                                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="BorderLightColor" Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}"/>
    <SolidColorBrush x:Key="BorderMediumColor" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}"/>
    <SolidColorBrush x:Key="BorderDarkColor" Color="{DynamicResource {x:Static SystemColors.ControlDarkDarkColorKey}}"/>

    <!-- Control accent colors -->
    <SolidColorBrush x:Key="ControlMediumColor" Color="#FF7381F9"/>
    <SolidColorBrush x:Key="ControlDarkColor" Color="#FF211AA9"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- TEXTBLOCK STYLES                                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NumericControlsTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>

    <Style x:Key="NumericControlsLabelStyle" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>

</ResourceDictionary>
