<UserControl x:Class="ExpressionParserControls.CalculatorControl" x:Name="Calculator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ExpressionParserControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Expression Editor + optional Functions panel -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FunctionsPanelColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Functions Panel (hidden by default, shown when fx is toggled) -->
            <Grid Grid.Column="0" x:Name="FunctionsPanelContainer"
                  Visibility="{Binding IsChecked, ElementName=FunctionsToggleButton, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Functions" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,3"
                           Foreground="{DynamicResource EnvironmentWindowText}"/>
                <local:AvailableFunctions x:Name="FunctionsPanel" Grid.Row="1" CompactMode="True"
                                          Margin="0,0,3,0"/>
            </Grid>

            <!-- GridSplitter between Functions and Expression -->
            <GridSplitter x:Name="FunctionsSplitter" Grid.Column="0" Width="3"
                          HorizontalAlignment="Right" VerticalAlignment="Stretch"
                          Background="{DynamicResource EnvironmentWindowBackground}"
                          Visibility="{Binding IsChecked, ElementName=FunctionsToggleButton, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Expression Editor -->
            <local:ExpressionControl Grid.Column="1" x:Name="LexTextBox" FontWeight="Normal" Text=""
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FontSize="15"
                                     ExpressionChanged="LexTextBox_ExpressionChanged"
                                     HelpDocumentCalled="LexTextBox_HelpDocumentCalled"/>
        </Grid>

        <!-- Row 1: Toolbar -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,3,0,0">
            <!-- Functions Toggle Button -->
            <ToggleButton x:Name="FunctionsToggleButton" Height="24" Width="28" Padding="0"
                          SnapsToDevicePixels="True" ToolTip="More functions"
                          Checked="FunctionsToggleButton_Checked" Unchecked="FunctionsToggleButton_Unchecked">
                <Viewbox Width="16" Height="16">
                    <Grid Width="16" Height="16">
                        <TextBlock Text="f" FontFamily="Cambria" FontSize="14" FontStyle="Italic" FontWeight="SemiBold"
                                   Foreground="{DynamicResource EnvironmentWindowText}" Margin="1,-1,0,0"/>
                        <TextBlock Text="x" FontFamily="Cambria" FontSize="10" FontStyle="Italic" FontWeight="SemiBold"
                                   Foreground="{DynamicResource EnvironmentWindowText}" Margin="6,0,0,1"
                                   VerticalAlignment="Bottom"/>
                    </Grid>
                </Viewbox>
            </ToggleButton>

            <!-- Separator -->
            <Rectangle Width="1" Margin="4,4,4,4" Fill="{DynamicResource SeparatorBorder}"/>

            <!-- Operator Buttons -->
            <Button Name="AddButton" Height="24" Width="24" Padding="0" SnapsToDevicePixels="True" ToolTip="Add (+)" Click="AddButton_Click">
                <Path Data="M 0,8 H 16 M 8,0 V 16" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2"/>
            </Button>
            <Button Name="SubtractButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Subtract (-)" Click="SubtractButton_Click">
                <Path Data="M 0,1 H 16" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2"/>
            </Button>
            <Button Name="MultiplyButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Multiply (*)" Click="MultiplyButton_Click">
                <Path Data="M 2,2 L 14,14 M 2,14 L 14,2" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2"/>
            </Button>
            <Button Name="DivideButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Divide (/)" Click="DivideButton_Click">
                <Path Data="M 0,6 H 16 M 6,11 L 10,11 M 6,1 L 10,1" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2"/>
            </Button>
            <Button Name="ExponentButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Exponentiate (^)" Click="ExponentButton_Click">
                <Path Data="M 3,8 L 9,0 M 7,0 L 13,8" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Button>
            <Button Name="LessThanButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Less than (&lt;)" Click="LessThanButton_Click">
                <Path Data="M 13,2 L 3,8 L 13,14" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Button>
            <Button Name="GreaterThanButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Greater than (&gt;)" Click="GreaterThanButton_Click">
                <Path Data="M 3,2 L 13,8 L 3,14" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Button>
            <Button Name="EqualsButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Equals (=)" Click="EqualsButton_Click">
                <Path Data="M 1,8 H 15 M 1,2 H 15" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2"/>
            </Button>

            <!-- Match Case Checkbox -->
            <CheckBox
                Content="Match Case"
                x:Name="IsCaseSensitiveCheckbox"
                Margin="8,0,0,0"
                Checked="IsCaseSensitiveCheckbox_Checked"
                Unchecked="IsCaseSensitiveCheckbox_Checked"
                VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Row 2: Function Help Expander (under toolbar) -->
        <Expander x:Name="FunctionHelpExpander" Grid.Row="2"
                  Style="{DynamicResource PropertyExpanderStyle}"
                  Visibility="Collapsed" IsExpanded="False"
                  Margin="0,3,0,0">
            <Expander.Header>
                <TextBlock x:Name="FunctionHelpHeader" Text="Function Help" FontWeight="SemiBold"
                           Foreground="{DynamicResource EnvironmentWindowText}"/>
            </Expander.Header>
            <Border BorderBrush="{DynamicResource SeparatorBorder}" BorderThickness="1"
                    Background="{DynamicResource TextBox.Static.Background}" Margin="0,3,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160" Padding="8">
                    <StackPanel x:Name="HelpDetailPanel">
                        <!-- Function Name -->
                        <TextBlock x:Name="HelpFunctionName" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource AvailableFunctions.DetailHeader}"/>

                        <!-- Syntax -->
                        <TextBlock Text="SYNTAX" FontSize="10" FontWeight="Bold" Margin="0,4,0,2"
                                   Foreground="{DynamicResource AvailableFunctions.DetailLabel}"/>
                        <Border Background="{DynamicResource EnvironmentWindowBackground}" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                            <TextBlock x:Name="HelpSyntax" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource AvailableFunctions.SyntaxText}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Returns -->
                        <TextBlock Text="RETURNS" FontSize="10" FontWeight="Bold" Margin="0,2,0,2"
                                   Foreground="{DynamicResource AvailableFunctions.DetailLabel}"/>
                        <TextBlock x:Name="HelpReturns" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Foreground="{DynamicResource EnvironmentWindowText}"/>

                        <!-- Description -->
                        <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="Bold" Margin="0,2,0,2"
                                   Foreground="{DynamicResource AvailableFunctions.DetailLabel}"/>
                        <TextBlock x:Name="HelpDescription" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Foreground="{DynamicResource EnvironmentWindowText}"/>

                        <!-- Example -->
                        <TextBlock Text="EXAMPLE" FontSize="10" FontWeight="Bold" Margin="0,2,0,2"
                                   Foreground="{DynamicResource AvailableFunctions.DetailLabel}"/>
                        <Border Background="{DynamicResource EnvironmentWindowBackground}" CornerRadius="3" Padding="6,4" Margin="0,0,0,4">
                            <TextBlock x:Name="HelpExample" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource AvailableFunctions.ExampleText}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Insert button -->
                        <Button x:Name="HelpInsertButton" Content="Insert Function" Height="24" Width="120"
                                HorizontalAlignment="Right" Margin="0,4,0,0"
                                Click="HelpInsertButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Expander>

        <!-- Row 3: Expression Errors Expander (red text, auto-opens) -->
        <Expander x:Name="ErrorsExpander" Grid.Row="3"
                  Style="{DynamicResource PropertyExpanderStyle}"
                  Visibility="Collapsed" IsExpanded="False"
                  Margin="0,3,0,0">
            <Expander.Header>
                <TextBlock x:Name="ErrorsExpanderHeader" Text="Expression Errors"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ExpressionError.Text}"/>
            </Expander.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120" Margin="0,3,0,0">
                <ItemsControl x:Name="ErrorsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                <TextBlock Text="&#x2022;" Margin="4,0,6,0" FontWeight="Bold"
                                           Foreground="{DynamicResource ExpressionError.Text}"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ExpressionError.Text}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
