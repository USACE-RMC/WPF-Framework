<UserControl x:Class="ExpressionParserControls.CalculatorControl" x:Name="Calculator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExpressionParserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Converters can be added here as needed -->
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,3,0,0">
            <Button Name="AddButton" Height="24" Width="24" Padding="0" SnapsToDevicePixels="True" ToolTip="Insert Plus Sign" Click="AddButton_Click">
                <Path Data="M 0,8 H 16 M 8,0 V 16" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2"/>
            </Button>
            <Button Name="SubtractButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Insert Minus Sign" Click="SubtractButton_Click">
                <Path Data="M 0,1 H 16" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2"/>
            </Button>
            <Button Name="MultiplyButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Insert Multiplication Sign" Click="MultiplyButton_Click">
                <Path Data="M 2,2 L 14,14 M 2,14 L 14,2" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2"/>
            </Button>
            <Button Name="DivideButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Insert Division Sign" Click="DivideButton_Click">
                <Path Data="M 0,6 H 16 M 6,11 L 10,11 M 6,1 L 10,1" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2"/>
            </Button>
            <Button Name="ExponentButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Insert Exponent Sign" Click="ExponentButton_Click">
                <Path Data="M 3,8 L 9,0 M 7,0 L 13,8" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Button>
            <Button Name="EqualsButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Insert Equals Sign" Click="EqualsButton_Click">
                <Path Data="M 1,8 H 15 M 1,2 H 15" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="2"/>
            </Button>

            <Button Name="FunctionsButton" Height="24" Width="60" Margin="3,0,0,0" ToolTip="List of available expression functions" Click="FunctionsButton_Click">Functions</Button>

        </StackPanel>
        
        <CheckBox 
            Content="Match Case" 
            x:Name="IsCaseSensitiveCheckbox"  
            Grid.Row="1"
            Margin="2"
            Checked="IsCaseSensitiveCheckbox_Checked" 
            Unchecked="IsCaseSensitiveCheckbox_Checked" 
            VerticalAlignment="Top"
            HorizontalAlignment="Right"/>
        <!--<local:ExpressionControl Grid.Row="0" x:Name="LexTextBox" FontWeight="Normal" Text="If(AND(3&lt;5, 1&lt;5, 1-1=0, 3^2=9, 3/3=1), RANDBETWEEN(-4, 96, 1), 4 - 2)" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FontSize="15" ExpressionChanged="LexTextBox_ExpressionChanged" HelpDocumentCalled="LexTextBox_HelpDocumentCalled"/>-->
        <local:ExpressionControl Grid.Row="0" x:Name="LexTextBox" FontWeight="Normal" Text="" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FontSize="15" ExpressionChanged="LexTextBox_ExpressionChanged" HelpDocumentCalled="LexTextBox_HelpDocumentCalled"/>
        <!--<local:ExpressionControl Grid.Row="0" Grid.Column="1" x:Name="LexTextBox" Text="1 * (3 - (5 - 2))" Width="500" VerticalAlignment="Center" HorizontalAlignment="Left"/>-->
    </Grid>
</UserControl>
