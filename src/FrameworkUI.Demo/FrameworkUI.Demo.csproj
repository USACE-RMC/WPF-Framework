<!-- FrameworkUI.Demo - Demo application for FrameworkUI -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>FrameworkUI.Demo</RootNamespace>
    <AssemblyName>FrameworkUI.Demo</AssemblyName>
    <Description>A demonstration application for the FrameworkUI WPF framework, showcasing project management, AvalonDock layout, theming, and standard controls.</Description>
    <Copyright>Copyright © 2026 U.S. Army Corps of Engineers</Copyright>
    <Company>U.S. Army Corps of Engineers</Company>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DatabaseControls\DatabaseControls.csproj" />
    <ProjectReference Include="..\ExpressionParserControls\ExpressionParserControls.csproj" />
    <ProjectReference Include="..\FrameworkInterfaces\FrameworkInterfaces.csproj" />
    <ProjectReference Include="..\FrameworkUI\FrameworkUI.csproj" />
    <ProjectReference Include="..\GenericControls\GenericControls.csproj" />
    <ProjectReference Include="..\NumericControls\NumericControls.csproj" />
    <ProjectReference Include="..\OxyPlotControls\OxyPlotControls.csproj" />
    <ProjectReference Include="..\Themes\Themes.csproj" />
    <ProjectReference Include="..\SoftwareUpdate\SoftwareUpdate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.png" />
  </ItemGroup>

  <!-- Debug references -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Reference Include="Numerics">
      <HintPath>..\..\..\numerics\Numerics\bin\Debug\net9.0\Numerics.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Debug\net9.0-windows\OxyPlot.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot.Wpf">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Debug\net9.0-windows\OxyPlot.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot.Wpf.Shared">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Debug\net9.0-windows\OxyPlot.Wpf.Shared.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Release references -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Reference Include="Numerics">
      <HintPath>..\..\..\numerics\Numerics\bin\Release\net9.0\Numerics.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Release\net9.0-windows\OxyPlot.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot.Wpf">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Release\net9.0-windows\OxyPlot.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot.Wpf.Shared">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Release\net9.0-windows\OxyPlot.Wpf.Shared.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Post-build: Move supporting files to libraries subfolder and clean up -->
  <Target Name="MoveToLibraries" AfterTargets="Build">
    <ItemGroup>
      <LibraryDlls Include="$(OutputPath)*.dll" Exclude="$(OutputPath)$(AssemblyName).dll" />
      <LibraryPdbs Include="$(OutputPath)*.pdb" Exclude="$(OutputPath)$(AssemblyName).pdb" />
      <LibraryXmls Include="$(OutputPath)*.xml" />
      <LibraryConfigs Include="$(OutputPath)*.dll.config" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)libraries" />
    <Move SourceFiles="@(LibraryDlls)" DestinationFolder="$(OutputPath)libraries" />
    <Move SourceFiles="@(LibraryPdbs)" DestinationFolder="$(OutputPath)libraries" />
    <Move SourceFiles="@(LibraryXmls)" DestinationFolder="$(OutputPath)libraries" />
    <Move SourceFiles="@(LibraryConfigs)" DestinationFolder="$(OutputPath)libraries" />
    <!-- Remove AvalonDock satellite assembly locale folders (not needed for English-only apps) -->
    <RemoveDir Directories="$(OutputPath)cs-CZ;$(OutputPath)de;$(OutputPath)es;$(OutputPath)fr;$(OutputPath)hu;$(OutputPath)it;$(OutputPath)ja-JP;$(OutputPath)nl-BE;$(OutputPath)pt-BR;$(OutputPath)ro;$(OutputPath)ru;$(OutputPath)sv;$(OutputPath)zh-Hans" />
  </Target>

</Project>
