<Window x:Class="MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dtview="clr-namespace:DataTableViewControl;assembly=DataTableViewControl"
    
    Title="MainWindow" Height="548" Width="829">
    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderBackground2" StartPoint="0 0" EndPoint="0 1">
                <LinearGradientBrush.GradientStops>
                    <GradientStop Offset="0.25" Color="{DynamicResource {x:Static SystemColors.ControlLightLightColorKey}}" />
                    <GradientStop Offset="1" Color="#FFEDEEF3" />
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
        <LinearGradientBrush x:Key="RowHeaderBackground" StartPoint="0 0" EndPoint="1 0">
            <LinearGradientBrush.GradientStops>
                <GradientStop Offset="0.25" Color="{DynamicResource {x:Static SystemColors.ControlLightLightColorKey}}" />
                <GradientStop Offset="1" Color="#FFEDEEF3" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
    </Window.Resources>
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="23"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Height="23" Margin="0,0,0,0" Name="ApplicationMenu" VerticalAlignment="Top">
            <MenuItem Name="FileMenu" Header="_File">
                <MenuItem Header="_Export..." Name="ExportMenuItem" Click="ExportMenuItem_Click" />
                <!--<MenuItem Header="Debug Test" Name="TestItemForDebug" Click="TestItemForDebug_Click"/>-->
            </MenuItem>
        </Menu>
        <StackPanel Margin="5,0,0,0" HorizontalAlignment="Left" Height="23" VerticalAlignment="Center" Grid.Row="1" Orientation="Horizontal">
            <Button Content="Select Database" Height="23" Margin="5,0,0,0" Name="Button1" Width="93" Click="Button1_Click"/>
            <ComboBox Height="23" Margin="5,0,0,0" Name="ComboBox1" Width="140" IsEnabled="False" SelectionChanged="ComboBox1_SelectionChanged"/>
        </StackPanel>
        <Grid Grid.Row="2" Name="ViewerContainer" Background="Transparent">
            <dtview:TableViewer 
                Name="TestViewer" 
                Margin="5"
                Editable="True" 
                RowSelectable="True"
                RowHeight="23"
                ColumnSelectable="True" 
                CellSelectable="True" 
                HasFieldCalculator="True" 
                ShowRowHeaders="True"
                AutoFitColumns="False">
                <!--ActiveCellBackground="#F2156BB0"
                ActiveCellForeground="White"
