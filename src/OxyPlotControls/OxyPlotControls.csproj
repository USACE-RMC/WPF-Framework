<!-- OxyPlotControls - Modern C# WPF Controls for OxyPlot -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>OxyPlotControls</RootNamespace>
    <AssemblyName>OxyPlotControls</AssemblyName>
  </PropertyGroup>

  <!-- GenericControls reference for net9.0 -->

  <!-- DatabaseManager reference for net9.0 -->

  <!-- Resource files -->
  <ItemGroup>
    <Resource Include="Resources\*.cur" />
    <Resource Include="Resources\*.png" />
    <Resource Include="Resources\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GenericControls\GenericControls.csproj" />
  </ItemGroup>

  <!-- XAML resource dictionaries are automatically included by the SDK -->
  <ItemGroup>
    <Reference Include="DatabaseManager">
      <HintPath>..\..\..\database-management\DatabaseManager\bin\Debug\net9.0\DatabaseManager.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Debug\net9.0-windows\OxyPlot.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot.Wpf">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Debug\net9.0-windows\OxyPlot.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="OxyPlot.Wpf.Shared">
      <HintPath>..\..\..\oxyplot\Source\OxyPlot.Wpf\bin\Debug\net9.0-windows\OxyPlot.Wpf.Shared.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
