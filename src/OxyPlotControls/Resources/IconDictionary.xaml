<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    OxyPlotControls Icon Dictionary

    This dictionary contains vector icons that are theme-aware and can be used
    throughout the OxyPlotControls library.

    Icons use DynamicResource bindings for colors that should change with themes:
    - EnvironmentWindowText: Main icon stroke/fill color (adapts to light/dark)

    Usage: Reference icons with StaticResource or DynamicResource
    Example: <ContentControl Content="{StaticResource PointerIcon}"/>
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- TOOLBAR ICONS                                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Pointer/Cursor Icon - Arrow cursor for selection/tracking -->
    <Viewbox x:Key="PointerIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M3,1 L3,13 L6,10 L9,15 L11,14 L8,9 L12,9 Z"
                  Fill="{DynamicResource EnvironmentWindowText}"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="0.5"
                  StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>

</ResourceDictionary>
