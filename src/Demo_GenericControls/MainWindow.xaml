<Window x:Class="Demo_GenericControls.MainWindow" x:Name="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Demo_GenericControls"
        xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GenericControls;Component/Resources/GenericResources.xaml"/>
                <ResourceDictionary>
                    <cntrls:DoubleToGridLengthConverter x:Key="ActualToLengthConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <!--<Style x:Key="MyDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <EventSetter Event="MouseEnter" Handler="DataGridCell_MouseEnter"/>
            <EventSetter Event="PreviewMouseUp" Handler="DataGridCell_PreviewMouseUp"/>
        </Style>-->
    </Window.Resources>
    <Grid>
        <TabControl SelectedIndex="6">
            <TabItem Header="TextBoxes">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Name" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,7" />
                    <cntrls:NameTextBox Grid.Column="1" Grid.Row="0" Text="" Margin="5" Grid.ColumnSpan="2" CanBeBlank="True"/>

                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Number" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,143"/>
                    <cntrls:NumericTextBox Margin="5" Grid.Row="1" Grid.Column="1" MinValue="-32" MaxValue="215" CanBeBlank="True" CanBeNegative="True" Text="0" Grid.ColumnSpan="2"/>

                    <TextBlock Grid.Column="0" Grid.Row="2" Text="Number" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <cntrls:NumericUpDown Grid.Column="1" Grid.Row="2" Margin="5" HorizontalAlignment="Left" Width="100" Minimum="1000" DecimalPlaces="3" Maximum="100000000" Increment="1" ThousandsSeperator="True" Value="1000000"/>

                    <cntrls:SeparatorWithHeader Header="This is a separator with a header" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="separator"/>

                    <TextBlock Grid.Column="0" Grid.Row="4" Text="Resizable" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <cntrls:ResizableTextBoxControl Margin="5" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"/>

                    <TextBlock Grid.Column="0" Grid.Row="5" Text="Grid Length" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <cntrls:GridLengthControl Grid.Column="1" Grid.Row="5" Margin="5,0,0,0" GridLength="{Binding ElementName=MainWindow, Path=TestGridLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                </Grid>
            </TabItem>
            <TabItem Header="clock controls">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <cntrls:ClockControl HorizontalAlignment="Center" VerticalAlignment="Center" HasSeconds="True" Is24Hour="False" Time="2017/08/07 08:35:23 PM"></cntrls:ClockControl>
                    <cntrls:DateAndTimeTextBoxControl Grid.Column="1" Margin="5" Is24Hour="True" SelectedDateTime="2017/08/07 08:35:23 PM"/>
                </Grid>
            </TabItem>
            <TabItem Header="Data Grid">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <cntrls:DataGridToolbar DataGrid="{Binding ElementName=CPDataGrid, Mode=OneTime}" Grid.Row="0" ToolOrientation="Horizontal"/>
                        <cntrls:CopyPasteDataGrid x:Name="CPDataGrid" Grid.Row="1" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Extended" SelectionUnit="CellOrRowHeader" CanUserAddInsertDeleteRows="True" AutoGeneratedColumns="CPDataGrid_AutoGeneratedColumns">

                        </cntrls:CopyPasteDataGrid>
                    </Grid>

                    <ToggleButton Name="DataGridToggleButton" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">Pop Up</ToggleButton>
                    <Popup Name="DataGridPopup" Grid.Column="1" IsOpen="{Binding ElementName=DataGridToggleButton, Path=IsChecked, Mode=TwoWay}" StaysOpen="False" 
                           AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=DataGridToggleButton}" Width="200" Height="300">
                        <cntrls:CopyPasteDataGrid x:Name="CPDataGrid2" SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                                                  MouseEnter="CPDataGrid2_MouseEnter" 
                                                  MouseLeave="CPDataGrid2_MouseLeave" 
                                                  ContextMenuClosing="CPDataGrid2_ContextMenuClosing">
                        </cntrls:CopyPasteDataGrid>
                    </Popup>

                </Grid>
            </TabItem>
            <TabItem Header="Properties">
                <ScrollViewer Name="Viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid Width="{Binding ElementName=Viewer, Path=ViewportWidth}" MinWidth="150">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0">
                            <cntrls:TextPropertyControl Margin="0 2" MaxPropertyWidth="200" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" DockPanel.Dock="Top" Title="Text Property" Text="{Binding TextProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            <cntrls:NameTextPropertyControl Margin="0 2" MaxPropertyWidth="200" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" DockPanel.Dock="Top" Title="Name Property" Text="{Binding TextProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            <cntrls:ResizeableTextPropertyControl Margin="0 2" MaxPropertyWidth="200" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" DockPanel.Dock="Top" Title="Long Text Property" Text="This is a test of the resizable text property control. It is designed for properties such as descriptions which can get quite lengthy."/>
                            <cntrls:FontSelectorControl Margin="0 2" MaxPropertyWidth="200" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" DockPanel.Dock="Top" Title="Font Property" FontFamilyString="{Binding Path=FontProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, TargetNullValue='Segoe UI'}"/>
                            <cntrls:FontWeightSelectorControl Margin="0 2" MaxPropertyWidth="200" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" DockPanel.Dock="Top" Title="Font Weight Property" SelectedFontWeight="{Binding Path=TestFontWeightProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                            <cntrls:BooleanPropertyControl Margin="0 2" DockPanel.Dock="Top" Title="Boolean Property" IsSelected="{Binding ElementName=MainWindow, Path=BooleanProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            <cntrls:NumericPropertySelectorControl Margin="0 2" MaxPropertyWidth="50" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" DockPanel.Dock="Top" Title="Numeric Selector Property" NumericOptions="{StaticResource LineWidthOptions}" SelectedNumber="{Binding ElementName=MainWindow, Path=NumericSelectorProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            <cntrls:NumericPropertyControl Margin="0 2" MaxPropertyWidth="200" DockPanel.Dock="Top" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" Title="Numeric Property" CanHaveNegative="True" MinValue="-5" MaxValue="23"  Number="{Binding ElementName=MainWindow, Path=NumericProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            <cntrls:NumericSliderPropertyControl Margin="0 2" MaxPropertyWidth="200" TextPropertyWidth="30" DockPanel.Dock="Top" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" Title="Numeric Slider Property" CanHaveNegative="True" MinValue="-5" MaxValue="23" Increment=".5" Number="{Binding ElementName=MainWindow, Path=NumericProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            <cntrls:NumericAutoPropertyControl Name="AutoPropControl" Margin="0 2" MaxPropertyWidth="200" DockPanel.Dock="Top" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" Title="Numeric w/Default Property" CanHaveNegative="True" Number="{Binding ElementName=MainWindow, Path=NumericProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" DefaultNumber="{x:Static sys:Double.NaN}"/>
                            <cntrls:ColorPropertyControl Margin="0 2" DockPanel.Dock="Top" Title="Color Property" SelectedColor="{Binding ElementName=MainWindow, Path=ColorProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            <cntrls:LineStyleSelectorControl Margin="0 2" MaxPropertyWidth="200" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" DockPanel.Dock="Top" Title="Line Style Property" SelectedDashArray="{Binding ElementName=MainWindow, Path=LineStyleProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            <cntrls:LineWidthSelectorControl Margin="0 2" DockPanel.Dock="Top" MaxPropertyWidth="200" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" Title="Line Width Property" WidthOptions="{StaticResource LineWidthOptions}" SelectedWidth="{Binding Path=LineWidthProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            <cntrls:ContentPropertyControl Margin="0 2" DockPanel.Dock="Top" MaxPropertyWidth="200" PropertyWidth="{Binding ElementName=HorizontalControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" Title="Generic Content Property">
                                <cntrls:ContentPropertyControl.InnerContent>
                                    <Slider/>
                                </cntrls:ContentPropertyControl.InnerContent>
                            </cntrls:ContentPropertyControl>


                            <cntrls:HorizontalAlignmentControl x:Name="HorizontalControl" Margin="0 2" MaxPropertyWidth="200" DockPanel.Dock="Top" Title="Horizontal Alignment This is long" Alignment="{Binding Path=TestHorizontalAlignmentProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" PreviewMouseLeftButtonDown="HorizontalControl_PreviewMouseLeftButtonDown"/>

                            <!--<cntrls:CalendarWeekRulePropertyControl Margin="0 2" DockPanel.Dock="Top" Title="Calendar Week" SelectedCalendarWeekRule="{Binding ElementName=MainWindow, Path=CalendarWeekProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>-->

                        </DockPanel>

                        <Rectangle
                            Grid.Row="1" 
                            Margin="5"
                                StrokeDashArray="{Binding ElementName=MainWindow, Path=LineStyleProperty, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                StrokeThickness="{Binding ElementName=MainWindow, Path=LineWidthProperty, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                HorizontalAlignment="{Binding ElementName=MainWindow, Path=TestHorizontalAlignmentProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Stroke="{Binding ElementName=MainWindow, Path=ColorProperty, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>

                        <TextBox 
                            x:Name="TestTextBox"
                            Grid.Row="1" 
                            Margin="5"
                                BorderBrush="Transparent"
                             HorizontalAlignment="{Binding ElementName=MainWindow, Path=TestHorizontalAlignmentProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             IsEnabled="{Binding ElementName=MainWindow, Path=BooleanProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             Text="{Binding ElementName=MainWindow, Path=TextProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             FontFamily="{Binding ElementName=MainWindow, Path=FontProperty, UpdateSourceTrigger=PropertyChanged, TargetNullValue='Segoi UI'}"
                             FontWeight="{Binding ElementName=MainWindow, Path=TestFontWeightProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             />

                        <!--<Button Name="TestAutoButton" Grid.Row="2" Margin="5" Click="TestAutoButton_Click">Change Default</Button>-->
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Properties 2">
                <Grid>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="ControlGrid" SizeChanged="ControlGrid_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Name="HeaderColumn" Width="200" MinWidth="150"/>
                            <ColumnDefinition Name="PropertyWidthColumn" Width="*" MinWidth="20"/>
                        </Grid.ColumnDefinitions>

                        <GridSplitter Grid.Column="0" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="3"/>

                        <TextBlock MinWidth="10" Name="HackTextblock" Visibility="Hidden" Grid.Column="1"/>

                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Grid.ColumnSpan="2" Grid.Row="0">

                            <cntrls:TextPropertyControl Margin="0 2" DockPanel.Dock="Top" Title="Text Property" 
                                                        Text="{Binding TextProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        PropertyWidth="{Binding ElementName=HackTextblock, Path=ActualWidth, Converter={StaticResource ActualToLengthConverter}}" Style="{DynamicResource TextPropertyControlStyle1}"/>

                            <cntrls:ResizeableTextPropertyControl Margin="0 2" DockPanel.Dock="Top" Title="Long Text Property" 
                                                                  Text="This is a test of the resizable text property control. It is designed for properties such as descriptions which can get quite lengthy."
                                                                  PropertyWidth="{Binding ElementName=HackTextblock, Path=ActualWidth, Converter={StaticResource ActualToLengthConverter}}"/>

                            <cntrls:FontSelectorControl Margin="0 2" DockPanel.Dock="Top" Title="Font Property" 
                                                        FontFamilyString="{Binding Path=FontProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        PropertyWidth="{Binding ElementName=HackTextblock, Path=ActualWidth, Converter={StaticResource ActualToLengthConverter}}"/>

                            <cntrls:FontWeightSelectorControl Margin="0 2" DockPanel.Dock="Top" Title="Font Weight Property" 
                                                              SelectedFontWeight="{Binding Path=TestFontWeightProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              PropertyWidth="{Binding ElementName=HackTextblock, Path=ActualWidth, Converter={StaticResource ActualToLengthConverter}}"/>

                            <cntrls:BooleanPropertyControl Margin="0 2" DockPanel.Dock="Top" Title="Boolean Property" 
                                                           IsSelected="{Binding ElementName=MainWindow, Path=BooleanProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                            <cntrls:NumericPropertySelectorControl Margin="0 2" DockPanel.Dock="Top" Title="Numeric Selector Property" 
                                                                   NumericOptions="{StaticResource LineWidthOptions}" 
                                                                   SelectedNumber="{Binding ElementName=MainWindow, Path=NumericSelectorProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                   PropertyWidth="{Binding ElementName=HackTextblock, Path=ActualWidth, Converter={StaticResource ActualToLengthConverter}}"/>

                            <cntrls:NumericPropertyControl Margin="0 2" DockPanel.Dock="Top" Title="Numeric Property" CanHaveNegative="True" 
                                                           Number="{Binding ElementName=MainWindow, Path=NumericProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                           PropertyWidth="{Binding ElementName=HackTextblock, Path=ActualWidth, Converter={StaticResource ActualToLengthConverter}}"/>

                            <cntrls:ColorPropertyControl Margin="0 2" DockPanel.Dock="Top" Title="Color Property" 
                                                         SelectedColor="{Binding ElementName=MainWindow, Path=ColorProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                            <cntrls:LineStyleSelectorControl Margin="0 2" DockPanel.Dock="Top" Title="Line Style Property" 
                                                             SelectedDashArray="{Binding ElementName=MainWindow, Path=LineStyleProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                             PropertyWidth="{Binding ElementName=HackTextblock, Path=ActualWidth, Converter={StaticResource ActualToLengthConverter}}"/>

                            <cntrls:LineWidthSelectorControl Margin="0 2" DockPanel.Dock="Top" Title="Line Width Property" 
                                                             WidthOptions="{StaticResource LineWidthOptions}" 
                                                             SelectedWidth="{Binding Path=LineWidthProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                             PropertyWidth="{Binding ElementName=HackTextblock, Path=ActualWidth, Converter={StaticResource ActualToLengthConverter}}"/>

                            <cntrls:HorizontalAlignmentControl Margin="0 2" DockPanel.Dock="Top" Title="Horizontal Alignment" 
                                                               Alignment="{Binding Path=TestHorizontalAlignmentProperty, ElementName=MainWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                               PropertyWidth="{Binding ElementName=HackTextblock, Path=ActualWidth, Converter={StaticResource ActualToLengthConverter}}"/>
                        </DockPanel>

                    </Grid>

                </Grid>

            </TabItem>
            <TabItem Header="Progress Reporter Examples">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Name="ProgressExample1Textblock" Text="..." TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <ProgressBar Grid.Row="1" Name="ProgressExample1ProgressBar" Height="18" VerticalAlignment="Center" HorizontalAlignment="Stretch" Minimum="0" Maximum="1"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center" >
                            <Button Name="ProgressExample1Button" Width="80" Content="Run Simple" Click="ProgressExample1Button_Click"/>
                            <Button Name="ProgressExample1CancelButton" IsEnabled="False" Width="80" Margin="5,0,0,0" Content="Cancel" Click="ProgressExample1CancelButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Name="ProgressExample2Textblock" Text="..." TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <ProgressBar Grid.Row="1" Name="ProgressExample2ProgressBar" Height="18" VerticalAlignment="Center" HorizontalAlignment="Stretch" Minimum="0" Maximum="1"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center" >
                            <Button Name="ProgressExample2Button" Width="80" Content="Run Complex" Click="ProgressExample2Button_Click"/>
                            <Button Name="ProgressExample2CancelButton" IsEnabled="False" Width="80" Margin="5,0,0,0" Content="Cancel" Click="ProgressExample2CancelButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Colors">
                <DockPanel>
                    <cntrls:ColorPickerPopup Width="38" Height="24" DockPanel.Dock="Top" Color="{Binding ElementName=MainWindow, Path=ColorProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                    <cntrls:ColorPropertyControl Margin="0 2" DockPanel.Dock="Top" Title="Color Property" 
                                                         SelectedColor="{Binding ElementName=MainWindow, Path=ColorProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                    <ItemsControl x:Name="ColorItemsControl" DockPanel.Dock="Top" Margin="4" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="ItemGrid" Margin="0 2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}" Grid.Column="0" Height="22" HorizontalAlignment="Stretch" />

                                    <Rectangle 
                                        Grid.Column="1"
                                        VerticalAlignment="Stretch" 
                                        HorizontalAlignment="Stretch"
                                        MouseLeftButtonUp="ColorRectangle_MouseLeftButtonUp">
                                        <Rectangle.Resources>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="True">
                                                        <Setter Property="Fill" Value="{Binding ColorTest, UpdateSourceTrigger=PropertyChanged, TargetNullValue=Transparent}"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsEnabled" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <MultiTrigger.Setters>
                                                            <Setter Property="Stroke" Value="LightGray"/>
                                                            <Setter Property="StrokeThickness" Value="2"/>
                                                        </MultiTrigger.Setters>
                                                    </MultiTrigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="False"/>
                                                            <Condition Property="IsEnabled" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <MultiTrigger.Setters>
                                                            <Setter Property="Stroke" Value="Black"/>
                                                            <Setter Property="StrokeThickness" Value="1"/>
                                                        </MultiTrigger.Setters>
                                                    </MultiTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Resources>
                                    </Rectangle>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
