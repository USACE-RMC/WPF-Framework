<UserControl x:Class="DataGridToolbar" x:Name="DataGridToolsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="../Resources/GenericResources.xaml"/>
    </UserControl.Resources>
    <StackPanel Name="ToolbarStackPanel" Orientation="{Binding ElementName=DataGridToolsControl, Path=ToolOrientation, TargetNullValue=Horizontal, FallbackValue=Horizontal}" Background="{Binding ElementName=DataGridToolsControl, Path=BackgroundColor}">
        <!--Add-->
        <Button x:Name="AddRowsButton" ToolTip="Add row(s) to the bottom of the table" Height="24" Width="24" Cursor="Hand" Click="AddRowsButton_Click">
            <Image Margin="1" Source="pack://application:,,,/GenericControls;component/Resources/add_row.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>
        <!--Insert-->
        <Button x:Name="InsertRowsButton" ToolTip="Insert row(s) above selected cell(s) in table" Height="24" Width="24" Cursor="Hand" Click="InsertRowsButton_Click">
            <Image Margin="1" Source="pack://application:,,,/GenericControls;component/Resources/insert_row.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>
        <!--Delete-->
        <Button x:Name="DeleteRowsButton" ToolTip="Delete row(s) from the table" Height="24" Width="24" Cursor="Hand" Click="DeleteRowsButton_Click">
            <Image Margin="1" Source="pack://application:,,,/GenericControls;component/Resources/delete_row.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>

        <!--Separator-->
        <Separator x:Name="CustomOptionsSeparator" Visibility="Collapsed"/>
        <!--Custom Buttons-->


        <!--Separator-->
        <Separator x:Name="EditSelectSeparator" />
        <!--Select/Copy/Paste-->
        <Button x:Name="SelectAllButton" ToolTip="Select all cells" Height="24" Width="24" Cursor="Hand" Click="SelectAllButton_Click">
            <Image Margin="1" Source="pack://application:,,,/GenericControls;component/Resources/select_all.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>

        <Button x:Name="CopyButton" ToolTip="Copy selected cells" Height="24" Width="24" Cursor="Hand" Click="CopyButton_Click">
            <Image Margin="1" Source="pack://application:,,,/GenericControls;component/Resources/copy.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>

        <Button x:Name="CopyWithHeadersButton" ToolTip="Copy selected cells with table headers" Height="24" Width="24" Cursor="Hand" Click="CopyWithHeadersButton_Click">
            <Image Margin="1" Source="pack://application:,,,/GenericControls;component/Resources/copy_w_headers.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>

        <Button x:Name="PasteButton" ToolTip="Paste from the clipboard into the table" Height="24" Width="24" Cursor="Hand" Click="PasteButton_Click">
            <Image Margin="1" Source="pack://application:,,,/GenericControls;component/Resources/paste.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>

    </StackPanel>
</UserControl>
