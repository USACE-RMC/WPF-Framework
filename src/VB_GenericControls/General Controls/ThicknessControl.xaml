<UserControl x:Class="ThicknessControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="110">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <EventSetter Event="PreviewTextInput" Handler="TextBox_PreviewTextInput"/>
            <EventSetter Event="PreviewKeyDown" Handler="TextBox_PreviewKeyDown"/>
            <EventSetter Event="TextChanged" Handler="TextBox_TextChanged"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBox x:Name="LeftThicknessTextBox" Grid.Row="1" Grid.Column="0" Text="{Binding ElementName=ControlThickness, Path=SelectedThickness.Left, Mode=TwoWay}"/>
        <TextBox x:Name="TopThicknessTextBox" Grid.Row="0" Grid.Column="1" Text="{Binding ElementName=ControlThickness, Path=SelectedThickness.Top, Mode=TwoWay}"/>
        <TextBox x:Name="RightThicknessTextBox" Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=ControlThickness, Path=SelectedThickness.Right, Mode=TwoWay}"/>
        <TextBox x:Name="BottomThicknessTextBox" Grid.Row="2" Grid.Column="1" Text="{Binding ElementName=ControlThickness, Path=SelectedThickness.Bottom, Mode=TwoWay}"/>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" Width="{Binding ElementName=LeftThicknessTextBox, Path=ActualHeight}" Height="{Binding ElementName=LeftThicknessTextBox, Path=ActualHeight}" BorderThickness="{Binding ElementName=ControlThickness, Path=SelectedThickness, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}">
            <Grid>
                <Line Grid.Column="1" X1="0" Y1="0" X2="1" Y2="0" Stroke="DarkGray" StrokeThickness="1" VerticalAlignment="Center" StrokeDashArray="2 2" Stretch="Uniform" Margin="0"></Line>
                <Line Grid.Column="1" X1="0" Y1="0" X2="0" Y2="1" Stroke="DarkGray" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" StrokeDashArray="2 2" Stretch="Uniform" Margin="0"></Line>
            </Grid>
        </Border>
    </Grid>
</UserControl>
