<UserControl x:Class="Demo_ProjectUI.UI.UndoDemoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Demo_ProjectUI.UI"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Undo/Redo Demo" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Element Properties -->
        <GroupBox Grid.Row="1" Header="Element Properties (edit to create undo history)" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameTextBox" Margin="0,2" TextChanged="Property_Changed"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Custom Value:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="CustomValueTextBox" Margin="0,2" TextChanged="Property_Changed"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Numeric Value:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="NumericValueTextBox" Margin="0,2" TextChanged="NumericProperty_Changed"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Boolean Value:" VerticalAlignment="Center" Margin="0,2"/>
                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="BooleanValueCheckBox" Margin="0,2" Click="BooleanProperty_Changed"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Date Value:" VerticalAlignment="Center" Margin="0,2"/>
                <DatePicker Grid.Row="4" Grid.Column="1" x:Name="DateValuePicker" Margin="0,2" SelectedDateChanged="DateProperty_Changed"/>
            </Grid>
        </GroupBox>

        <!-- Undo/Redo Status -->
        <GroupBox Grid.Row="2" Header="Undo/Redo Stack Status">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Undo Stack" Margin="0,0,5,0">
                    <ListBox x:Name="UndoStackListBox" Height="150"/>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Redo Stack" Margin="5,0,0,0">
                    <ListBox x:Name="RedoStackListBox" Height="150"/>
                </GroupBox>
            </Grid>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="UndoButton" Content="Undo (Ctrl+Z)" Width="100" Margin="5" Click="UndoButton_Click"/>
            <Button x:Name="RedoButton" Content="Redo (Ctrl+Y)" Width="100" Margin="5" Click="RedoButton_Click"/>
            <Button x:Name="BatchUpdateButton" Content="Batch Update" Width="100" Margin="5" Click="BatchUpdateButton_Click"/>
            <Button x:Name="ClearHistoryButton" Content="Clear History" Width="100" Margin="5" Click="ClearHistoryButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
