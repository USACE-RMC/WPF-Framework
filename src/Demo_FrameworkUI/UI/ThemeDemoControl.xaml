<UserControl x:Class="FrameworkUI.Demo.UI.ThemeDemoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FrameworkUI.Demo.UI"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Theme Demo" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Theme Selector -->
        <GroupBox Grid.Row="1" Header="Theme Selection" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock Text="Select a theme to see all controls update in real-time:" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LightThemeRadio" Content="Light Theme" GroupName="Theme"
                                 Margin="0,0,20,0" Checked="ThemeRadio_Checked" IsChecked="True"/>
                    <RadioButton x:Name="BlueThemeRadio" Content="Blue Theme" GroupName="Theme"
                                 Margin="0,0,20,0" Checked="ThemeRadio_Checked"/>
                    <RadioButton x:Name="DarkThemeRadio" Content="Dark Theme" GroupName="Theme"
                                 Checked="ThemeRadio_Checked"/>
                </StackPanel>
                <TextBlock x:Name="CurrentThemeText" Text="Current Theme: Light" Margin="0,10,0,0" FontStyle="Italic"/>
            </StackPanel>
        </GroupBox>

        <!-- Control Showcase -->
        <GroupBox Grid.Row="2" Header="Control Showcase">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">

                    <!-- Buttons -->
                    <GroupBox Header="Buttons" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <Button Content="Normal Button" Width="120" Margin="0,0,10,0"/>
                            <Button Content="Disabled" Width="120" Margin="0,0,10,0" IsEnabled="False"/>
                            <ToggleButton Content="Toggle Button" Width="120" Margin="0,0,10,0"/>
                            <Button Width="120">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0"/>
                                        <TextBlock Text="Add"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </GroupBox>

                    <!-- Text Input -->
                    <GroupBox Header="Text Input" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="TextBox:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="Sample text" Margin="5"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Disabled:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="Disabled text" Margin="5" IsEnabled="False"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Row="1" Grid.Column="1" Password="secret" Margin="5"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="ReadOnly:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="Read-only text" Margin="5" IsReadOnly="True"/>
                        </Grid>
                    </GroupBox>

                    <!-- Selection Controls -->
                    <GroupBox Header="Selection Controls" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CheckBoxes:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <CheckBox Content="Option 1" IsChecked="True" Margin="0,2"/>
                                <CheckBox Content="Option 2" Margin="0,2"/>
                                <CheckBox Content="Option 3 (Disabled)" IsEnabled="False" Margin="0,2"/>
                                <CheckBox Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" Margin="0,2"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="RadioButtons:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <RadioButton Content="Choice A" GroupName="Demo" IsChecked="True" Margin="0,2"/>
                                <RadioButton Content="Choice B" GroupName="Demo" Margin="0,2"/>
                                <RadioButton Content="Choice C" GroupName="Demo" Margin="0,2"/>
                                <RadioButton Content="Disabled" GroupName="Demo" IsEnabled="False" Margin="0,2"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ComboBox:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox Margin="0,2" SelectedIndex="0">
                                    <ComboBoxItem Content="Item 1"/>
                                    <ComboBoxItem Content="Item 2"/>
                                    <ComboBoxItem Content="Item 3"/>
                                </ComboBox>
                                <TextBlock Text="Disabled:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                <ComboBox Margin="0,2" IsEnabled="False" SelectedIndex="0">
                                    <ComboBoxItem Content="Disabled"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Sliders and Progress -->
                    <GroupBox Header="Sliders and Progress" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Slider:" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="50" Margin="5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Progress:" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="65" Height="20" Margin="5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Indeterminate:" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="2" Grid.Column="1" IsIndeterminate="True" Height="20" Margin="5"/>
                        </Grid>
                    </GroupBox>

                    <!-- Lists and Grids -->
                    <GroupBox Header="Lists and Data" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="ListBox" Margin="0,0,5,0">
                                <ListBox Height="120">
                                    <ListBoxItem Content="List Item 1"/>
                                    <ListBoxItem Content="List Item 2" IsSelected="True"/>
                                    <ListBoxItem Content="List Item 3"/>
                                    <ListBoxItem Content="List Item 4"/>
                                    <ListBoxItem Content="List Item 5"/>
                                </ListBox>
                            </GroupBox>

                            <GroupBox Grid.Column="1" Header="DataGrid" Margin="5,0,0,0">
                                <DataGrid x:Name="SampleDataGrid" Height="120" AutoGenerateColumns="False"
                                          CanUserAddRows="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="60"/>
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="50"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </GroupBox>

                    <!-- TreeView -->
                    <GroupBox Header="TreeView" Margin="0,0,0,10">
                        <TreeView Height="120" Margin="10">
                            <TreeViewItem Header="Root Node 1" IsExpanded="True">
                                <TreeViewItem Header="Child 1.1"/>
                                <TreeViewItem Header="Child 1.2" IsSelected="True">
                                    <TreeViewItem Header="Grandchild 1.2.1"/>
                                    <TreeViewItem Header="Grandchild 1.2.2"/>
                                </TreeViewItem>
                                <TreeViewItem Header="Child 1.3"/>
                            </TreeViewItem>
                            <TreeViewItem Header="Root Node 2">
                                <TreeViewItem Header="Child 2.1"/>
                            </TreeViewItem>
                        </TreeView>
                    </GroupBox>

                    <!-- TabControl -->
                    <GroupBox Header="TabControl" Margin="0,0,0,10">
                        <TabControl Height="100" Margin="10">
                            <TabItem Header="Tab 1">
                                <TextBlock Text="Content of Tab 1" Margin="10"/>
                            </TabItem>
                            <TabItem Header="Tab 2">
                                <TextBlock Text="Content of Tab 2" Margin="10"/>
                            </TabItem>
                            <TabItem Header="Tab 3" IsEnabled="False">
                                <TextBlock Text="Disabled Tab" Margin="10"/>
                            </TabItem>
                        </TabControl>
                    </GroupBox>

                    <!-- Expander -->
                    <GroupBox Header="Expander" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Expander Header="Click to expand" IsExpanded="True">
                                <TextBlock Text="This is the expanded content. The theme colors apply to the header and border."
                                           TextWrapping="Wrap" Margin="10"/>
                            </Expander>
                            <Expander Header="Another expander (collapsed)" Margin="0,5,0,0">
                                <TextBlock Text="Hidden content" Margin="10"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <!-- Menu and Toolbar -->
                    <GroupBox Header="Menu and ToolBar" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <Menu>
                                <MenuItem Header="_File">
                                    <MenuItem Header="_New"/>
                                    <MenuItem Header="_Open"/>
                                    <Separator/>
                                    <MenuItem Header="_Save"/>
                                    <MenuItem Header="Save _As..."/>
                                    <Separator/>
                                    <MenuItem Header="E_xit"/>
                                </MenuItem>
                                <MenuItem Header="_Edit">
                                    <MenuItem Header="_Undo"/>
                                    <MenuItem Header="_Redo"/>
                                    <Separator/>
                                    <MenuItem Header="Cu_t"/>
                                    <MenuItem Header="_Copy"/>
                                    <MenuItem Header="_Paste"/>
                                </MenuItem>
                                <MenuItem Header="_View">
                                    <MenuItem Header="Show _Toolbar" IsCheckable="True" IsChecked="True"/>
                                    <MenuItem Header="Show _StatusBar" IsCheckable="True" IsChecked="True"/>
                                </MenuItem>
                            </Menu>
                            <ToolBar Margin="0,5,0,0">
                                <Button Content="New" ToolTip="New File"/>
                                <Button Content="Open" ToolTip="Open File"/>
                                <Button Content="Save" ToolTip="Save File"/>
                                <Separator/>
                                <Button Content="Cut"/>
                                <Button Content="Copy"/>
                                <Button Content="Paste"/>
                            </ToolBar>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
