<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DAGControls</RootNamespace>
    <AssemblyName>DAGControls</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\AddPointCursor.cur" />
    <Resource Include="Resources\Delete.png" />
    <Resource Include="Resources\Pan_Hand_Closed.cur" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAG\DAG.csproj" />
  </ItemGroup>

</Project>
