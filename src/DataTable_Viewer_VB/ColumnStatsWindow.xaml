<Window x:Class="ColumnStatsWindow" x:Name="StatsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DataTableViewControl"
    xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
    xmlns:oxy="http://oxyplot.org/wpf"    
    xmlns:oxyCntrls="clr-namespace:OxyplotControls;assembly=OxyplotControls"
    Title="Column Statistics" Height="550" Width="1000" WindowStartupLocation="CenterOwner" Background="WhiteSmoke">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CheckBox 
            Name="SelectedOnlyCheckbox" 
            Content="Selected Rows Only" 
            Margin="5" 
            Grid.Row="0" 
            VerticalAlignment="Top" 
            HorizontalAlignment="Left" 
            IsEnabled="False"
            Checked="SelectedOnlyCheckbox_Checked" 
            Unchecked="SelectedOnlyCheckbox_Unchecked"/>

        <local:NumericColumnStats x:Name="NumericColumnViewer" Visibility="Collapsed" Grid.Row="1" Margin="5"/>
        <local:AlphabeticColumnStats x:Name="AlphabeticColumnViewer" Visibility="Collapsed" Grid.Row="1" Margin="5"/>

        
    </Grid>
</Window>
