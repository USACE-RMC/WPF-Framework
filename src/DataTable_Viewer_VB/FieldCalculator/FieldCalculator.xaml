<Window x:Class="FieldCalculator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:parser="clr-namespace:ExpressionParserControls;assembly=ExpressionParserControls"
    Title="Field Calculator" Height="400" Width="600" MinHeight="305" ResizeMode="CanResize" Icon="pack://application:,,,/DataTableViewControl;component/Resources/calculator_16x.png">
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--<QH:HelpButton Name="HelpButton" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Column="0" Height="20" Width="20" Margin="2" PathIsEmbeddedResource="True" AssemblyName="DataTableViewControl" RootNamespace="DataTableViewControl" xmlPATH="FieldCalculator.xml" ToolTip="Help on Field Calculator"/>-->

        <Grid Grid.Row="1" Name="FieldSelectionGrid" Margin="5,2,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <RadioButton Content="Update Existing Column" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom" Name="UpdateExistingRadioButton" IsChecked="True"/>
            <ComboBox Name="ExistingFieldsCombobox" Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsEnabled="{Binding ElementName=UpdateExistingRadioButton, Path=IsChecked}"/>
            <RadioButton Content="Create New Column" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="0" Name="CreateNewFieldRadioButton"/>
            <TextBox Name="NewFieldName" Grid.Column="1" Grid.Row="0" Margin="5,0,0,0" HorizontalAlignment="Stretch" IsEnabled="{Binding ElementName=CreateNewFieldRadioButton, Path=IsChecked}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="5,5,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Data Columns" Grid.Row="0" Grid.Column="0"/>
            <ListBox 
                Margin="0,0,3,0" 
                VerticalAlignment="Stretch" 
                HorizontalAlignment="Stretch" 
                x:Name="VariablesListBox" 
                Grid.Row="1" 
                Grid.Column="0" 
                ToolTip="List of available data columns. Double click to insert into expression."
                MouseDoubleClick="VariablesListBox_MouseDoubleClick" 
                SelectionChanged="VariablesListBox_SelectionChanged"/>
            <Button 
                Margin="0,3,3,0" 
                Grid.Row="2" 
                Grid.Column="0" 
                Name="InsertVariableButton" 
                IsEnabled="False" 
                Height="24"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Center" 
                ToolTip="Insert a data column into the expression."
                Click="InsertVariableButton_Click">Insert</Button>

            <GridSplitter Grid.Column="0" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="2"></GridSplitter>
            <GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="2"></GridSplitter>

            <TextBlock Text="Expression" Grid.Row="0" Grid.Column="1" Margin="3,0,0,0"/>
            <parser:CalculatorControl Margin="3,0,0,0" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Name="ExpressionCalculator" ExpressionChanged="ExpressionCalculator_ExpressionChanged"/>

        </Grid>
             
        <TextBlock Text="result" Grid.Row="3" HorizontalAlignment="Left" Margin="5" Name="resultTextBlock" VerticalAlignment="Center" TextWrapping="Wrap"/>

        <Button 
            Name="ErrorLogButton" 
            Content="Error Log" 
            IsEnabled="False" 
            Width="80" 
            Height="24"
            Grid.Row="4"
            Margin="5"
            HorizontalAlignment="Left"/>

        <StackPanel 
            Grid.Row="4" 
            HorizontalAlignment="Right" 
            VerticalAlignment="Bottom" 
            Margin="5" 
            Orientation="Horizontal">
            <CheckBox 
                Content="Apply to selected records only" 
                HorizontalAlignment="Left" 
                Name="UseSelectedRange" 
                IsEnabled="False" 
                VerticalAlignment="Bottom"/>
            <Button Content="Execute" Margin="5,0,0,0" Name="ExecuteButton" IsEnabled="False" IsDefault="True" Width="80" Height="24"/>   
        </StackPanel>


        <!--<Expander Grid.Column="1" Grid.Row="1" Grid.RowSpan="5" IsExpanded="False" x:Name="HelpExpander" Expanded="HelpExpander_Expanded" ExpandDirection="Right" Header="Help">
            <WebBrowser x:Name="HelpBrowser" MinWidth="300" HorizontalAlignment="Stretch"/>
        </Expander>-->
        

    </Grid>
</Window>
