<UserControl x:Class="TableViewer2" Name="TableViewerControl2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DataTableViewControl"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600" 
             d:DataContext="{d:DesignInstance {x:Type local:TableViewer2}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/TableViewerResources.xaml"/>
                <ResourceDictionary>
                    <cntrls:BooleanToVisibilityConverter x:Key="BooleanToCollapsed" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid DataContext="{Binding ElementName=TableViewerControl2}" PreviewKeyDown="Grid_PreviewKeyDown" KeyDown="Grid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!--Toolbar tray is made public to allow developer to add custom tools-->
        <ToolBarTray x:Name="TableToolbarTray" x:FieldModifier="public" Grid.Row="0" Margin="0" Background="Transparent">
            <ToolBar Name="ExportCopyToolbar" Background="Transparent" ToolTip="Export and Copy Tools" ToolTipService.ShowOnDisabled="True" Margin="0" Padding="0" VerticalAlignment="Stretch" IsEnabled="True">
                <!--Select/Copy/Paste-->
                <Button x:Name="SelectAllButton" ToolTip="Select All Cells" Height="24" Width="24" Cursor="Hand" Click="SelectAllButton_Click">
                    <Image>
                        <Image.Style>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Stretch" Value="Uniform"/>
                                <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
                                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                                <Setter Property="Margin" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AllCellsSelected, ElementName=TableViewerControl2}" Value="True">
                                        <Setter Property="Source" Value="/DataTableViewControl;component/Resources/deselect_all_cells_16x.png"/>
                                        <Setter Property="ToolTip" Value="Deselect all cells"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AllCellsSelected, ElementName=TableViewerControl2}" Value="False">
                                        <Setter Property="Source" Value="/GenericControls;component/Resources/select_all.png"/>
                                        <Setter Property="ToolTip" Value="Select all cells"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Button>

                <Button x:Name="CopyButton" ToolTip="Copy Selected Cells" ToolTipService.ShowOnDisabled="True" Height="24" Width="24" Cursor="Hand" Click="CopyButton_Click">
                    <Image Margin="1" Source="pack://application:,,,/GenericControls;component/Resources/copy.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>

                <Button x:Name="CopyWithHeadersButton" ToolTip="Copy Selected Cells with Table Headers" ToolTipService.ShowOnDisabled="True" Height="24" Width="24" Cursor="Hand" Click="CopyWithHeadersButton_Click">
                    <Image Margin="1" Source="pack://application:,,,/GenericControls;component/Resources/copy_w_headers.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>

                <Button x:Name="PasteButton" ToolTip="Paste from the Clipboard into the Table" Height="24" Width="24" Cursor="Hand" Click="PasteButton_Click">
                    <Image Margin="1" Source="pack://application:,,,/GenericControls;component/Resources/paste.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>

                <Button Name="ExportTableButton" ToolTip="Export Table" ToolTipService.ShowOnDisabled="True" Click="ExportTableButton_Click" Margin="0" Padding="0" VerticalAlignment="Center" Height="24" Width="24">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <ContentControl Padding="0" Content="{StaticResource ExportTableIcon}" />
                    </Viewbox>
                </Button>

            </ToolBar>
            <ToolBar Name="SelectionToolbar" Background="Transparent" ToolTip="Selection Tools" ToolTipService.ShowOnDisabled="True" Margin="0" Padding="0" VerticalAlignment="Stretch" 
                     Visibility="{Binding RowSelectable, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}" IsEnabled="False">
                <Button Name="SelectByAttribute" ToolTip="Select Rows By Attribute" ToolTipService.ShowOnDisabled="True" Click="SelectByAttribute_Click" VerticalAlignment="Center" Height="24" Width="24">
                    <Image Margin="1" Source="pack://application:,,,/DataTableViewControl;component/Resources/SelectByAttribute_16x.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"></Image>
                </Button>
                <Button Name="ShowAll" ToolTip="Show All Rows" ToolTipService.ShowOnDisabled="True" Click="ShowAll_Checked" IsEnabled="False" VerticalAlignment="Center" Height="24" Width="24">
                    <Image Margin="1" Source="pack://application:,,,/DataTableViewControl;component/Resources/ClearSelectionIconDisabled_22x22.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"></Image>
                </Button>
                <Button Name="ShowSelected" ToolTip="Show Selected Rows Only" ToolTipService.ShowOnDisabled="True" Click="ShowSelected_Checked" IsEnabled="False" VerticalAlignment="Center" Height="24" Width="24">
                    <Image Margin="1" Source="pack://application:,,,/DataTableViewControl;component/Resources/ClearSelectionIconDisabled_22x22.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"></Image>
                </Button>
                <Button Name="DeSelectAll" ToolTip="Deselect All Rows" ToolTipService.ShowOnDisabled="True" Click="DeSelectAll_Click" IsEnabled="False" VerticalAlignment="Center" Height="24" Width="24">
                    <Image Margin="1" Source="pack://application:,,,/DataTableViewControl;component/Resources/ClearSelectionIconDisabled_22x22.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"></Image>
                </Button>
            </ToolBar>
            <ToolBar x:Name="EditorToolbar" Background="Transparent" IsEnabled="False" ToolTip="Editor Toolbar" ToolTipService.ShowOnDisabled="True" Margin="0" Padding="0" VerticalAlignment="Stretch" Visibility="{Binding Editable, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}">
                <Button Name="OpenFC" ToolTip="Open Field Calculator" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Center" Height="24" Width="24" Visibility="{Binding HasFieldCalculator, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}">
                    <Image Margin="1" Source="pack://application:,,,/DataTableViewControl;component/Resources/calculator_16x.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"></Image>
                </Button>
                <Button Name="Undo" ToolTip="Undo" ToolTipService.ShowOnDisabled="True" IsEnabled="False" VerticalAlignment="Center" Height="24" Width="24" Visibility="{Binding HasUndoRedoButtons, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}">
                    <Image Margin="1" Source="pack://application:,,,/DataTableViewControl;component/Resources/UndoDisabled.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"></Image>
                </Button>
                <Button Name="Redo" ToolTip="Redo" ToolTipService.ShowOnDisabled="True" IsEnabled="False" VerticalAlignment="Center" Height="24" Width="24" Visibility="{Binding HasUndoRedoButtons, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}">
                    <Image Margin="1" Source="pack://application:,,,/DataTableViewControl;component/Resources/RedoDisabled.png" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"></Image>
                </Button>
                <Button x:Name="SaveButton" ToolTip="Save All Edits" ToolTipService.ShowOnDisabled="True" IsEnabled="False" VerticalAlignment="Center" Height="24" Width="24" Visibility="{Binding HasSaveButton, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}">
                    <Image Margin="1" Source="pack://application:,,,/DataTableViewControl;component/Resources/SaveDisabled.ico" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality"></Image>
                </Button>
            </ToolBar>
        </ToolBarTray>
 
        <Grid Name="TableControlGrid" Grid.Row="1" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" SharedSizeGroup="A"></RowDefinition>
                <RowDefinition Height="1*" Name="RowsArea"></RowDefinition>
                <RowDefinition Height="Auto" Name="HorizontalScrollBarArea"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25" Name="RowHeadersColumn"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SelectAllBorder" BorderThickness="1" Margin="0,0,0,1" MouseLeftButtonDown="SelectAllLeftMouseDown" MouseLeftButtonUp="SelectAllLeftMouseUp">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllCellsSelected, ElementName=TableViewerControl2}" Value="True">
                                <Setter Property="ToolTip" Value="Deselect all cells"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AllCellsSelected, ElementName=TableViewerControl2}" Value="False">
                                <Setter Property="ToolTip" Value="Select all cells"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#333FCAFB"/>
                                <Setter Property="Background" Value="#263FCAFB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Grid Grid.Row="1" Grid.Column="0" x:Name="RowsGrid" Margin="0,-1,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MouseLeftButtonDown="RowsGrid_MouseLeftButtonDown" MouseLeftButtonUp="RowsGrid_MouseLeftButtonUp" MouseMove="RowsGrid_MouseMove" MouseRightButtonUp="RowsGrid_MouseRightButtonUp" MouseWheel="RowsGrid_MouseWheel"/>

            <!--<ScrollViewer Name="HorizontalScrollViewer" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1">-->
            <Grid Name="HorizontalViewerGrid" Grid.RowSpan="3" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding ColumnHeaderHeight}" Name="ColumnHeadersRow" SharedSizeGroup="A"></RowDefinition>
                        <RowDefinition Height="*" Name="RowsAr"></RowDefinition>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Name="ColumnsGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,1,0" MouseLeftButtonDown="ColumnsGrid_MouseLeftButtonDown" MouseMove="ColumnsGrid_MouseMove" MouseLeftButtonUp="ColumnsGrid_MouseLeftButtonUp"/>
                    
                    <Grid Name="RowColorPanel" Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,0,1,0" VerticalAlignment="Top" Background="Transparent" Focusable="False" IsHitTestVisible="False"/>
                    <Grid Name="GridPanel" Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,0,1,0" MouseWheel="TestGridPanel_MouseWheel" VerticalAlignment="Top" Background="Transparent" Focusable="True"/>
                    <Canvas Name="GridLinesCanvas" Grid.Row="1" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="0,0,1,0"/>
                    
                    <ScrollBar Grid.Row="2" Margin="0,0,1,0" Name="HorizontalScrollbar" Orientation="Horizontal" HorizontalAlignment="Stretch" Minimum="0" Maximum="0" SmallChange="1" ValueChanged="HorizontalScrollbar_ValueChanged" IsEnabledChanged="HorizontalScrollbar_IsEnabledChanged"/>

                </Grid>
            <!--</ScrollViewer>-->

            <ScrollBar Grid.Row="1" Grid.Column="2" Margin="1,0,0,0" Name="VerticalScrollbar" VerticalAlignment="Stretch" Minimum="0" Maximum="0" SmallChange="1" ValueChanged="VerticalScrollBar_ValueChanged" IsEnabledChanged="VerticalScrollbar_IsEnabledChanged"/>
        </Grid>
    </Grid>
</UserControl>
