<UserControl x:Class="TableViewer" Name="TableViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DataTableViewControl"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d" 
             UseLayoutRounding="False"
             d:DesignHeight="400" d:DesignWidth="600" 
             d:DataContext="{d:DesignInstance {x:Type local:TableViewer}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/TableViewerResources.xaml"/>
                <ResourceDictionary>
                    <cntrls:BooleanToVisibilityConverter x:Key="BooleanToCollapsed" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid DataContext="{Binding ElementName=TableViewerControl}" PreviewKeyDown="Grid_PreviewKeyDown" KeyDown="Grid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!--Toolbar tray is made public to allow developer to add custom tools-->
        <StackPanel x:Name="TableToolbarTray" Orientation="Horizontal" x:FieldModifier="public" Grid.Row="0" Background="Transparent">
            
            <!--Cell Select/Copy/Paste-->
            <StackPanel 
                Name="ExportCopyToolbar" 
                Background="Transparent" 
                ToolTip="Export and Copy Tools" 
                ToolTipService.ShowOnDisabled="True" 
                Orientation="Horizontal" 
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Left"
                IsEnabled="True">
                
                <Button 
                    x:Name="SelectAllButton" 
                    ToolTip="Select All Cells" 
                    Height="24" 
                    Width="24" 
                    Padding="0"
                    Click="SelectAllButton_Click" 
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    
                    <Image>
                        <Image.Style>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Stretch" Value="None"/>
                                <!--<Setter Property="Width" Value="16"/>
                                <Setter Property="Height" Value="16"/>
                                <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
                                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>-->
                                <!--<Setter Property="Margin" Value="0"/>-->
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AllCellsSelected, ElementName=TableViewerControl}" Value="True">
                                        <Setter Property="Source" Value="/DataTableViewControl;component/Resources/deselect_all_cells_16x.png"/>
                                        <Setter Property="ToolTip" Value="Deselect all cells"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AllCellsSelected, ElementName=TableViewerControl}" Value="False">
                                        <Setter Property="Source" Value="/GenericControls;component/Resources/select_all.png"/>
                                        <Setter Property="ToolTip" Value="Select all cells"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    
                </Button>

                <Button 
                    x:Name="CopyButton" 
                    ToolTip="Copy Selected Cells" 
                    ToolTipService.ShowOnDisabled="True" 
                    Height="24" Width="24" 
                    Click="CopyButton_Click"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    
                    <Image 
                        Stretch="None" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/GenericControls;component/Resources/copy.png" />
                
                </Button>

                <Button 
                    x:Name="CopyWithHeadersButton" 
                    ToolTip="Copy Selected Cells with Table Headers" 
                    ToolTipService.ShowOnDisabled="True" 
                    Height="24" Width="24" 
                    Click="CopyWithHeadersButton_Click"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    
                    <Image 
                        Stretch="None" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/GenericControls;component/Resources/copy_w_headers.png" />
                
                </Button>

                <Button 
                    x:Name="PasteButton" 
                    ToolTip="Paste from the Clipboard into the Table" 
                    ToolTipService.ShowOnDisabled="True" 
                    Height="24" Width="24" 
                    Click="PasteButton_Click"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    
                    <Image 
                        Stretch="None" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/GenericControls;component/Resources/paste.png" />
               
                </Button>

                <Button 
                    Name="ExportTableButton" 
                    ToolTip="Export Table" 
                    ToolTipService.ShowOnDisabled="True" 
                    Padding="0" 
                    Height="24" Width="24"
                    Click="ExportTableButton_Click" 
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    
                    <Viewbox Width="15" Height="15" Stretch="Uniform">
                        <ContentControl Padding="0" Content="{StaticResource ExportTableIcon}" />
                    </Viewbox>
                    
                </Button>
                
            </StackPanel>

            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="16" VerticalAlignment="Center" Visibility="{Binding RowSelectable, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}"/>

            <!--Attribution Row Select-->
            <StackPanel 
                Name="SelectionToolbar" 
                Background="Transparent" 
                ToolTip="Selection Tools" 
                ToolTipService.ShowOnDisabled="True" 
                Orientation="Horizontal" 
                VerticalAlignment="Bottom" 
                IsEnabled="False"
                Visibility="{Binding RowSelectable, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}">
                
                <Button 
                    Name="SelectByAttribute" 
                    ToolTip="Select Rows By Attribute" 
                    ToolTipService.ShowOnDisabled="True" 
                    Height="24" Width="24"
                    Click="SelectByAttribute_Click"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">

                    <Image 
                        Stretch="None" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/DataTableViewControl;component/Resources/SelectByAttribute_16x.png" />

                </Button>
                
                <Button 
                    Name="ShowAll" 
                    ToolTip="Show All Rows" 
                    ToolTipService.ShowOnDisabled="True" 
                    Click="ShowAll_Checked" 
                    IsEnabled="False" 
                    Height="24" Width="24"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">

                    <Image 
                        Stretch="Uniform" 
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/DataTableViewControl;component/Resources/ClearSelectionIconDisabled_22x22.png" />
                </Button>
                
                <Button 
                    Name="ShowSelected" 
                    ToolTip="Show Selected Rows Only" 
                    ToolTipService.ShowOnDisabled="True" 
                    Click="ShowSelected_Checked" 
                    IsEnabled="False" 
                    Height="24" Width="24"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    
                    <Image                         
                        Stretch="Uniform" 
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/DataTableViewControl;component/Resources/ClearSelectionIconDisabled_22x22.png" />
                </Button>
                
                <Button 
                    Name="DeSelectAll" 
                    ToolTip="Deselect All Rows" 
                    ToolTipService.ShowOnDisabled="True" 
                    Click="DeSelectAll_Click" 
                    IsEnabled="False" 
                    Height="24" Width="24"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">

                    <Image 
                        Stretch="Uniform" 
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/DataTableViewControl;component/Resources/ClearSelectionIconDisabled_22x22.png" />

                </Button>
                
            </StackPanel>

            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="16" VerticalAlignment="Center" Visibility="{Binding Editable, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}"/>

            <!--Editing-->
            <StackPanel 
                x:Name="EditorToolbar" 
                Background="Transparent" 
                IsEnabled="False" 
                ToolTip="Editor Toolbar" 
                ToolTipService.ShowOnDisabled="True" 
                VerticalAlignment="Bottom" 
                Orientation="Horizontal"
                Visibility="{Binding Editable, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}">
                
                <Button 
                    Name="OpenFC" 
                    ToolTip="Open Field Calculator" 
                    ToolTipService.ShowOnDisabled="True" 
                    Height="24" Width="24" 
                    Visibility="{Binding HasFieldCalculator, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">

                    <Image                         
                        Stretch="None" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/DataTableViewControl;component/Resources/calculator_16x.png" />

                </Button>
                
                <Button 
                    Name="Undo" 
                    ToolTip="Undo" 
                    ToolTipService.ShowOnDisabled="True" 
                    IsEnabled="False" 
                    Height="24" Width="24" 
                    Visibility="{Binding HasUndoRedoButtons, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">

                    <Image 
                        Stretch="Uniform" 
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/DataTableViewControl;component/Resources/UndoDisabled.png" />

                </Button>
                
                <Button 
                    Name="Redo" 
                    ToolTip="Redo" 
                    ToolTipService.ShowOnDisabled="True" 
                    IsEnabled="False" 
                    Height="24" Width="24" 
                    Visibility="{Binding HasUndoRedoButtons, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">

                    <Image                         
                        Stretch="Uniform" 
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/DataTableViewControl;component/Resources/RedoDisabled.png" />

                </Button>
                
                <Button 
                    x:Name="SaveButton" 
                    ToolTip="Save All Edits" 
                    ToolTipService.ShowOnDisabled="True" 
                    IsEnabled="False" 
                    Height="24" Width="24" 
                    Visibility="{Binding HasSaveButton, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">

                    <Image                         
                        Stretch="Uniform" 
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/DataTableViewControl;component/Resources/SaveDisabled.ico" />

                </Button>
                
            </StackPanel>
            
        </StackPanel>
 
        <Grid Name="TableControlGrid" Grid.Row="1" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" x:Name="ColumnHeadersRowDefinition" SharedSizeGroup="A"></RowDefinition>
                <RowDefinition Height="1*" Name="RowsRowDefinition"></RowDefinition>
                <RowDefinition Height="Auto" Name="HorizontalScrollBarRowDefinition"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" Name="RowHeadersColumnDefinition"></ColumnDefinition>
                <ColumnDefinition Width="*" x:Name="ColumnsColumnDefintion"></ColumnDefinition>
                <ColumnDefinition Width="Auto" Name="VerticalScrollBarColumnDefinition"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SelectAllBorder" 
                    Style="{Binding ElementName=TableViewerControl, Path=RowHeaderBorderStyle}" 
                    BorderThickness="1" 
                    MouseLeftButtonDown="SelectAllLeftMouseDown" 
                    MouseLeftButtonUp="SelectAllLeftMouseUp"
                    Visibility="{Binding ShowRowHeaders, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}">
                <!--<Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllCellsSelected, ElementName=TableViewerControl}" Value="True">
                                <Setter Property="ToolTip" Value="Deselect all cells"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AllCellsSelected, ElementName=TableViewerControl}" Value="False">
                                <Setter Property="ToolTip" Value="Select all cells"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#333FCAFB"/>
                                <Setter Property="Background" Value="#263FCAFB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>-->
                
                <!--<Image Name="SelectAllImage" MaxWidth="16" MinWidth="16" Height="16" Width="16" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality" Margin="1">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllCellsSelected, ElementName=TableViewerControl}" Value="True">
                                    <Setter Property="Source" Value="/DataTableViewControl;component/Resources/deselect_all_cells_16x.png"/>
                                    <Setter Property="ToolTip" Value="Deselect all cells"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AllCellsSelected, ElementName=TableViewerControl}" Value="False">
                                    <Setter Property="Source" Value="/GenericControls;component/Resources/select_all.png"/>
                                    <Setter Property="ToolTip" Value="Select all cells"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>-->
            </Border>

            <Grid 
                x:Name="RowHeadersGrid" 
                Grid.Row="1" 
                Grid.Column="0" 
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch" 
                MouseLeftButtonDown="RowsGrid_MouseLeftButtonDown" 
                MouseLeftButtonUp="RowsGrid_MouseLeftButtonUp" 
                MouseMove="RowsGrid_MouseMove" 
                MouseRightButtonUp="RowsGrid_MouseRightButtonUp" 
                MouseWheel="RowsGrid_MouseWheel"
                Visibility="{Binding ShowRowHeaders, Converter={StaticResource BooleanToCollapsed}, TargetNullValue=Visible}"/>

            <ScrollViewer 
                Name="HorizontalScrollViewer" 
                HorizontalAlignment="Stretch" 
                VerticalScrollBarVisibility="Disabled" 
                HorizontalScrollBarVisibility="Auto" 
                Grid.Row="0" 
                Grid.RowSpan="3" 
                Grid.Column="1">
                <Grid Name="HorizontalViewerGrid" SizeChanged="HorizontalScrollViewer_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding ColumnHeaderHeight}" Name="ColumnHeadersRow" SharedSizeGroup="A"></RowDefinition>
                        <RowDefinition Height="*" Name="RowsAr"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Name="ColumnHeadersGrid" HorizontalAlignment="Left" VerticalAlignment="Stretch" Grid.Row="0" MouseLeftButtonDown="ColumnsGrid_MouseLeftButtonDown" MouseMove="ColumnsGrid_MouseMove" MouseLeftButtonUp="ColumnsGrid_MouseLeftButtonUp"/>
                    <Grid Name="RowColorGrid" Grid.Row="1" HorizontalAlignment="Left" Width="{Binding ElementName=GridPanel, Path=ActualWidth}" VerticalAlignment="Top" Background="Transparent" Focusable="False" IsHitTestVisible="False"/>
                    <Grid Name="GridPanel" Grid.Row="1" HorizontalAlignment="Left" Background="Transparent" MouseWheel="TestGridPanel_MouseWheel" VerticalAlignment="Top" Focusable="True"/>
                    <Canvas Name="GridLinesCanvas" Grid.Row="1" IsHitTestVisible="False" HorizontalAlignment="Left"/>
                </Grid>
            </ScrollViewer>

            <ScrollBar 
                Grid.Row="1" 
                Grid.Column="2" 
                Margin="0,0,0,0" 
                Name="VerticalScrollbar" 
                VerticalAlignment="Stretch" 
                Minimum="0" Maximum="0" SmallChange="1" ValueChanged="VerticalScrollBar_ValueChanged" IsEnabledChanged="VerticalScrollbar_IsEnabledChanged"/>
        </Grid>
    </Grid>
</UserControl>
