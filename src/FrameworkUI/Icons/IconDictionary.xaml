                        <PathGeometry Figures="M 0,7 L 5,4 L 5,10 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Disabled Redo Icon -->
    <DrawingImage x:Key="RedoIconDisabled">
        <DrawingImage.Drawing>
            <DrawingGroup>
