    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- EDIT MENU / TOOLBAR ICONS - Theme-Aware Vector Graphics (Visual Studio Style)-->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Undo Icon - Visual Studio style curved arrow pointing left -->
    <DrawingImage x:Key="UndoIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Curved arrow arc -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource ToolbarIconForeground}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 3,7 A 5,5 0 1 1 8,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Arrowhead pointing left -->
                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 0,7 L 5,4 L 5,10 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Redo Icon - Visual Studio style curved arrow pointing right -->
    <DrawingImage x:Key="RedoIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Curved arrow arc -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource ToolbarIconForeground}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 13,7 A 5,5 0 1 0 8,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Arrowhead pointing right -->
                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 16,7 L 11,4 L 11,10 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Disabled Undo Icon -->
    <DrawingImage x:Key="UndoIconDisabled">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource ToolbarIconDisabledForeground}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 3,7 A 5,5 0 1 1 8,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource ToolbarIconDisabledForeground}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 0,7 L 5,4 L 5,10 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Disabled Redo Icon -->
    <DrawingImage x:Key="RedoIconDisabled">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource ToolbarIconDisabledForeground}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 13,7 A 5,5 0 1 0 8,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource ToolbarIconDisabledForeground}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 16,7 L 11,4 L 11,10 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Dropdown Arrow Icon (small triangle for split buttons) -->
    <DrawingImage x:Key="DropdownArrowIcon">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M 0,0 L 4,4 L 8,0 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Legacy PNG references (kept for backward compatibility) -->
    <ImageSource x:Key="Undo">/FrameworkUI;component/Resources/Undo.png</ImageSource>
    <ImageSource x:Key="Redo">/FrameworkUI;component/Resources/Redo.png</ImageSource>

</ResourceDictionary>