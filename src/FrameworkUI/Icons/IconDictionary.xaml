    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- EDIT MENU / TOOLBAR ICONS - Theme-Aware Vector Graphics (Visual Studio Style)-->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Undo Icon - Curved arrow pointing counter-clockwise (left) -->
    <DrawingImage x:Key="UndoIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}">
                    <GeometryDrawing.Geometry>
                        <!-- Arrow body (curved arc) -->
                        <PathGeometry Figures="M 8,2 A 6,6 0 1 0 14,8 L 12,8 A 4,4 0 1 1 8,4 L 8,6 L 3,3 L 8,0 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Redo Icon - Curved arrow pointing clockwise (right) -->
    <DrawingImage x:Key="RedoIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}">
                    <GeometryDrawing.Geometry>
                        <!-- Arrow body (curved arc) - mirrored from Undo -->
                        <PathGeometry Figures="M 8,2 A 6,6 0 1 1 2,8 L 4,8 A 4,4 0 1 0 8,4 L 8,6 L 13,3 L 8,0 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Disabled Undo Icon -->
    <DrawingImage x:Key="UndoIconDisabled">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource ToolbarIconDisabledForeground}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 8,2 A 6,6 0 1 0 14,8 L 12,8 A 4,4 0 1 1 8,4 L 8,6 L 3,3 L 8,0 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Disabled Redo Icon -->
    <DrawingImage x:Key="RedoIconDisabled">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource ToolbarIconDisabledForeground}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 8,2 A 6,6 0 1 1 2,8 L 4,8 A 4,4 0 1 0 8,4 L 8,6 L 13,3 L 8,0 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Legacy PNG references (kept for backward compatibility) -->
    <ImageSource x:Key="Undo">/FrameworkUI;component/Resources/Undo.png</ImageSource>
    <ImageSource x:Key="Redo">/FrameworkUI;component/Resources/Redo.png</ImageSource>

</ResourceDictionary>