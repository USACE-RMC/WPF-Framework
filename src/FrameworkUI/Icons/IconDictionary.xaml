    <ImageSource x:Key="PDF">/FrameworkUI;component/Resources/PDF.png</ImageSource>
    <ImageSource x:Key="TCU">/FrameworkUI;component/Resources/TCU.png</ImageSource>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- EDIT MENU / TOOLBAR ICONS - Theme-Aware Vector Graphics (Visual Studio Style)-->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Undo Icon - Visual Studio style curved arrow pointing left -->
    <DrawingImage x:Key="UndoIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Curved arrow arc -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource ToolbarIconForeground}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 3,7 A 5,5 0 1 1 8,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Arrowhead pointing left -->
                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 0,7 L 5,4 L 5,10 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Redo Icon - Visual Studio style curved arrow pointing right -->
    <DrawingImage x:Key="RedoIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Curved arrow arc -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource ToolbarIconForeground}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 13,7 A 5,5 0 1 0 8,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Arrowhead pointing right -->
                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 16,7 L 11,4 L 11,10 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Disabled Undo Icon -->
    <DrawingImage x:Key="UndoIconDisabled">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource ToolbarIconDisabledForeground}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 3,7 A 5,5 0 1 1 8,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource ToolbarIconDisabledForeground}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 0,7 L 5,4 L 5,10 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Disabled Redo Icon -->
    <DrawingImage x:Key="RedoIconDisabled">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource ToolbarIconDisabledForeground}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 13,7 A 5,5 0 1 0 8,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource ToolbarIconDisabledForeground}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 16,7 L 11,4 L 11,10 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Dropdown Arrow Icon (small triangle for split buttons) -->
    <DrawingImage x:Key="DropdownArrowIcon">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M 0,0 L 4,4 L 8,0 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Legacy PNG references (kept for backward compatibility) -->
    <ImageSource x:Key="Undo">/FrameworkUI;component/Resources/Undo.png</ImageSource>
    <ImageSource x:Key="Redo">/FrameworkUI;component/Resources/Redo.png</ImageSource>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- PROJECT EXPLORER ICONS - Vector Graphics                                     -->
    <!-- Matching original PNG folder icons exactly                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Folder Icon (Closed) - Matches Folder.png exactly -->
    <DrawingImage x:Key="FolderIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Folder fill - traced from PNG -->
                <GeometryDrawing Brush="#DCB67A">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 1,4 L 1,2 L 6,2 L 7,4 L 14,4 L 14,13 L 1,13 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Outline -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C6A856" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 1,4 L 1,2 L 6,2 L 7,4 L 14,4 L 14,13 L 1,13 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Folder Open Icon - Matches FolderOpen.png exactly -->
    <DrawingImage x:Key="FolderOpenIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Back folder panel (lighter, the inside) -->
                <GeometryDrawing Brush="#E8D8B0">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 1,4 L 1,2 L 6,2 L 7,4 L 12,4 L 12,6 L 1,6 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Front flap - slight tilt, bottom flat -->
                <GeometryDrawing Brush="#DCB67A">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 1,6 L 1,13 L 14,13 L 14,5 L 12,5 L 12,6 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Back outline (tab and top) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C6A856" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 1,4 L 1,2 L 6,2 L 7,4 L 12,4 L 12,5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Front outline -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C6A856" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 1,6 L 1,13 L 14,13 L 14,5 L 12,5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>