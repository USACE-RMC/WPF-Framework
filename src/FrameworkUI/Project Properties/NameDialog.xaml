<Window x:Class="FrameworkUI.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FrameworkUI"
        xmlns:cntls="clr-namespace:GenericControls;assembly=GenericControls"
        Title="Name Dialog"
        Width="346"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Style="{DynamicResource MainWindowStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}"
        Foreground="{DynamicResource EnvironmentWindowText}" 
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <ResourceDictionary Source="/FrameworkUI;component/Themes/VS2013/Controls/MainWindowStyle.xaml" />
    </Window.Resources>
    <Grid>
        <!--Add Rows-->
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="4,0,4,0" Name="NameLabel" Text="Name:" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>

        <cntls:NameTextBox x:Name="NameTBox" Grid.Row="1" HorizontalAlignment="Stretch" Margin="4" VerticalAlignment="Stretch" 
                            Text="{Binding Text, Mode=TwoWay}"/>

        <!--Custom Content-->
        <ContentControl Grid.Row="2" Margin="4,0,4,0" Name="CustomContentUserControl"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Content="{Binding InnerContent}"/>

        <!--Ok and Cancel buttons-->
        <Grid x:Name="ButtonGrid" Grid.Row="3" Height="32" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="83"/>
                <ColumnDefinition Width="83"/>
            </Grid.ColumnDefinitions>
            <Button Name="OKButton" IsDefault="True" Click="OKButton_Click" Content="OK" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="0" Margin="4" Cursor="Hand"/>
            <Button Name="CancelButton" IsCancel="True" Click="CancelButton_Click" Content="Cancel" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="1" Margin="4" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
