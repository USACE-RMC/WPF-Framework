<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>FrameworkUI</RootNamespace>
    <AssemblyName>FrameworkUI</AssemblyName>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameworkInterfaces\FrameworkInterfaces.csproj" />
    <ProjectReference Include="..\Themes\Themes.csproj" />
    <ProjectReference Include="..\SoftwareUpdate\SoftwareUpdate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Xceed.Wpf.AvalonDock.dll" />
    <Content Include="Resources\Xceed.Wpf.AvalonDock.Themes.VS2013.dll" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Xceed.Wpf.AvalonDock">
      <HintPath>Resources\Xceed.Wpf.AvalonDock.dll</HintPath>
    </Reference>
    <Reference Include="Xceed.Wpf.AvalonDock.Themes.VS2013">
      <HintPath>Resources\Xceed.Wpf.AvalonDock.Themes.VS2013.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
