<Window x:Class="FrameworkUI.RecentFilesDialog" x:Name="RFDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Recent Files"
        Icon="{DynamicResource RecentProjects}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Style="{DynamicResource MainWindowStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}"
        Foreground="{DynamicResource EnvironmentWindowText}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <ResourceDictionary Source="/FrameworkUI;component/Themes/VS2013/Controls/MainWindowStyle.xaml" />
    </Window.Resources>
    <Grid x:Name="MainGrid">

        <!--Add Rows-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Data Grid-->
        <DataGrid x:Name="MyDataGrid" Margin="6" Height="250" Width="400" AutoGenerateColumns="False" IsReadOnly="True" Background="White"  BorderBrush="{DynamicResource SeparatorBorder}" BorderThickness="1"
                  GridLinesVisibility="None" HeadersVisibility="Column" ItemsSource="{Binding Files.Collection}" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="MyDataGrid_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="18"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding ForegroundColor}"/>
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn HeaderStyle="{DynamicResource Center_ColumnHeaderStyle_Modal}" Width="18" CanUserSort="False" CanUserReorder="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ElementName=RFDialog, Path=FileImage}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn HeaderStyle="{DynamicResource Left_ColumnHeaderStyle_Modal}" MinWidth="100" MaxWidth="200" Header="Project" Binding="{Binding Name}" CanUserSort="True" CanUserReorder="False" />
                <DataGridTextColumn HeaderStyle="{DynamicResource Left_ColumnHeaderStyle_Modal}" MinWidth="100" Width="*" Header="Location" Binding="{Binding DisplayLocation}" CanUserSort="True" CanUserReorder="False"/>
            </DataGrid.Columns>
        </DataGrid>

        <!--Buttons-->
        <Grid Grid.Row="1" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Name="OpenButton" Click="OpenButton_Click" Content="Open" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="0" Width="83" Height="24" Cursor="Hand" Margin="6,0,0,6" IsEnabled="False"/>
            <Button Name="ClearListButton"  Click="ClearListButton_Click" Content="Clear List" Width="83" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="1" Margin="6,0,6,6" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
